  <dcterms:RightsStatement rdf:about="https://energy.referencedata.eu/Confidentiality/SensitivePersonal">
    <dcat:applicableLegislation rdf:resource="http://data.europa.eu/eli/reg/2016/679/oj"/>
    <skos:broadMatch rdf:resource="http://publications.europa.eu/resource/authority/access-right/NON_PUBLIC"/>
    <skos:definition xml:lang="en">Dataset contains personal data, including special categories of personal data, and shall be processed in accordance with Regulation (EU) 2016/679 (GDPR), including strict controls on access, processing, disclosure, and retention.</skos:definition>
    <dcterms:identifier>ec8c443e-edab-4256-80b2-4a7824f754ab</dcterms:identifier>
