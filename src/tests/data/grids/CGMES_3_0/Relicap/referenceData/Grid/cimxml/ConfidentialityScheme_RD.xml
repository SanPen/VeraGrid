    <dcat:applicableLegislation rdf:resource="https://lovdata.no/dokument/NL/lov/2018-06-01-24"/>
    <dcat:applicableLegislation rdf:resource="https://lovdata.no/dokument/NL/lov/1990-06-29-50"/>
    <skos:broadMatch rdf:resource="http://publications.europa.eu/resource/authority/access-right/NON_PUBLIC"/>
    <skos:broader rdf:resource="https://energy.referencedata.eu/Confidentiality/SensitiveInfrastructure"/>
    <skos:definition xml:lang="en">Dataset contains concrete and detailed information about the energy system that can be exploited to damage the power system or weaken the ability to handle extraordinary situations, in accordance with the European or National regulation.</skos:definition>
    <dcterms:identifier>7be116e1-a70f-40b5-922e-25a53f0449dd</dcterms:identifier>
    <dcterms:isPartOf rdf:resource="https://energy.referencedata.eu/Confidentiality/SensitiveInfrastructure"/>
    <skos:notation>SENSITIVE_ENERGY</skos:notation>
    <skos:prefLabel xml:lang="en">Sensitive Energy Infrastructure Data</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Includes operational and planning data whose disclosure could impact power system security, system balance, or security of supply.</skos:scopeNote>
  </dcterms:RightsStatement>
