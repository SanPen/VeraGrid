  <dcterms:RightsStatement rdf:about="https://energy.referencedata.eu/Confidentiality/SensitiveEnergy">
    <dcat:applicableLegislation rdf:resource="https://lovdata.no/dokument/SF/forskrift/2002-05-07-448"/>
    <dcat:applicableLegislation rdf:resource="http://data.europa.eu/eli/dir/2022/2555/oj"/>
