  <dcterms:RightsStatement rdf:about="https://energy.referencedata.eu/Confidentiality/InternalOpen">
    <skos:definition xml:lang="en">Dataset is open for use within the organisation that has published it. It may be shared and reused internally without confidentiality restriction inside that organisation, but it is not public and shall not be disclosed externally unless explicitly permitted.</skos:definition>
    <skos:exactMatch rdf:resource="http://publications.europa.eu/resource/authority/access-right/RESTRICTED"/>
    <dcterms:identifier>0080531c-fa18-4d51-8832-4bcbced77c90</dcterms:identifier>
    <skos:notation>INTERNAL_OPEN</skos:notation>
    <skos:prefLabel xml:lang="en">Internal Open</skos:prefLabel>
    <owl:sameAs rdf:resource="http://publications.europa.eu/resource/authority/access-right/RESTRICTED"/>
  </dcterms:RightsStatement>
  <dcterms:RightsStatement rdf:about="https://energy.referencedata.eu/Confidentiality/MarketSensitive">
    <dcat:applicableLegislation rdf:resource="http://data.europa.eu/eli/reg/2013/543/oj"/>
    <dcat:applicableLegislation rdf:resource="http://data.europa.eu/eli/reg/2011/1227/oj"/>
    <skos:broadMatch rdf:resource="http://publications.europa.eu/resource/authority/access-right/NON_PUBLIC"/>
    <skos:definition xml:lang="en">Dataset contains commercially or regulatorily sensitive market information, including information that may influence competition, market behaviour, trading positions, prices, or transparency obligations if disclosed inappropriately.</skos:definition>
    <dcterms:identifier>4cd9b326-1275-4da7-9724-28c5e1deeb87</dcterms:identifier>
    <dcterms:isPartOf rdf:resource="https://energy.referencedata.eu/Confidentiality/Sensitive"/>
    <skos:notation>MARKET_SENSITIVE</skos:notation>
    <skos:prefLabel xml:lang="en">Market Sensitive Data</skos:prefLabel>
    <skos:scopeNote xml:lang="en">Includes inside information as defined in REMIT. Some data may be confidential prior to publication but become mandatory public under transparency obligations.</skos:scopeNote>
  </dcterms:RightsStatement>
