  </dcterms:RightsStatement>
  <dcterms:RightsStatement rdf:about="https://energy.referencedata.eu/Confidentiality/Unclassified">
    <skos:definition xml:lang="en">No confidentiality classification has been assigned to the dataset.</skos:definition>
    <dcterms:identifier>ef58471e-08a0-4c8b-b488-3e5ef4a21422</dcterms:identifier>
    <skos:notation>UNCLASSIFIED</skos:notation>
    <skos:prefLabel xml:lang="en">Unclassified</skos:prefLabel>
    <skos:scopeNote xml:lang="en">This value records that classification has not been performed. It does not by itself imply public, restricted, or non-public access.</skos:scopeNote>
  </dcterms:RightsStatement>
  <dcterms:RightsStatement rdf:about="https://energy.referencedata.eu/Confidentiality/UnknownExternalClassification">
    <skos:definition xml:lang="en">The dataset is owned or originated by another organisation, and no confidentiality classification is available to the publishing or cataloguing party. The applicable access rights are therefore not known.</skos:definition>
    <dcterms:identifier>51378918-8ef6-4cce-9711-4af4539f1ef5</dcterms:identifier>
    <skos:notation>UNKNOWN_EXTERNAL_CLASSIFICATION</skos:notation>
    <skos:prefLabel xml:lang="en">Unknown External Classification</skos:prefLabel>
    <skos:scopeNote xml:lang="en">This value records lack of known classification because responsibility lies with another organisation. It should not be interpreted as permission to disclose the dataset.</skos:scopeNote>
  </dcterms:RightsStatement>
