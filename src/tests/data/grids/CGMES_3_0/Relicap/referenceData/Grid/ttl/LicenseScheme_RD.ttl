@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms:<http://purl.org/dc/terms/> .
@prefix dcat:   <http://www.w3.org/ns/dcat#> .
@prefix prov:   <http://www.w3.org/ns/prov#> .
@prefix adms:   <http://www.w3.org/ns/adms#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .

#################################################################
# License Scheme / Reference Dataset
#################################################################

<https://energy.referencedata.eu/LicenseScheme/NCP/1.0>
    a skos:ConceptScheme , dcat:Dataset ;
    skos:prefLabel "Energy Reference Data License Scheme"@en ;
    skos:definition "Controlled vocabulary and reference dataset describing dataset license conditions for energy and power system data. The scheme is intended to support consistent tagging of datasets and to help software tools, data catalogues, and language models understand permitted reuse conditions."@en ;
    dcterms:title "LicenseScheme-NCP-1.0" ;
	dcterms:identifier "e64345cc-016b-4cc2-a5d1-8beabf97beab" ;
    dcterms:description "Reference dataset containing license concepts for use with dcterms:license on datasets and distributions. The scheme distinguishes between fully open, non-commercial, restricted derivation, restricted share-alike derivation, and informational-use-only license patterns."@en ;
    dcterms:publisher <https://www.entsoe.eu/> ;
    dcterms:rights "Copyright" ;
    dcterms:rightsHolder "ENTSO-E" ;
    dcterms:issued "2026-03-22"^^xsd:date ;
    prov:generatedAtTime "2026-03-22T00:00:00Z"^^xsd:dateTime ;
    dcat:version "1.0.0" ;
    adms:versionNotes "Initial version of the Energy Reference Data License Scheme. Provides license concepts intended for use with dcterms:license, aligned where possible with Creative Commons and Open Data Commons license resources."@en ;
    dcat:isVersionOf <https://energy.referencedata.eu/LicenseScheme> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:accessRights <https://energy.referencedata.eu/Confidentiality/Public> ;
	dcterms:hasPart <https://energy.referencedata.eu/LicenseScheme/NCP/1.0#collection_ncp_license> .


#################################################################
# Collection of License
#################################################################

<https://energy.referencedata.eu/LicenseScheme/NCP/1.0#collection_ncp_license>
    a prov:Collection ;
    dcterms:identifier "df7fa2ef-72f8-4c18-b946-e729e5259630" ;
    skos:prefLabel "Collection of License Supported by NCP"@en ;
    prov:hadMember         
		<https://energy.referencedata.eu/License/OpenCommercial> ,
        <https://energy.referencedata.eu/License/OpenNonCommercial> ,
        <https://energy.referencedata.eu/License/RestrictedDerivationAllowed> ,
        <https://energy.referencedata.eu/License/RestrictedDerivationShareAlike> ,
        <https://energy.referencedata.eu/License/InformationalUseOnly> .


#################################################################
# 1. Fully open, including commercial use
#################################################################

<https://energy.referencedata.eu/License/OpenCommercial>
    a dcterms:LicenseDocument ;
    skos:prefLabel "Open - Commercial Use Allowed"@en ;
    skos:notation "OPEN-COMMERCIAL" ;
    skos:definition "Dataset may be published, copied, used, transformed, and incorporated into other datasets, including for commercial purposes."@en ;
    skos:scopeNote "This concept is intended for datasets that are openly reusable, including in commercial products and services. Attribution obligations may still apply through the underlying legal license."@en ;
    dcterms:source <https://creativecommons.org/licenses/by/4.0/> ;
    owl:sameAs <https://creativecommons.org/licenses/by/4.0/> .

#################################################################
# 2. Open, but non-commercial only
#################################################################

<https://energy.referencedata.eu/License/OpenNonCommercial>
    a dcterms:LicenseDocument ;
    skos:prefLabel "Open - Non-Commercial Use Only"@en ;
    skos:notation "OPEN-NONCOMMERCIAL" ;
    skos:definition "Dataset may be published, copied, used, transformed, and incorporated into other datasets for non-commercial purposes only."@en ;
    skos:scopeNote "This concept is intended for datasets that are openly reusable except for commercial use. It may be suitable where broad academic, regulatory, or public-interest reuse is allowed, but commercial exploitation is not permitted."@en ;
    dcterms:source <https://creativecommons.org/licenses/by-nc/4.0/> ;
    owl:sameAs <https://creativecommons.org/licenses/by-nc/4.0/> .

#################################################################
# 3. Not public, but derivation is allowed and derived dataset may be published
#################################################################

<https://energy.referencedata.eu/License/RestrictedDerivationAllowed>
    a dcterms:LicenseDocument ;
    skos:prefLabel "Restricted - Derivation Allowed"@en ;
    skos:notation "RESTRICTED-DERIVATION" ;
    skos:definition "Original dataset is not public and may not be published or redistributed. The dataset may be used as input to create derived datasets, and such derived datasets may be published if permitted by the applicable terms."@en ;
    skos:scopeNote "This concept is typically used for confidential or operational datasets where direct redistribution is prohibited, but transformation into a publishable derivative dataset is allowed. This usually requires specific contractual terms rather than a standard public license."@en .

#################################################################
# 4. Can only be used for derivation, and derived dataset must keep same restriction
#################################################################

<https://energy.referencedata.eu/License/RestrictedDerivationShareAlike>
    a dcterms:LicenseDocument ;
    skos:prefLabel "Restricted - Derivation Share Alike"@en ;
    skos:notation "RESTRICTED-DERIVATION-SA" ;
    skos:definition "Dataset may only be used to derive another dataset. Any derived dataset shall remain subject to the same or equivalent restrictions as the original dataset."@en ;
    skos:scopeNote "This concept captures a restrictive share-alike pattern for derived datasets. The closest well-known public analogue is ODbL, but this concept is stricter and is normally governed by bespoke contractual terms."@en ;
    dcterms:source <https://opendatacommons.org/licenses/odbl/> ;
    owl:sameAs <https://opendatacommons.org/licenses/odbl/> .

#################################################################
# 5. Informational use only
#################################################################

<https://energy.referencedata.eu/License/InformationalUseOnly>
    a dcterms:LicenseDocument ;
    skos:prefLabel "Informational Use Only"@en ;
    skos:notation "INFO-ONLY" ;
    skos:definition "Dataset may only be accessed and used for information, reference, or viewing purposes. Redistribution, modification, extraction into other datasets, and creation of derived datasets are not permitted unless explicitly stated otherwise."@en ;
    skos:scopeNote "This concept is intended for cases where data is provided for awareness, consultation, or understanding, but not for reuse or republication."@en .
	
#################################################################
# Optional: Additional Useful Concepts (Recommended)
#################################################################

<https://energy.referencedata.eu/License/PublicDomain>
    a dcterms:LicenseDocument ;
    skos:prefLabel "Public Domain (No Restrictions)"@en ;
    skos:definition "Dataset is dedicated to the public domain and may be used without any restrictions, including without attribution."@en ;
    skos:exactMatch <https://opendatacommons.org/licenses/pddl/1-0/> ;
    dcterms:source <https://opendatacommons.org/licenses/pddl/1-0/> .

<https://energy.referencedata.eu/License/ShareAlikeOpen>
    a dcterms:LicenseDocument ;
    skos:prefLabel "Open - Share Alike"@en ;
    skos:definition "Dataset may be used and redistributed, including commercially, but derivative works must be licensed under the same terms."@en ;
    skos:exactMatch <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:source <https://creativecommons.org/licenses/by-sa/4.0/> .

