@prefix adms:   <http://www.w3.org/ns/adms#> .
@prefix dcat:     <http://www.w3.org/ns/dcat#> .
@prefix dcterms:  <http://purl.org/dc/terms/> .
@prefix prov:     <http://www.w3.org/ns/prov#> .
@prefix provcim:  <https://cim4.eu/ns/provcim#> .
@prefix skos:     <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:      <http://www.w3.org/2001/XMLSchema#> .
@prefix nc:		<https://cim4.eu/ns/nc#> .
@prefix cim:	<https://cim.ucaiug.io/ns#> .


#################################################################
# Party Scheme / Reference Dataset
#################################################################

<https://energy.referencedata.eu/test/PartyScheme/NCP/1.0>
    a skos:ConceptScheme , dcat:Dataset ;
    skos:prefLabel "Energy Reference Data Party Scheme"@en ;
	skos:definition "Reference dataset and concept scheme listing recognized Party identities that may be used as the object of dcterms:publisher and provcim:modelAuthority."@en ;
	dcterms:description "Reference dataset containing recognized party identities for use in publisher, authority, and provenance references."@en ;
    dcterms:title "Test-PartyScheme-NCP-1.0" ;
	dcterms:identifier "b77fe0ff-9907-4943-90a7-6e35a178a8ab" ;
    dcterms:publisher <https://www.entsoe.eu/> ;
    dcterms:rights "Copyright" ;
    dcterms:rightsHolder "ENTSO-E" ;
    dcterms:issued "2026-03-22"^^xsd:date ;
    prov:generatedAtTime "2026-03-22T00:00:00Z"^^xsd:dateTime ;
    dcat:version "1.0.0" ;
    adms:versionNotes "Initial version of the Energy Reference Data Party Scheme for ReliCapGrid."@en ;
    dcat:isVersionOf <https://energy.referencedata.eu/test/PartyScheme> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:accessRights <https://energy.referencedata.eu/Confidentiality/Public> ;
	dcterms:hasPart <https://energy.referencedata.eu/test/PartyScheme/NCP/1.0#collection_ncp_party> .


#################################################################
# Collection of Party
#################################################################

<https://energy.referencedata.eu/test/PartyScheme/NCP/1.0#collection_ncp_party>
    a prov:Collection ;
    dcterms:identifier "a4dbeec3-f598-4a47-a3e1-df76eb1bfbb9" ;
    skos:prefLabel "Collection of recognized parties for NCP and ReliCapGrid."@en ;
    prov:hadMember         
		<https://energy.referencedata.eu/test/party/TSO-Svedala> ,
        <https://energy.referencedata.eu/test/party/TSO-Galia> .

#################################################################
# List of Party
#################################################################

<https://energy.referencedata.eu/test/party/TSO-Svedala>
    a prov:Agent , nc:TransmissionSystemOperator ;
    skos:prefLabel "TSO-Svedala"@en ;
	dcterms:identifier "b9fbb881-573b-4e98-9b7b-31f00a45ebe0" ;
	dcterms:description "Recognized party acting as the transmission system operator for Svedala."@en ;
	cim:IdentifiedObject.description "Transmission System Operator (TSO) post and function performed by Svedala" ; 
    cim:IdentifiedObject.mRID "b9fbb881-573b-4e98-9b7b-31f00a45ebe0" ;
    cim:IdentifiedObject.name "TSO-Svedala" .


<https://energy.referencedata.eu/test/party/TSO-Galia>
    a prov:Agent , nc:TransmissionSystemOperator ;
    skos:prefLabel "TSO-Galia"@en ;
	dcterms:identifier "2ec42376-eee2-4ab9-b79a-165e1df2a185" ;
	dcterms:description "Recognized party acting as the transmission system operator for Galia."@en ;
    cim:IdentifiedObject.description "Transmission System Operator (TSO) post and function performed by Galia" ;
    cim:IdentifiedObject.mRID "2ec42376-eee2-4ab9-b79a-165e1df2a185" ;
    cim:IdentifiedObject.name "TSO-Galia" .
	
