ortional gain'";"vardef(Kqi)    = 'p.u.';'Integral gain'";"vardef(Kvp)    = 'p.u.';'Proportional gain'";"vardef(Kvi)    = 'p.u.';'Integral gain'";"vardef(QFlag)  = ;'Q control flag: 1 = voltage/Q, 0 = const. pf or Q ctrl.'";"vardef(Trv)    = 's';'Filter time constant for voltage measurements'";"vardef(dbd1)    = 'p.u.';'Voltage deadband for overvoltage iq injection'";"vardef(dbd2)    = 'p.u.';'Voltage deadband for undervoltage iq injection'";"vardef(Kqv)    = 'p.u.';'Gain for reactive current injection during fault'";"vardef(Thld)   = 's';'Reactive current injection delay after voltage dip'";"vardef(Vdip)   = 'p.u.';'Undervoltage condition trigger voltage'";"vardef(Vup)    = 'p.u.';'Overvoltage condition trigger voltage'";"vardef(Tiq)    = 's';'Time constant on lag delay'";"vardef(PFlag)  = ;'Power control flag: 0 = P reference, 1 = Speed ref.'";"vardef(Tpord)  = 's';'Time constant'";"vardef(PqFlag) = ;'Priority flag on current limit: 1 = P, 0 = Q priority'";"vardef(Imax)   = 'p.u.';'Maximum converter current limit'";"vardef(Iq_frz) = 'p.u.';'Value at which injection is held after voltage dip'";"vardef(Iqh1)   = 'p.u.';'Maximum limit of reactive current injection'";"vardef(qvmax)   = 'p.u.';'Reactive power limit maximum'";"vardef(qvmin)   = 'p.u.';'Reactive power limit minimum'";"vardef(Vmax)   = 'p.u.';'Voltage control maximum'";"vardef(Vmin)   = 'p.u.';'Voltage control minimum'";"vardef(Iql1)   = 'p.u.';'Minimum limit of reactive current injection'";"vardef(dPmax)  = 'p.u./s';'Ramp rate on power reference'";"vardef(dPmin)  = 'p.u./s';'Ramp rate on power reference'";"vardef(Pmax)   = 'p.u.';'Maximum power reference'";"vardef(Pmin)   = 'p.u.';'Minimum power reference'";"vardef(PfFlag) = ;'Power factor flag: 1 = pf control, 0 = Q control'";"vardef(Thld2)  = 's';'Ipcmd_max delay after fault'";"vardef(Vref0)  = 'p.u.';'Reference voltage, enter 0 for terminal voltage'";"vardef(Vref1)  = 'p.u.';'User-defined ref./bias on inner-loop voltage ctrl.'";"vardef(Ke)     = ;'Ipmin scaling factor'";"vardef(Rc)     = 'p.u.';'Current-compensation resistance'";"vardef(Xc)     = 'p.u.';'Current-compensation reactance'";"vardef(VcmpFlag)= ;'0 = reactive droop, 1 = current compensation'";"vardef(Kc)     = ;'Reactive-current compensation gain'";"vardef(Tr1)    = 's';'Filter time constant for voltage measurement'";"vardef(vblkl)  = 'p.u.';'Voltage below which the converter is blocked'";"vardef(vblkh)  = 'p.u.';'Voltage above which the converter is blocked'";"vardef(Tblk_delay)   = 's';'Time for which the converter will remain blocked'";"vardef(WGO_active)='0/1';'Set by configuration script, no input needed'";1;freeze_Voltage_Dip,freeze_low_sig,freeze_up_sig;1;Iq_frz;is_blocked,Voltage_Dip,Iqcmd,Ipcmd,Pord;Vt,Vt_r,Vt_i,It_r,It_i,Iqfrz,PFAref,Pe,Qext,Qgen,pflag,Paux,Speed,Pref,Pref_WGO;x1,x2,x3,x0,x4,x5,x6;PfFlag,VFlag,Tp,Kqp,Kqi,QFlag,Kvp,Kvi,Trv,dbd1,dbd2,Kqv,Vdip,Vup,Tiq,Tpord,PqFlag,Imax,Thld2,Ke,oarray_vdlq,oarray_vdlp,PFlag,Vref0,Vref1,Rc,Xc,VcmpFlag,Kc,Tr1,vblkl,vblkh,Tblk_delay,Thld,Iq_frz;dx2,dx3,Undervoltage,Overvoltage,block,blocking_factor,Vref,vcr,vci,argVc,is_voltage_violation,freeze_has_ended,y_frozen1,freeze_has_ended1,y_frozen3,freeze_has_ended2,y_frozen2,freeze_has_ended3,y_frozen,FLT,FLT1,Ip_unlim,Ipcmd1,Iq_unlim,Iqcmd1,Iqfrz1,Iqv,Qcalc,Vcmp,Vcomp,Vdif,Verr,Vref0_sig,Vref1_sig,Vt_filt,freeze,freeze1,freeze2,freeze3,freeze_low,freeze_low_s,freeze_up,freeze_up_s,i_in,i_in1,iqmax,iqmin,is_blocked2,o1,o10,o12,o13,o2,o3,o4,o5,o6,o7,o8,o9,vdlp,vdlq,y_in,y_in1,y_max,y_min,y_min1,yi,yi1,yi10,yi11,yi12,yi13,yi14,yi2,yi3,yi4,yi5,yi7,yi8,yi9,freeze_Voltage_Dip,freeze_low_sig,freeze_up_sig
