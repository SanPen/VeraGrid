  45;C;1/s;6157;1;5;0;;0;;0;;0;;1;yo;1;yi;1;x;0;;0;;4;"! Functionality: This macro implements a continuous time integrator block. ";x. = yi;yo = x;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;0;;0;;yo;yi;x;;
  46;C;"Kp+Ki/s [(p;p)]";6157;1;5;1;y_max;0;;1;y_min;0;;1;yo;1;yi,u;1;x;1;Kp,Ki,Vpllfrz;1;Voltage_Dip;21;! Functionality: This block implements a Proportional-Integral (PI) block (parallel variant) with anti-windup limits.;! Proportional gain: Kp;! Integral gain: Ki;! Transfer function:;!          ________;!         |        |                     ___;! yi---+->|   Kp   |------------------->|+  |     __;"!      |  |________|            __      |   |    |  ";!      |   ________          __|__      |   |----|----> yo;"!      |  |        |        |  1  |     |   |  __|     ";"!      +--|   Ki   |------->|  -  |---->|+  |         ";"!         |________|        |  s  |     |___|         ";"!                           |_____|                   ";!                            __|;"!             ";"output(y_min>y_max, 'DSL Macro Kp+Ki/s [(p;p)]: Lower limit larger than upper limit') ";x. = select(Voltage_Dip, 0, Ki*yi);yo = lim_const(Kp*yi+limstate_const(x,y_min,y_max),y_min,y_max);;Voltage_Dip = u<Vpllfrz;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;0;;0;;yo;yi,u;x;Kp,Ki,Vpllfrz;Voltage_Dip
