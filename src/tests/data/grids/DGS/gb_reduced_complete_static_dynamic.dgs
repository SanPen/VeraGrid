  17;C;REEC_C;6229;0;5;1;Qmax,Vmax,Iqh1,SCOmax,dPmax,Pmax;0;;1;Qmin,Vmin,Iql1,SCOmin,dPmin,Pmin;0;;1;Voltage_Dip,Iqcmd,Ipcmd,Pord,SOC;1;Vt,PFAref,Pe,Qext,Qgen,Pref,Paux;1;x1,x2,x3,x0,x4,x5,x7;1;PfFlag,VFlag,Tp,Kqp,Kqi,QFlag,Kvp,Kvi,Trv,db1,db2,Kqv,Vdip,Vup,Tiq,Tpord,PqFlag,Imax,array_vdl1,array_vdl2,Vref0,T,SOC0;1;dx2,dx3,Undervoltage,Overvoltage,block,Vref,t0,Ipmax,Iqinj,Iqmax,Iqv,Qcalc,Vdif,Verr,Vref0_sig,Vt_filt,freeze,freeze1,freeze2,freeze3,freeze_low_s,freeze_up_s,o1,o10,o11,o12,o13,o14,o2,o3,o4,o5,o6,o7,o8,o9,vdl1,vdl2,y_max,y_min,y_min1,yi,yi1,yi10,yi11,yi12,yi2,yi3,yi4,yi5,yi6,yi7,yi8,yi9,freeze_Voltage_Dip,S,freeze_up_sig,freeze_low_sig;60;inc(x0) = Vt;inc(x1) = Pe;inc(x2) = Vt;inc(x3) = Iqcmd-Iqinj;inc(x4) = yi9;inc(x5) = Pref;"inc(x7) = 0 ";;inc(SOC)  = SOC0;inc(Paux) = 0;inc(yi11) = SOC0;"inc(Iqinj) = 0 ";inc(Vref)  = Vt;inc(S)     = sqrt(Pe*Pe+Qgen*Qgen);inc(PFAref)= selfix(Pe < 0.000001, 0.0, selfix(PfFlag .and. .not. VFlag .and. QFlag,atan2(Vt,Pe), selfix(Qgen>=0, acos(Pe/S), -acos(Pe/S))));inc(Qext)  = selfix(PfFlag>0.5,0,selfix(VFlag < 0.5 .and. QFlag > 0.5,Vt, Qgen));inc(Pref)  = Ipcmd*Vt;inc(Pord)  = Ipcmd*Vt;inc(Voltage_Dip) = 0;"inc(freeze_Voltage_Dip)=0  ";;;"freeze_Voltage_Dip = Voltage_Dip    ";;;"vardef(VFlag) = ;'Voltage control flag: 1 = Q ctrl., 0 = voltage control'";"vardef(Tp)    = 's';'Filter time constant for power measurement'";"vardef(Kqp)   = 'p.u.';'Proportional gain'";"vardef(Kqi)   = 'p.u.';'Integral gain'";"vardef(Kvp)   = 'p.u.';'Proportional gain'";"vardef(Kvi)   = 'p.u.';'Integral gain'";"vardef(QFlag) = ;'Q control flag: 1 = voltage/Q, 0 = const. pf or Q ctrl.'";"vardef(Trv)   = 's';'Filter time constant for voltage measurements'";"vardef(db1)   = 'p.u.';'Voltage deadband for overvoltage iq injection'";"vardef(db2)   = 'p.u.';'Voltage deadband for undervoltage iq injection'";"vardef(Kqv)   = 'p.u.';'Gain for reactive current injection during fault'";"vardef(Vdip)  = 'p.u.';'Undervoltage condition trigger voltage'";"vardef(Vup)   = 'p.u.';'Overvoltage condition trigger voltage'";"vardef(Tiq)   = 's';'Time constant on lag delay'";"vardef(Tpord) = 's';'Time constant'";"vardef(PqFlag)= ;'Priority flag on current limit: 1 = P, 0 = Q priority'";"vardef(Imax)  = 'p.u.';'Maximum converter current limit'";"vardef(Qmax)  = 'p.u.';'Reactive power limit maximum'";"vardef(Vmax)  = 'p.u.';'Voltage control maximum'";"vardef(Iqh1)  = 'p.u.';'Maximum limit of reactive current injection'";"vardef(dPmax) = 'p.u./s';'Ramp rate on power reference'";"vardef(Pmax)  = 'p.u.';'Maximum power reference'";"vardef(Qmin)  = 'p.u.';'Reactive power limit minimum'";"vardef(Vmin)  = 'p.u.';'Voltage control minimum'";"vardef(Iql1)  = 'p.u.';'Minimum limit of reactive current injection'";"vardef(dPmin) = 'p.u./s';'Ramp rate on power reference'";"vardef(Pmin)  = 'p.u.';'Minimum power reference'";"vardef(PfFlag)= ;'Power factor flag: 1 = pf control, 0 = Q control'";"vardef(Vref0) = 'p.u.';'Reference voltage, enter 0 for terminal voltage'";"vardef(SOC0)  = 'p.u.';'Inital state of charge'";"vardef(SCOmax)= 'p.u.';'max allowable state of charge'";"vardef(SCOmin)= 'p.u.';'min allowable state of charge'";"vardef(SOC)   = 'p.u.';'State of charge'";"vardef(T)     = 's';'Discharge time'";;;;;;;;;;;;;;;1;freeze_Voltage_Dip,S,freeze_up_sig,freeze_low_sig;0;;Voltage_Dip,Iqcmd,Ipcmd,Pord,SOC;Vt,PFAref,Pe,Qext,Qgen,Pref,Paux;x1,x2,x3,x0,x4,x5,x7;PfFlag,VFlag,Tp,Kqp,Kqi,QFlag,Kvp,Kvi,Trv,db1,db2,Kqv,Vdip,Vup,Tiq,Tpord,PqFlag,Imax,array_vdl1,array_vdl2,Vref0,T,SOC0;dx2,dx3,Undervoltage,Overvoltage,block,Vref,t0,Ipmax,Iqinj,Iqmax,Iqv,Qcalc,Vdif,Verr,Vref0_sig,Vt_filt,freeze,freeze1,freeze2,freeze3,freeze_low_s,freeze_up_s,o1,o10,o11,o12,o13,o14,o2,o3,o4,o5,o6,o7,o8,o9,vdl1,vdl2,y_max,y_min,y_min1,yi,yi1,yi10,yi11,yi12,yi2,yi3,yi4,yi5,yi6,yi7,yi8,yi9,freeze_Voltage_Dip,S,freeze_up_sig,freeze_low_sig
