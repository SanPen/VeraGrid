  59;C;gov_GOV;;0;4;1;A1U,V1B,V1A;0;;1;V2B,V2A;0;;1;CM,pt;1;speed_ref,speed,UGSTEP,UCSTEP,cosn,SG;1;xiv,xhpv,xR,xL;1;WG,TG,WC,TC,TR,TL,F,R,RC,UC,PN;1;RP2oP1,RP2oP2,term1,term2,M,M1,M2,M3,P1,P2,W0,W1,W2,a1,a2,b2,o1,o11,o13,o18,yi,yi1,yi10,yi2,yi3,yi4,yi5,yi6,yi7,yi8,yi9;56;"! The following initialisation is based on the assumption: ";! P1 = P2;;! CM connected to Gen;!inc0(CM)=0.968494;!inc(M3)=CM*speed;!inc(pt)=M3*PN/SN/cosn;;! pt connected to Gen;inc(M3)=pt*SG*cosn/PN;inc(CM)=M3/speed;;inc(M)=M3+0.02*SG*speed/PN;inc(W1)=M;inc(W2)=M;inc(P1)=M;inc(P2)=M;inc(xL)=P1;inc(xR)=P2;inc(b2)=1.0;inc(xiv)=b2;inc(W0)=W1;inc(a2)=W0/((1-sqr(W0))*RC+1);inc(xhpv)=a2;inc(speed_ref)=speed+WG*a2;inc0(UGSTEP)=0;inc0(UCSTEP)=0;;"vardef(WG)='pu';'Regulation of HP throttle valve loop'";"vardef(TG)='s';'Time constant of HP throttle valve'";"vardef(WC)='pu';'Regulation of interceptor valve loop'";"vardef(TC)='s';'Time constant of interceptor valve'";"vardef(TR)='s';'Time constant of reheater'";"vardef(TL)='s';'Loop pipe time constant of HP steam main'";"vardef(F)=' ';'Ratio of power in HP cylinder to total turbine power'";"vardef(R)=' ';'Ration of reheater pressure to HP inlet pressure at full load'";"vardef(RC)=' ';'Resistance coefficient of boiler/turbine pipework'";"vardef(PN)='MW';'Rated turbine power'";"vardef(UC)='pu';'Turbine speed at which interceptor valve starts to close'";"vardef(V2B)=' ';'Maximum rate limit of interceptor valve CLOSING'";"vardef(V2A)=' ';'Maximum rate limit of HP throttle valve CLOSING'";"vardef(A1U)=' ';'Maximum opening of HP throttle and interceptor valves'";"vardef(V1B)=' ';'Maximum rate limit of interceptor valve OPENING'";"vardef(V1A)=' ';'Maximum rate limit of HP throttle valve OPENING'";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;0;;0;;CM,pt;speed_ref,speed,UGSTEP,UCSTEP,cosn,SG;xiv,xhpv,xR,xL;WG,TG,WC,TC,TR,TL,F,R,RC,UC,PN;RP2oP1,RP2oP2,term1,term2,M,M1,M2,M3,P1,P2,W0,W1,W2,a1,a2,b2,o1,o11,o13,o18,yi,yi1,yi10,yi2,yi3,yi4,yi5,yi6,yi7,yi8,yi9
