  51;C;vol_stator_voltage_REGC_C;6156;1;6;0;;0;;0;;0;;1;ur_ref,ui_ref;1;ur,id_ref,iq_ref,ui,is_blocked;1;x_lpf_d,x_lpf_q;1;re,xe,Te;1;cosphi_vt,sinphi_vt,couple_dq,couple_qd,e_unfiltered_d,e_unfiltered_q,er_d,er_q,i_ref_i,i_ref_r,is_not_blocked,yi,yi1;16;"! Algebraic stator voltage calculation according to the stator current ";! and series impedance;inc(x_lpf_d) = ur_ref;inc(x_lpf_q) = ui_ref;!inc(is_blocked) = 0;;"!vardef(re) = 'p.u.';'Source resistance'";"!vardef(xe) = 'p.u.';'Source reactance'";"!vardef(id_ref) = 'p.u.';'Reference current direct axis'";"!vardef(iq_ref) = 'p.u.';'Reference current quadrature axis'";"!vardef(ur) = 'p.u.';'Terminal voltage real'";"!vardef(ui) = 'p.u.';'Terminal voltage imaginary'";"!vardef(ur_ref) = 'p.u.';'Voltage of source real'";"!vardef(ui_ref) = 'p.u.';'Voltage of source imaginary'";"!vardef(Te) = 's';'Emulated delay in converter controls'";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;0;;0;;ur_ref,ui_ref;ur,id_ref,iq_ref,ui,is_blocked;x_lpf_d,x_lpf_q;re,xe,Te;cosphi_vt,sinphi_vt,couple_dq,couple_qd,e_unfiltered_d,e_unfiltered_q,er_d,er_q,i_ref_i,i_ref_r,is_not_blocked,yi,yi1
