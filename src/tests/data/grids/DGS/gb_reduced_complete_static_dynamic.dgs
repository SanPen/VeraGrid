  39;C;REGC_C;6229;0;7;1;Iqrmax,rrpwr,wmax;0;;1;Iqrmin,wmin;0;;1;iqref,ur_ref,ui_ref,idref;1;ur,Qgen0,Iqcmd,ir,ii,Vt,Ipcmd,ui,is_blocked;1;xq,xp,xfltr,x_lpf_d,x_lpf_q,x_pi_q,x_pi_p,x0,x1;1;Tg,Tfltr,RateFlag,re,xe,Te,Kip,Kii,Kppll,Kipll,Vpllfrz;1;dxq,Iqcmd_max_applied,Iqcmd_min_applied,cosphi_vt,sinphi_vt,couple_dq,couple_qd,e_unfiltered_d,e_unfiltered_q,er_d,er_q,i_ref_i,i_ref_r,is_not_blocked,yi,yi1,Voltage_Dip,phi,uq,yix,Ipcmd_or_ppcmd,V,V_or_one,const_one,id_meas,id_ref,iderr,ip_or_pp,iq_meas,iq_ref,iqerr;57;inc(xq)=iqref;inc(xp)=selfix(RateFlag>0.5,Ipcmd*Vt,Ipcmd);"inc(xfltr)=Vt ";inc(x_pi_q)=iqref;inc(x_pi_p)=idref;;inc(Iqcmd)=-iqref;inc(Ipcmd)=idref;;inc(is_blocked)=0;;"inc(Qgen0)=iqref !initial value needed for calculation ";;;"vardef(Tg)       = 's'         ;'Converter time constant'";"vardef(Iqrmax)   = 'p.u./s'    ;'Max. reactive current rate limit'";"vardef(Iqrmin)   = 'p.u./s'    ;'Min. reactive current rate limit'";"vardef(Tfltr)    = 's'         ;'Voltage filter time constant'";"vardef(rrpwr)    = 'p.u./s'    ;'Active current rate limit'";"vardef(RateFlag) =             ;'Rate limit: 0 = active current, 1 = active power'";"vardef(Te)       = 's'         ;'Emulated delay in converter controls'";"vardef(re)       = 'p.u.'      ;'Source resistance'";"vardef(xe)       = 'p.u.'      ;'Source reactance'";"vardef(Kip)      =             ;'Proportional gain of the inner current loop'";"vardef(Kii)      = '1/s'       ;'Integral gain of the inner current loop'";"vardef(Kppll)    = 'rad/s/pu'  ;'Proportional gain of the PLL'";"vardef(Kipll)    = 'rad/s/pu/s';'Integral gain of the PLL'";"vardef(wmax)     = 'rad/s'     ;'Upper limit on the PLL'";"vardef(wmin)     = 'rad/s'     ;'Lower limit on the PLL'";"vardef(Vpllfrz)  = 'p.u.'      ;'Lower voltage level to freeze PLL'";;"vardef(id_ref) = 'p.u.';'Reference current, direct axis'";"vardef(iq_ref) = 'p.u.';'Reference current, quadrature axis'";"vardef(ur)     = 'p.u.';'Terminal voltage, real part'";"vardef(ui)     = 'p.u.';'Terminal voltage, imaginary part'";"vardef(ur_ref) = 'p.u.';'Voltage of source, real part'";"vardef(ui_ref) = 'p.u.';'Voltage of source, imaginary part'";;;"limfix(Iqrmax)   = (0,)          ! Iqrmax > 0; typical: >=1";"limfix(Iqrmin)   = (,0)          ! Iqrmin < 0; typical: <=-1";limfix(Tfltr)    = [0.02,0.05]   ! 0.02 <= Tfltr <= 0.05;"limfix(rrpwr)    = (0,)          ! rrpwr > 0; typical: 1-20";limfix(RateFlag) = [0,1]         ! 0 <= RateFlag <= 1;"limfix(Te)       = (0.0,0.02]    ! 0.0 < Te <= 0.02; note: Te has to be larger than zero in PF to avoid algebraic loop";limfix(re)       = [0,)          ! re >= 0;limfix(xe)       = (0,)          ! xe > 0;limfix(Kip)      = (0,)          ! Kip > 0;limfix(Kii)      = (0,)          ! Kii > 0;limfix(Kppll)    = (0,)          ! Kppll > 0;limfix(Kipll)    = (0,)          ! Kipll > 0;limfix(Kip)      = (0,)          ! Kip > 0;limfix(Kii)      = (0,)          ! Kii > 0;limfix(wmax)     = (0,)          ! wmax > 0;limfix(wmin)     = (,0)          ! wmin < 0;limfix(Vpllfrz)  = [0.1,0.5]     ! 0.1 <= Vpllfrz <= 0.5;;;;;;;;;;;;;;;;;;0;;0;;iqref,ur_ref,ui_ref,idref;ur,Qgen0,Iqcmd,ir,ii,Vt,Ipcmd,ui,is_blocked;xq,xp,xfltr,x_lpf_d,x_lpf_q,x_pi_q,x_pi_p,x0,x1;Tg,Tfltr,RateFlag,re,xe,Te,Kip,Kii,Kppll,Kipll,Vpllfrz;dxq,Iqcmd_max_applied,Iqcmd_min_applied,cosphi_vt,sinphi_vt,couple_dq,couple_qd,e_unfiltered_d,e_unfiltered_q,er_d,er_q,i_ref_i,i_ref_r,is_not_blocked,yi,yi1,Voltage_Dip,phi,uq,yix,Ipcmd_or_ppcmd,V,V_or_one,const_one,id_meas,id_ref,iderr,ip_or_pp,iq_meas,iq_ref,iqerr
