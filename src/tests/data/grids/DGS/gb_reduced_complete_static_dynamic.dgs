  93;C;Current Limit Logic;6163;1;6;0;;0;;0;;0;;1;iqmin,iqmax,ipmin,ipmax;1;Iqcmd,vdlq,vdlp,Ipcmd,is_blocked;0;;1;PqFlag,Imax,Thld2,Ke;1;blocking_factor;11;blocking_factor = select_const(is_blocked,0,1);;;!input Ipcmd is unlimited, but this is considered via min(vdlp,Imax,Ipcmd) to avoid algebraic loops;iqmax = selfix(PqFlag>0, min(vdlq,sqrt(max(sqr(Imax)-sqr(min(vdlp,Imax,Ipcmd)),0.0))), min(vdlq,Imax))*blocking_factor;iqmin = select(iqmax<0, iqmax, -iqmax)*blocking_factor;;!input Iqcmd is unlimited, but this is considered via min(vdlq,Imax,Iqcmd) to avoid algebraic loops;ipmax = selfix(PqFlag>0, min(vdlp,Imax), min(vdlp,sqrt(max(sqr(Imax)-sqr(min(vdlq,Imax,Iqcmd)),0.0))))*blocking_factor;ipmin = -Ke*ipmax*blocking_factor;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;0;;0;;iqmin,iqmax,ipmin,ipmax;Iqcmd,vdlq,vdlp,Ipcmd,is_blocked;;PqFlag,Imax,Thld2,Ke;blocking_factor
  94;C;Current_blocking;6163;1;6;0;;0;;0;;0;;1;is_blocked;1;Vt_filt;0;;1;vblkl,vblkh,Tblk_delay;1;is_voltage_violation;15;! Initialization;inc(is_voltage_violation) = selfix_const(Vt_filt>=vblkh .or. Vt_filt<=vblkl,1,0);inc(is_blocked) = 0;;! Calculation;is_voltage_violation = picdro_const(Vt_filt>=vblkh .or. Vt_filt<=vblkl, 0.05, 0)!select_const(Vt_filt>=vblkh .or. Vt_filt<=vblkl,1,0);is_blocked = picdro_const(is_voltage_violation,0,Tblk_delay);;"!violation_ends_at_this_step = ";!& lastvalue(is_over_or_undervoltage) .and. .not. is_over_or_undervoltage;"!time_when_violation_ended = ";!& select(violation_ends_at_this_step>0,time(),lastvalue(time_when_violation_ended));!time_since_violation_ended = time() - time_when_violation_ended;"!stay_in_blocking_mode = ";!select(time_since_violation_ended<Tblk_delay,0);;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;0;;0;;is_blocked;Vt_filt;;vblkl,vblkh,Tblk_delay;is_voltage_violation
  95;C;DBand;6163;1;6;0;;0;;0;;0;;1;yo;1;yi;0;;1;db1,db2;0;;5;!by pass if db is zero, prevents toggling;yo=selfix(db1=0 .and. db2=0,yi,select(yi>abs(db2),yi-abs(db2),select(yi<-abs(db1),yi+abs(db1),0)));;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;0;;0;;yo;yi;;db1,db2;
  96;C;Fault Detection;6163;1;6;0;;0;;0;;0;;1;Voltage_Dip;1;Vt;0;;1;Vdip,Vup;1;Undervoltage,Overvoltage;9;Undervoltage = picdro_const((Vdip-Vt)+0.5, 0.005, 0.005) !Vt<Vdip;Overvoltage =  picdro_const((Vt-Vup)+0.5, 0.005, 0.005)   !Vt>Vup;!Undervoltage = Vt<Vdip;!Overvoltage =  Vt>Vup;;Voltage_Dip = Undervoltage .or. Overvoltage;;inc(Undervoltage) = selfix_const(Vt<Vdip,1,0);inc(Overvoltage)  = selfix_const(Vt>Vup,1,0);;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;0;;0;;Voltage_Dip;Vt;;Vdip,Vup;Undervoltage,Overvoltage
