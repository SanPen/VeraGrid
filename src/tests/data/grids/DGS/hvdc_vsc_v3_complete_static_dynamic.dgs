);sAddEquat:336(a);sAddEquat:337(a);sAddEquat:338(a);sAddEquat:339(a);sAddEquat:340(a);sAddEquat:341(a);sAddEquat:342(a);sAddEquat:343(a);sAddEquat:344(a);sAddEquat:345(a);sAddEquat:346(a);sAddEquat:347(a);sAddEquat:348(a);sAddEquat:349(a);sAddEquat:350(a);sAddEquat:351(a);sAddEquat:352(a);sAddInter:SIZEROW(i);sAddInter:0(a);sAddParam:SIZEROW(i);sAddParam:0(a);cOutput(a);cInput(a);cStates(a);cParams(a);cIntern(a)
  2;C;Chopper Controller R (RMS);285;0;6;0;;0;;0;;0;;1;gate,R,trip;1;udcp,udcm,Idcp,Idcm,trig_ext,P_ext;1;xu,xR,xe;1;Topo,Un,udc_act,udc_max,Tudc,Pmin,Pmax,Mode_char,Tchp,Emax,Mode_bp,AutoInput;1;udc_in,udc,Rmax,Rmin,Rinc,Rx,P,E;93;"vardef(Topo)      =       ;'Circuit Topology: 0 = symmetric; 1 = asymmetric'";"vardef(Un)        = 'kV'  ;'Nominal DC voltage'";"vardef(udc_act)   = 'p.u.';'DC voltage threshold for chopper activation'";"vardef(udc_max)   = 'p.u.';'Maximum DC voltage'";"vardef(Tudc)      = 's'   ;'Voltage mesaurement time constant'";"vardef(Pmin)      = 'MW'  ;'Minimum power consumption at udc_act'";"vardef(Pmax)      = 'MW'  ;'Maximum power consumption at udc_max'";"vardef(Mode_char) =       ;'Characteristic: 0 = R linear, 1 = P linear with u'";"vardef(Tchp)      = 's'   ;'Effective time constant of control and PWM'";"vardef(Emax)      = 'MWs' ;'Maximum admissible energy absorption'";"vardef(Mode_bp)   =       ;'Bypass if Emax exceeded: 0=disabled, 1=enabled'";"vardef(AutoInput) =       ;'Automated input: 0 = no, 1 = yes (Topo, Un)'";;"vardef(udc)      = 'p.u.';'DC voltage'";"vardef(udcp)     = 'p.u.';'DC voltage (plus pole)'";"vardef(udcm)     = 'p.u.';'DC voltage (minus pole)'";"vardef(gate)     =       ;'Gate signal'";"vardef(R)        = 'Ohm' ;'Chopper resistance'";"vardef(trip)     =       ;'Overload trip signal'";"vardef(trig_ext) =       ;'External trigger signal: 0 = off, 1 = on (triggered)'";"vardef(P_ext)    = 'MW'  ;'Ordered power consumption if externally triggered'";;"vardef(Idcp) = 'kA' ;'Current (plus pole)'";"vardef(Idcm) = 'kA' ;'Current (minus pole)'";"vardef(P)    = 'MW' ;'Power consumption'";"vardef(E)    = 'MWs';'Absorbed energy'";"vardef(Rinc) = 'Ohm';'Initial chopper resistance'";"vardef(Rmax) = 'Ohm';'Maximum chopper resistance'";"vardef(Rmin) = 'Ohm';'Minimum chopper resistance'";;;limfix(Topo)      = [0,1]         ! 0 <= Topo <= 1;limfix(Un)        = (0,)          ! Un > 0;limfix(udc_act)   = (0,udc_max)   ! 0 < udc_act < udc_max;limfix(udc_max)   = (udc_act,)    ! udc_max > udc_act;limfix(Tudc)      = [0,)          ! Tudc >= 0;limfix(Pmin)      = (0,Pmax)      ! 0 < Pmin < Pmax;limfix(Pmax)      = (Pmin,)       ! Pmax > Pmin;limfix(Mode_char) = [0,1]         ! 0 <= Mode_char <= 1;limfix(Tchp)      = [0,)          ! Tchp >= 0;limfix(Emax)      = (0,)          ! Emax > 0;limfix(Mode_bp)   = [0,1]         ! 0 <= Mode_bp <= 1;limfix(AutoInput) = [0,1]         ! 0 <= AutoInput <= 1;;;inc0(udcp) = +1.0;inc0(udcm) = -1.0;inc0(P_ext) = Pmax;;inc(xu) = udc_in;inc(xR) = R;inc(xe) = 0;;inc(gate) = select(udc>udc_act,1,-1);inc(trig_ext) = 0;inc(trip) = 0;inc(Rinc) = R;inc(Rmax) = selfix(Topo, sqr(udc_act*Un)/Pmin, sqr(udc_act*Un)/(2*Pmin));inc(Rmin) = selfix(Topo, sqr(udc_max*Un)/Pmax, sqr(udc_max*Un)/(2*Pmax));;;udc_in = selfix(Topo,(udcp-udcm),(udcp-udcm)/2);xu. = selfix(Tudc>0, (udc_in-xu)/selfix(Tudc>0,Tudc,1.0), 0.0);udc = selfix(Tudc>0, xu, udc_in);;gate = 2*(picdro_const((udc-udc_act)+0.5,0.001,0.005)+trig_ext+selfix(Mode_bp,trip,0))-1   !picdrop output is 1 or 0;output(gate,'Chopper activated.');;Rx = select(trip.and.Mode_bp, Rmin/100,  !Set to Rmin/100 if Emax is exceeded and bypass mode enabled  ;&    select(trig_ext, sqr(udc*Un)/max(abs(P_ext),0.000001), !Chopper externally triggered;!           !Chopper triggered because udc > udc_act;&           select(2*picdro_const((udc-udc_act)+0.5,0.000,0.010)-1, ;&                  select(Mode_char, ;!                         !Change effective chopper resistance with square root function depending on dc over-voltage;!                         !in order to achieve a linear dependency of power consumed by chopper with dc over-voltage:;&                         max(Rmin,min(max(Rmax,Rinc),(Rmax + sqrt(max(0.0,min(udc,udc_max) - udc_act))*(Rmin - Rmax)/sqrt(udc_max - udc_act)))),;!                         !Change effective chopper resistance linear with dc over-voltage:;&                         max(Rmin,min(max(Rmax,Rinc),(Rmax + (min(udc,udc_max) - udc_act)*(Rmin - Rmax)/(udc_max - udc_act))))),;&           Rinc)));;xR. = selfix(Tchp>0, (Rx-xR)/selfix(Tchp>0,Tchp,1.0), 0.0);R = selfix(Tchp>0, xR, Rx);;P = selfix(Topo, udcp*Un*Idcp + udcm*Un*Idcm, udcp*Un/2*Idcp + udcm*Un/2*Idcm) != abs(udcp)*Un/2*abs(Idcp) + abs(udcm)*Un/2*abs(Idcm) ! Equation with abs() only valid if there are no inductances;xe. = abs(P) ! Change of energy absorbed in chopper. Chopper transforms current into heat independently from current flow direction.;!xe. = select(trip.and.Mode_bp, 0.0, abs(P)) ! Change of energy absorbed in chopper as long as not bypassed. Chopper transforms current into heat independently from current flow direction.;E = select(trip.and.Mode_bp, max(Emax,lastvalue(E)), xe);;trip = picdro_const(flipflop(E-Emax+0.5,0), 0.001, 0.001);output({E>Emax}.and.{.not.Mode_bp},'WARNING: Maximum admissible energy absorption exceeded!');output({E>Emax}.and.Mode_bp,'WARNING: Maximum admissible energy absorption exceeded! DC chopper will be bypassed.');output({2*(trip-0.5)}.and.Mode_bp,'Bypass activated.');;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;0;;0;;gate,R,trip;udcp,udcm,Idcp,Idcm,trig_ext,P_ext;xu,xR,xe;Topo,Un,udc_act,udc_max,Tudc,Pmin,Pmax,Mode_char,Tchp,Emax,Mode_bp,AutoInput;udc_in,udc,Rmax,Rmin,Rinc,Rx,P,E
  3;C;Frame Chopper R symmetric;285;0;6;0;;0;;0;;0;;1;trip;1;trig_ext,P_ext;0;;0;;1;R,gate,idcm,idcp,udcm,udcp;0;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;0;;0;;trip;trig_ext,P_ext;;;R,gate,idcm,idcp,udcm,udcp
  4;C;FRT Control (Pos Seq Balanced) BlkDef;286;0;6;0;;0;;0;;0;;1;i1P_frt_ref,fault_detected,UVRT,OVRT,FRT_active,i1Q_frt_ref;1;i1P_ref,u1_loc,u1_poc,i1Q_ref;1;xu10,xi1Q_ref_slow,xi1P_ref_slow;1;poc,u_db_up,u_db_low,db_abs,u1fix,Tpost,diroot,K1,Tupre,DynCont,iQ_ref_frz,Tipre,u1min,iQ_red,iP_red,KiPred,iP_ref_frz;1;UV,OV,fault_UV,fault_OV,frt_UV,frt_OV,Delta_u1,i1Q_ref_slow,i1Q_ref_freeze,u1min_iQ,i1P_ref_slow,i1P_ref_freeze,u1min_iP,Delta_i1Q,u1,u10;88;Delta_u1=selfix(diroot>2.5,u1-u1fix,selfix(diroot>1.5,u1-1.0,selfix(diroot>0.5,selfix(db_abs>1.5,select(u1<(u1fix+u_db_low),u1-(u1fix+u_db_low),select(u1>(u1fix+u_db_up),u1-(u1fix+u_db_up),0)),selfix(db_abs,select(u1<(1.0+u_db_low),u1-(1.0+u_db_low),select(u1>(1.0+u_db_up),u1-(1.0+u_db_up),0)),select(u1<(u10+u_db_low),u1-(u10+u_db_low),select(u1>(u10+u_db_up),u1-(u10+u_db_up),0)))),u1-u10)));Delta_i1Q=-Delta_u1*K1;UV=selfix(db_abs>1.5,((u1fix+u_db_low)-u1)+0.5,selfix(db_abs,((1.0+u_db_low)-u1)+0.5,((u10+u_db_low)-u1)+0.5));OV=selfix(db_abs>1.5,(u1-(u1fix+u_db_up))+0.5,selfix(db_abs,(u1-(1.0+u_db_up))+0.5,(u1-(u10+u_db_up))+0.5));inc(fault_UV)=0;inc(fault_OV)=0;fault_UV=flipflop(selfix(db_abs>1.5,u1<(u1fix+u_db_low),selfix(db_abs,u1<(1.0+u_db_low),u1<(u10+u_db_low))),selfix(db_abs>1.5,u1>(u1fix+u_db_low+0.001),selfix(db_abs,u1>(1.0+u_db_low+0.001),u1>(u10+u_db_low+0.001))));fault_OV=flipflop(selfix(db_abs>1.5,u1>(u1fix+u_db_up),selfix(db_abs,u1>(1.0+u_db_up),u1>(u10+u_db_up))),selfix(db_abs>1.5,u1<(u1fix+u_db_up-0.001),selfix(db_abs,u1<(1.0+u_db_up-0.001),u1<(u10+u_db_up-0.001))));fault_detected=select_const(fault_UV.or.fault_OV,1,0);UVRT=fault_UV;OVRT=fault_OV;inc(frt_UV)=0;inc(frt_OV)=0;frt_UV=picdro_const(UV,0.001,selfix_const(Tpost>0.005,Tpost,0.005));frt_OV=picdro_const(OV,0.001,selfix_const(Tpost>0.005,Tpost,0.005));FRT_active=select_const(frt_UV.or.frt_OV,1,0);u1min_iQ=flipflop(max(0.0,u1)<(u1min-0.000001),max(0.0,u1)>(u1min+0.000001));xi1Q_ref_slow.=selfix(iQ_ref_frz,select(FRT_active,0.0,selfix(Tipre>0,(i1Q_ref-xi1Q_ref_slow)/Tipre,0.0)),0.0);i1Q_ref_slow=xi1Q_ref_slow;i1Q_ref_freeze=selfix(iQ_ref_frz,select(FRT_active,lastvalue(i1Q_ref_freeze),selfix(Tipre>0,i1Q_ref_slow,i1Q_ref)),i1Q_ref);i1Q_frt_ref=select(FRT_active,select(u1min_iQ,0.0,selfix(iQ_red,0.0,selfix(iQ_ref_frz,i1Q_ref_freeze+Delta_i1Q,i1Q_ref+Delta_i1Q))),selfix(DynCont,i1Q_ref+Delta_i1Q,i1Q_ref));xu10.=selfix(Tupre>0,select(fault_detected,0.0,(u1-xu10)/Tupre),0.0);u10=xu10;u1=selfix(poc>0,u1_poc,u1_loc);u1min_iP=flipflop(max(0.0,u1)<(u1min-0.000001),max(0.0,u1)>(u1min+0.000001));xi1P_ref_slow.=selfix(iP_ref_frz,select(UVRT,0.0,selfix(Tipre>0,(i1P_ref-xi1P_ref_slow)/Tipre,0.0)),0.0);i1P_ref_slow=xi1P_ref_slow;i1P_ref_freeze=selfix(iP_ref_frz,select(UVRT,lastvalue(i1P_ref_freeze),selfix(Tipre>0,i1P_ref_slow,i1P_ref)),i1P_ref);i1P_frt_ref=select(UVRT,select(u1min_iP,0.0,selfix(iP_red>1.5,selfix(iP_ref_frz,i1P_ref_freeze,i1P_ref)*(1.0-max(0.0,min(1.0,KiPred*selfix(db_abs,(1.0+u_db_low-u1)/(1.0+u_db_low),(u10+u_db_low-u1)/(u10+u_db_low))))),selfix(iP_red,0.0,i1P_ref))),i1P_ref);"vardef(poc)=;'Voltage monitored: 0 = at local terminal, 1 = at PoC'";"vardef(u_db_up)='p.u.';'Fault detection upper voltage deadband'";"vardef(u_db_low)='p.u.';'Fault detection lower voltage deadband'";"vardef(db_abs)=;'Deadband around: 0 = U pre-fault, 1 = U nominal, 2 = U individually fixed'";"vardef(u1fix)='p.u.';'Individually fixed pos.seq. voltage deadb. root'";"vardef(Tpost)='s';'Time for keeping FRT mode active after fault'";"vardef(Tupre)='s';'Time constant for pre-fault voltage'";"vardef(DynCont)=;'Continuous dynamic voltage support:  0=no, 1=yes'";"vardef(iQ_ref_frz)=;'Freeze iQ reference during FRT: 0 = no, 1 = yes'";"vardef(Tipre)='s';'Time constant for pre-fault current'";"vardef(diroot)=;'Add. current around: 0 = U pre-fault, 1 = U deadband, 2 = U nominal, 3 = U individually fixed'";"vardef(K1)=;'Gain for additional current in positive sequence'";"vardef(iQ_red)=;'Reduce reactive current to zero: 0 = no, 1 = yes'";"vardef(iP_red)=;'Reduce active current: 0 = no, 1 = zero, 2 = linear'";"vardef(KiPred)=;'Factor for linear active current reduction'";"vardef(iP_ref_frz)=;'Freeze iP reference during linear reduction: 0=no, 1=yes'";"vardef(u1min)='p.u.';'Minimum voltage for any current injection'";"vardef(u1_loc)='p.u.';'Positive sequence voltage magnitude at local terminal'";"vardef(u1_poc)='p.u.';'Positive sequence voltage magnitude at point of connection (PoC)'";"vardef(i1P_ref)='p.u.';'Positive sequence active current reference (input)'";"vardef(i1Q_ref)='p.u.';'Positive sequence reactive current reference without additional fault current'";"vardef(fault_detected)=;'Fault detected'";"vardef(UVRT)=;'Under-voltage-ride-through'";"vardef(OVRT)=;'Over-voltage-ride-through'";"vardef(FRT_active)=;'Fault-ride-through mode active'";"vardef(i1P_frt_ref)='p.u.';'Positive sequence active current reference (output)'";"vardef(i1Q_frt_ref)='p.u.';'Positive sequence reactive current reference including additional fault current'";"vardef(u1)='p.u.';'Positive sequence voltage magnitude'";"vardef(u10)='p.u.';'Pre-fault voltage magnitude, positive sequence'";"vardef(Delta_u1)='p.u.';'Voltage deviation, positive sequence'";"vardef(Delta_i1Q)='p.u.';'Additional reactive current, positive sequence'";"vardef(fault_UV)=;'Under-voltage detected'";"vardef(fault_OV)=;'Over-voltage detected'";limfix(poc)=[0,1];limfix(u_db_up)=[0,);limfix(u_db_low)=(,0];limfix(db_abs)=[0,2];limfix(Tpost)=[0.005,);limfix(Tupre)=(0,);limfix(Tipre)=(0,);limfix(DynCont)=[0,1];limfix(iQ_ref_frz)=[0,1];limfix(diroot)=[0,3];limfix(K1)=[0,);limfix(iQ_red)=[0,1];limfix(iP_red)=[0,2];limfix(KiPred)=[0,);limfix(iP_ref_frz)=[0,1];limfix(u1min)=[0,1);inc(xu10)=u1;inc(xi1P_ref_slow)=i1P_ref;inc(xi1Q_ref_slow)=i1Q_ref;inc(fault_detected)=0;inc(UVRT)=0;inc(OVRT)=0;inc(FRT_active)=0;inc(i1P_ref)=i1P_frt_ref;inc(i1Q_ref)=selfix(DynCont,i1Q_frt_ref-Delta_i1Q,i1Q_frt_ref);inc(u1)=selfix(poc,u1_poc,u1_loc);;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;0;;0;;i1P_frt_ref,fault_detected,UVRT,OVRT,FRT_active,i1Q_frt_ref;i1P_ref,u1_loc,u1_poc,i1Q_ref;xu10,xi1Q_ref_slow,xi1P_ref_slow;poc,u_db_up,u_db_low,db_abs,u1fix,Tpost,diroot,K1,Tupre,DynCont,iQ_ref_frz,Tipre,u1min,iQ_red,iP_red,KiPred,iP_ref_frz;UV,OV,fault_UV,fault_OV,frt_UV,frt_OV,Delta_u1,i1Q_ref_slow,i1Q_ref_freeze,u1min_iQ,i1P_ref_slow,i1P_ref_freeze,u1min_iP,Delta_i1Q,u1,u10
  5;C;Frame HVDC MMC Control (RMS Balanced);286;0;6;0;;0;;0;;0;;1;"trip,DC_switch_open;trip_dc;STATCOM_on,block";1;"mode_P_cmd,P_ref,udc_ref,EPC1;EPC2;EPC3;EPC4;EPC5;EPC6,yin_pod,mode_Q_cmd,uac_ref,Q_ref,pf_ref;pf_dir,phi0,mode_uac_droop_cmd,mode_f_droop_cmd,mode_isl_cmd";0;;0;;1;"DC_switch1_closed,DC_switch2_closed,EPC,FRT_active,Fnom_PoC1,Fnom_PoC2,P_min_epc;P_max_epc,Pac_loc,Pac_poc,Pmi,Pmr,Q_loc,Q_poc,UVRT,Ucap,block_remote,cosphi1;sinphi1,dP_epc,dP_fsm,dP_pod,dP_si,dPmarge_down,dPmarge_up,dQ_pod,f_Hz_in,f_fast;fn,f_fast_remote;fn_remote,f_slow,f_slow_remote,fn_Hz_in,fref,i1P_frt_ref,i1P_in_limit,i1P_ref,i1Q_frt_ref,i1Q_in_limit,i1Q_ref,i1d;i1q,i1d_ref,i1q_ref,i1r_loc;i1i_loc,i1r_poc2;i1i_poc2,i1r_poc;i1i_poc,i_loc,idc,idc;Pdc,mdc,phif,soft,trip_remote,u1,u1_ref,u1d;u1q,u1r_loc;u1i_loc,u1r_poc2;u1i_poc2,u1r_poc;u1i_poc,uac_poc,uconv_1d,uconv_1q,uconv_i,uconv_i_isl,uconv_i_nonisl,uconv_r,uconv_r_isl,uconv_r_nonisl,udc_n,udc_p,udc_slow;udc_fast,usp_loc_inst,uspr_loc_inst;uspi_loc_inst";0;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;0;;0;;"trip,DC_switch_open;trip_dc;STATCOM_on,block";"mode_P_cmd,P_ref,udc_ref,EPC1;EPC2;EPC3;EPC4;EPC5;EPC6,yin_pod,mode_Q_cmd,uac_ref,Q_ref,pf_ref;pf_dir,phi0,mode_uac_droop_cmd,mode_f_droop_cmd,mode_isl_cmd";;;"DC_switch1_closed,DC_switch2_closed,EPC,FRT_active,Fnom_PoC1,Fnom_PoC2,P_min_epc;P_max_epc,Pac_loc,Pac_poc,Pmi,Pmr,Q_loc,Q_poc,UVRT,Ucap,block_remote,cosphi1;sinphi1,dP_epc,dP_fsm,dP_pod,dP_si,dPmarge_down,dPmarge_up,dQ_pod,f_Hz_in,f_fast;fn,f_fast_remote;fn_remote,f_slow,f_slow_remote,fn_Hz_in,fref,i1P_frt_ref,i1P_in_limit,i1P_ref,i1Q_frt_ref,i1Q_in_limit,i1Q_ref,i1d;i1q,i1d_ref,i1q_ref,i1r_loc;i1i_loc,i1r_poc2;i1i_poc2,i1r