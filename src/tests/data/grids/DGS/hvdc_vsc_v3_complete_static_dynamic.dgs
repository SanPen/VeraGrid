  6;C;Limiter Current (Pos Seq) BlkDef;286;0;6;1;i_max,iP_max,iQ_max,diP_max,diP_max_frt,diP_max_soft,diQ_max_soft;0;;0;;0;;1;i1d_ref,i1q_ref,i1P_in_limit,i1Q_in_limit;1;i1P_ref,i1Q_ref,FRT_active,block,soft,soft_manually;0;;1;PrioQ,PrioQ_FRT;1;blocked,i1d_prioP,i1d_prioQ,i1q_prioP,i1q_prioQ,i1_ref_in,i1_ref_ltd,i1d_prioRatio,i1q_prioRatio,i1_ref_out,i_ref_out,FRT_post,soft_flagP,soft_flagQ;62;FRT_post=picdro_const(flipflop(FRT_active.and.{.not.lastvalue(FRT_active)},.not.FRT_active)-0.499,0.0,100/max(0.000001,diP_max_frt));soft_flagP=picdro_const(flipflop({soft.or.soft_manually}.and.{.not.lastvalue(soft.or.soft_manually)},.not.{soft.or.soft_manually})-0.499,0.0,100/max(0.000001,diP_max_soft));soft_flagQ=picdro_const(flipflop({soft.or.soft_manually}.and.{.not.lastvalue(soft.or.soft_manually)},.not.{soft.or.soft_manually})-0.499,0.0,100/max(0.000001,diQ_max_soft));i1_ref_in=sqrt(sqr(i1P_ref)+sqr(i1Q_ref));i1_ref_ltd=min(i1_ref_in,i_max);i1d_prioP=max(-iP_max,min(iP_max,i1P_ref));i1q_prioP=max(-sqrt(max(0.0,sqr(i_max)-sqr(i1d_prioP))),min(sqrt(max(0.0,sqr(i_max)-sqr(i1d_prioP))),i1q_prioQ));i1d_prioQ=max(-sqrt(max(0.0,sqr(i_max)-sqr(i1q_prioQ))),min(sqrt(max(0.0,sqr(i_max)-sqr(i1q_prioQ))),i1d_prioP));i1q_prioQ=max(-iQ_max,min(iQ_max,-i1Q_ref));i1d_prioRatio=i1P_ref*max(0.00000001,i1_ref_ltd)/max(0.00000001,i1_ref_in);i1q_prioRatio=-i1Q_ref*max(0.00000001,i1_ref_ltd)/max(0.00000001,i1_ref_in);i1d_ref=select(i1P_ref>0.000001,select(blocked,0.0,select(FRT_active,gradlim_const(select(i1P_ref>0.000001,selfix(PrioQ_FRT>1.5,i1d_prioRatio,selfix(PrioQ_FRT,i1d_prioQ,i1d_prioP)),0.0),-99999,diP_max_frt/100),select(FRT_post,gradlim_const(select(i1P_ref>0.000001,selfix(PrioQ>1.5,i1d_prioRatio,selfix(PrioQ,i1d_prioQ,i1d_prioP)),0.0),-99999,diP_max_frt/100),select(soft_flagP,gradlim_const(select(i1P_ref>0.000001,selfix(PrioQ>1.5,i1d_prioRatio,selfix(PrioQ,i1d_prioQ,i1d_prioP)),0.0),-99999,diP_max_soft/100),gradlim_const(select(i1P_ref>0.000001,selfix(PrioQ>1.5,i1d_prioRatio,selfix(PrioQ,i1d_prioQ,i1d_prioP)),0.0),-99999,diP_max/100))))),select(i1P_ref<-0.000001,select(blocked,0.0,select(FRT_active,gradlim_const(select(i1P_ref<-0.000001,selfix(PrioQ_FRT>1.5,i1d_prioRatio,selfix(PrioQ_FRT,i1d_prioQ,i1d_prioP)),0.0),-diP_max_frt/100,99999),select(FRT_post,gradlim_const(select(i1P_ref<-0.000001,selfix(PrioQ>1.5,i1d_prioRatio,selfix(PrioQ,i1d_prioQ,i1d_prioP)),0.0),-diP_max_frt/100,99999),select(soft_flagP,gradlim_const(select(i1P_ref<-0.000001,selfix(PrioQ>1.5,i1d_prioRatio,selfix(PrioQ,i1d_prioQ,i1d_prioP)),0.0),-diP_max_soft/100,99999),gradlim_const(select(i1P_ref<-0.000001,selfix(PrioQ>1.5,i1d_prioRatio,selfix(PrioQ,i1d_prioQ,i1d_prioP)),0.0),-diP_max/100,99999))))),select(blocked,0.0,select(FRT_active,selfix(PrioQ_FRT>1.5,i1d_prioRatio,selfix(PrioQ_FRT,i1d_prioQ,i1d_prioP)),selfix(PrioQ>1.5,i1d_prioRatio,selfix(PrioQ,i1d_prioQ,i1d_prioP))))));i1q_ref=select(blocked,0.0,select(FRT_active,selfix(PrioQ_FRT>1.5,i1q_prioRatio,selfix(PrioQ_FRT,i1q_prioQ,i1q_prioP)),select(soft_flagQ,select(i1Q_ref<-0.000001,gradlim_const(select(i1Q_ref<-0.000001,selfix(PrioQ>1.5,i1q_prioRatio,selfix(PrioQ,i1q_prioQ,i1q_prioP)),0.0),-99999,diQ_max_soft/100),select(i1Q_ref>0.000001,gradlim_const(select(i1Q_ref>0.000001,selfix(PrioQ>1.5,i1q_prioRatio,selfix(PrioQ,i1q_prioQ,i1q_prioP)),0.0),-diQ_max_soft/100,99999),selfix(PrioQ>1.5,i1q_prioRatio,selfix(PrioQ,i1q_prioQ,i1q_prioP)))),selfix(PrioQ>1.5,i1q_prioRatio,selfix(PrioQ,i1q_prioQ,i1q_prioP)))));i1_ref_out=sqrt(max(0.0,sqr(i1d_ref)+sqr(i1q_ref)));i_ref_out=i1_ref_out;output(i_ref_out>i_max+0.00001,'Current reference output exceeds maximum limit: i_ref_out=i_ref_out > i_max=i_max');blocked=picdro_const(block-0.4999,0.000,0.001);i1P_in_limit=picdro_const(abs(i1P_ref)-abs(i1d_ref)+0.499,0.005,0.001);i1Q_in_limit=picdro_const(abs(i1Q_ref)-abs(i1q_ref)+0.499,0.005,0.001);"vardef(PrioQ)=;'Priority during normal operation: 0=iP, 1=iQ, 2=ratio iP/iQ'";"vardef(PrioQ_FRT)=;'Priority during FRT: 0 = iP, 1 = iQ, 2=ratio iP/iQ'";"vardef(i_max)='p.u.';'Maximum current'";"vardef(iP_max)='p.u.';'Maximum active current'";"vardef(iQ_max)='p.u.';'Maximum reactive current'";"vardef(diP_max)='%/s';'Max. positive gradient of active current'";"vardef(diP_max_frt)='%/s';'Max. active current gradient at/post FRT'";"vardef(diP_max_soft)='%/s';'Max. active current gradient at soft restart'";"vardef(diQ_max_soft)='%/s';'Max. reactive current gradient at soft restart'";"vardef(FRT_active)=;'Fault-ride-through mode active'";"vardef(block)=;'Blocking signal'";"vardef(soft)=;'Automatic soft start trigger signal'";"vardef(soft_manually)=;'Manually soft start trigger signal'";"vardef(i1P_ref)='p.u.';'Active current reference, positive sequence'";"vardef(i1Q_ref)='p.u.';'Reactive current reference, positive sequence'";"vardef(i1_ref_in)='p.u.';'Current reference, magnitude, positive sequence'";"vardef(i1d_ref)='p.u.';'Current reference, positive sequence, d-axis'";"vardef(i1q_ref)='p.u.';'Current reference, positive sequence, q-axis'";"vardef(i1_ref_out)='p.u.';'Current reference, magnitude, positive sequence'";"vardef(i_ref_out)='p.u.';'Current reference, magnitude'";"vardef(i1P_in_limit)=;'Active current reference in positive sequence exceeds limit'";"vardef(i1Q_in_limit)=;'Reactive current reference in positive sequence exceeds limit'";"vardef(FRT_post)=;'Flag for active and post FRT'";"vardef(soft_flagP)=;'Flag for soft start of active power'";"vardef(soft_flagQ)=;'Flag for soft start of reactive power'";limfix(PrioQ)=[0,2];limfix(PrioQ_FRT)=[0,2];limfix(i_max)=(0,);limfix(iP_max)=(0,i_max];limfix(iQ_max)=[0,i_max];limfix(diP_max)=(0,);limfix(diP_max_frt)=(0,);limfix(diP_max_soft)=(0,);limfix(diQ_max_soft)=(0,);inc(FRT_active)=0;inc0(block)=0;inc0(soft)=0;inc(soft_manually)=0;inc(blocked)=block;inc(i1P_ref)=selfix(block,0.0,i1d_ref);inc(i1Q_ref)=selfix(block,0.0,-i1q_ref);inc(i1P_in_limit)=0;inc(i1Q_in_limit)=0;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;0;;0;;i1d_ref,i1q_ref,i1P_in_limit,i1Q_in_limit;i1P_ref,i1Q_ref,FRT_active,block,soft,soft_manually;;PrioQ,PrioQ_FRT;blocked,i1d_prioP,i1d_prioQ,i1q_prioP,i1q_prioQ,i1_ref_in,i1_ref_ltd,i1d_prioRatio,i1q_prioRatio,i1_ref_out,i_ref_out,FRT_post,soft_flagP,soft_flagQ
  7;C;Output Limiter Transform (Pos Seq)BlkDef;286;0;6;0;;0;;0;;0;;1;uconv_r,uconv_i;1;uconv_1d,uconv_1q,cosphi1,sinphi1;0;;1;uconv_max;1;theta1,uconv_1,uconv_1_ltd,uconv_1d_ltd,uconv_1q_ltd;25;uconv_1_ltd=max(0,min(uconv_max,uconv_1));uconv_1d_ltd=uconv_1_ltd*cos(theta1);uconv_1q_ltd=uconv_1_ltd*sin(theta1);uconv_r=uconv_1d_ltd*cosphi1-uconv_1q_ltd*sinphi1;uconv_i=uconv_1d_ltd*sinphi1+uconv_1q_ltd*cosphi1;uconv_1=sqrt(max(0.0,sqr(uconv_1d)+sqr(uconv_1q)));theta1=atan2(uconv_1q,uconv_1d);[theta1]='rad';"vardef(uconv_max)='p.u.';'Max. converter voltage'";"vardef(uconv_1d)='p.u.';'Converter voltage reference, positive sequence, d-axis'";"vardef(uconv_1q)='p.u.';'Converter voltage reference, positive sequence, q-axis'";"vardef(cosphi1)=;'Cosine of reference angle, positive sequence'";"vardef(sinphi1)=;'Sine of reference angle, positive sequence'";"vardef(uconv_r)='p.u.';'Converter voltage reference, real part'";"vardef(uconv_i)='p.u.';'Converter voltage reference, imaginary part'";"vardef(uconv_1)='p.u.';'Converter voltage reference, positive sequence, magnitude'";"vardef(uconv_1_ltd)='p.u.';'Converter voltage reference (limited), positive sequence, magnitude'";"vardef(uconv_1d_ltd)='p.u.';'Converter voltage reference (limited), positive sequence, d-axis'";"vardef(uconv_1q_ltd)='p.u.';'Converter voltage reference (limited), positive sequence, q-axis'";limfix(uconv_max)=(0,);inc(uconv_1d_ltd)=uconv_r*cosphi1+uconv_i*sinphi1;inc(uconv_1q_ltd)=-uconv_r*sinphi1+uconv_i*cosphi1;inc(uconv_1)=sqrt(max(0.0,sqr(uconv_r)+sqr(uconv_i)));inc(uconv_1d)=uconv_r*cosphi1+uconv_i*sinphi1;inc(uconv_1q)=-uconv_r*sinphi1+uconv_i*cosphi1;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;0;;0;;uconv_r,uconv_i;uconv_1d,uconv_1q,cosphi1,sinphi1;;uconv_max;theta1,uconv_1,uconv_1_ltd,uconv_1d_ltd,uconv_1q_ltd
  8;C;P_Vdc Control BlkDef;286;0;6;1;Vdc_max,dVdc_ref_max,dP_ref_max,P_ref_max,P_max,iP_max_vdc,dOutP_max,dOutVdc_max,iP_max;0;;1;Vdc_min,dVdc_ref_min,dP_ref_min,P_ref_min,P_min,dOutP_min,dOutVdc_min;0;;1;iP_ref,dPmarge_SI_up,dPmarge_SI_down;1;mode_P_cmd,DC_switch_open,trip_dc,STATCOM_on,EPC,dP_si,P_max_epc,udc,udc_ref,idc,P_ref,dP_fsm,dP_pod,dP_epc,Pac_loc,Pac_poc,Pdc,P_min_epc,UVRT,iP_in_limit,block,uac_loc;1;xiP,xd,xi_limov,xi_limuv;1;Mode_P,poc,gradlim_Vref,gradlim_Pref,Kp_Vdc,Ki_Vdc,Kd_Vdc,Td_Vdc,Ctrl_P,Kp_P,Ki_P,gradlim_OutP,gradlim_OutVdc,Mode_Vdc_Droop,Dvdc,Didc,Mode_P_Droop,Dp,Mode_P_Droop_Db,Vdc_droop_max_db,Vdc_droop_min_db,Mode_DC_OV,Kp_lim,Ki_lim,Mode_DC_UV,Mode_P_Db,Mode_P_Db_epco,Mode_P_Db_epcu,Vdc_max_db,Vdc_min_db,Kp_vdc_db,SI_epc,Mode_Vadp,Vac_min;1;P_ref_sum_freeze,Kp,Ki,Kd,y_max,y_min,yx_max,yx_min,freeze_int,yp,yd,dxd,P_ref_VdcDroop,over_droop_db,under_droop_db,db_ctrl_over,db_ctrl_under,P,P_ref_ltd,P_ref_sum,P_ref_sum_epc,P_ref_sum_ltd,P_ref_sum_without_SI,Pdc_invert,dP_droop,dP_droop_ovuv,dP_overvolt,dP_ref,dP_si_enabled,dP_si_ff,dP_undervolt,delta,delta_P,delta_udc,droop_udc,freeze_lim,iref_db_droop,iref_db_droop_si,iref_out,iref_out_droop,iref_out_gradlim,mode_P,ref,udc_over,udc_ref_droop,udc_ref_droop_ltd,udc_ref_final,udc_ref_ltd,udc_under;241;Kp=select_const(mode_P,Kp_P,Kp_Vdc);Ki=select_const(mode_P,Ki_P,Ki_Vdc);Kd=select_const(mode_P,0.0,Kd_Vdc);yp=select(mode_P,selfix(Ctrl_P,ref,delta),delta);y_max=select(mode_P,min(P_max,P_max_epc)-iref_db_droop,iP_max_vdc);y_min=select(mode_P,max(P_min,P_min_epc)-iref_db_droop,-iP_max_vdc);yx_max=select(mode_P,P_max-iref_db_droop,iP_max_vdc);yx_min=select(mode_P,P_min-iref_db_droop,-iP_max_vdc);inc(Kp)=selfix_const(mode_P,Kp_P,Kp_Vdc);inc(Ki)=selfix_const(mode_P,Ki_P,Ki_Vdc);inc(Kd)=selfix_const(mode_P,0.0,Kd_Vdc);inc(y_max)=selfix(mode_P,P_max-iref_db_droop,iP_max_vdc);inc(y_min)=selfix(mode_P,P_min-iref_db_droop,-iP_max_vdc);inc(yx_max)=selfix(mode_P,P_max-iref_db_droop,iP_max_vdc);inc(yx_min)=selfix(mode_P,P_min-iref_db_droop,-iP_max_vdc);limfix(Td_Vdc)=(0,);dxd=select(mode_P,0.0,selfix({Td_Vdc>0.0}.and.{Kd_Vdc>0.0},(delta-xd)/selfix(Td_Vdc>0.0,Td_Vdc,1.0),0.0));xd.=dxd;yd=select(mode_P,0.0,dxd*Kd);inc(freeze_int)=selfix_const(block.or.UVRT,1,0);freeze_int=picdro_const(block.or.UVRT.or.{iP_in_limit.and.{{xiP>0.and.delta>0}.or.{xiP<0.and.delta<0}}},0.00001,0.01);xiP.=select(freeze_int,0.0,select({flipflop(lastvalue(xiP)+lim(Kp*yp,min(-y_max,y_min),max(-y_min,y_max))>y_max+0.000001,lastvalue(xiP)+lim(Kp*yp,min(-y_max,y_min),max(-y_min,y_max))<y_max).and.flipflop(delta>0.0,delta<0.0)}.or.{flipflop(lastvalue(xiP)+lim(Kp*yp,min(-y_max,y_min),max(-y_min,y_max))<y_min-0.000001,lastvalue(xiP)+lim(Kp*yp,min(-y_max,y_min),max(-y_min,y_max))>y_min).and.flipflop(delta<0.0,delta>0.0)},0.0,Ki*delta));iref_out=lim(limstate(xiP,yx_min-0.0000001,yx_max+0.0000001)+Kp*yp+yd,y_min,y_max);ref=select(mode_P,P_ref_sum_ltd,udc_ref_final);delta=select(mode_P,delta_P,delta_udc);P=selfix(poc>1.5,Pdc_invert,selfix(poc>0.5,Pac_poc,Pac_loc));P_ref_sum_ltd=select(EPC,lim(P_ref_sum_epc,min(max(P_ref_min,P_min_epc),min(P_ref_max,P_max_epc)),max(min(P_ref_max,P_max_epc),max(P_ref_min,P_min_epc))),lim_const(P_ref_sum_epc,P_ref_min,P_ref_max));dPmarge_SI_up=select(EPC,min(P_ref_max,P_max_epc),P_ref_max)-P_ref_sum_without_SI;dPmarge_SI_down=select(EPC,max(P_ref_min,P_min_epc),P_ref_min)-P_ref_sum_without_SI;udc_ref_droop_ltd=lim_const(udc_ref_droop,Vdc_min,Vdc_max);mode_P=select(STATCOM_on.or.trip_dc,0,select(EPC,1,mode_P_cmd));inc(mode_P_cmd)=selfix(Mode_P,1,0);iref_out_gradlim=select(mode_P,selfix(gradlim_OutP,gradlim_const(selfix(gradlim_OutP,iref_out,0),dOutP_min/100,dOutP_max/100),iref_out),selfix(gradlim_OutVdc,gradlim_const(selfix(gradlim_OutVdc,iref_out,0),dOutVdc_min/100,dOutVdc_max/100),iref_out));inc(db_ctrl_over)=selfix({mode_P.and.Mode_P_Db.and.{Vdc_max_db>Vdc_min_db}.and.{.not.{EPC.and.{.not.Mode_P_Db_epco}}}}.or.{EPC.and.Mode_P_Db_epco},max(0.0,udc-Vdc_max_db),0.0);inc(db_ctrl_under)=selfix({mode_P.and.Mode_P_Db.and.{Vdc_max_db>Vdc_min_db}.and.{.not.{EPC.and.{.not.Mode_P_Db_epcu}}}}.or.{EPC.and.Mode_P_Db_epcu},min(0.0,udc-Vdc_min_db),0.0);db_ctrl_over=select({mode_P.and.Mode_P_Db.and.{Vdc_max_db>Vdc_min_db}.and.{.not.{EPC.and.{.not.Mode_P_Db_epco}}}}.or.{EPC.and.Mode_P_Db_epco},max(0.0,udc-Vdc_max_db),0.0);db_ctrl_under=select({mode_P.and.Mode_P_Db.and.{Vdc_max_db>Vdc_min_db}.and.{.not.{EPC.and.{.not.Mode_P_Db_epcu}}}}.or.{EPC.and.Mode_P_Db_epcu},min(0.0,udc-Vdc_min_db),0.0);iref_db_droop=lim_const(select(mode_P.and.Mode_P_Db.and.{Vdc_max_db<=Vdc_min_db},(udc-Vdc_max_db)*Kp_vdc_db,(db_ctrl_over+db_ctrl_under)*Kp_vdc_db),P_min,P_max);over_droop_db=selfix(Mode_P_Droop.and.Mode_P_Droop_Db,picdro(selfix(Mode_P_Droop.and.Mode_P_Droop_Db,udc-Vdc_droop_max_db+0.5,0),0.0,0.0),0);under_droop_db=selfix(Mode_P_Droop.and.Mode_P_Droop_Db,picdro(selfix(Mode_P_Droop.and.Mode_P_Droop_Db,Vdc_droop_min_db-udc+0.5,0),0.0,0.0),0);dP_droop=selfix(Mode_P_Droop,selfix(Mode_P_Droop_Db,select(over_droop_db,(udc-Vdc_droop_max_db)*Dp,select(under_droop_db,(udc-Vdc_droop_min_db)*Dp,0.0)),(udc-udc_ref_ltd)*Dp),0.0);inc(over_droop_db)=selfix(Mode_P_Droop.and.Mode_P_Droop_Db,selfix_const(udc>Vdc_droop_max_db,1,0),0);inc(under_droop_db)=selfix(Mode_P_Droop.and.Mode_P_Droop_Db,selfix_const(udc<Vdc_droop_min_db,1,0),0);inc(dP_droop)=selfix(Mode_P_Droop,selfix(Mode_P_Droop_Db,selfix(over_droop_db,(udc-Vdc_droop_max_db)*Dp,selfix(under_droop_db,(udc-Vdc_droop_min_db)*Dp,0.0)),(udc-udc_ref_ltd)*Dp),0.0);xi_limov.=selfix(Mode_DC_OV,select(EPC.or.freeze_lim,0.0,Ki_lim*udc_over),0.0);dP_overvolt=selfix(Mode_DC_OV,lim_const(limstate_const(xi_limov,0.0,1.0)+Kp_lim*udc_over,0.0,1.0),0.0);xi_limuv.=selfix(Mode_DC_UV,select(EPC.or.freeze_lim,0.0,Ki_lim*udc_under),0.0);dP_undervolt=selfix(Mode_DC_UV,lim_const(limstate_const(xi_limuv,-1.0,0.0)+Kp_lim*udc_under,-1.0,0.0),0.0);P_ref_ltd=selfix(gradlim_Pref,gradlim_const(selfix(gradlim_Pref,P_ref,0),dP_ref_min/100,dP_ref_max/100),P_ref);Pdc_invert=-Pdc;iP_ref=select(block,0.0,lim(select(mode_P,iref_out_droop/selfix(Mode_Vadp,max(uac_loc,Vac_min),1.0),iref_out_droop),-iP_max,iP_max));dP_si_ff=select(mode_P,selfix(Ctrl_P,dP_si_enabled*(1.0-Kp_P),dP_si_enabled),dP_si_enabled);P_ref_sum_freeze=select(EPC,lastvalue(P_ref_sum_freeze),P_ref_sum);P_ref_sum_epc=select(DC_switch_open.or.trip_dc.or.STATCOM_on,0.0,select(EPC,P_ref_sum_freeze+dP_epc+dP_si_enabled,P_ref_sum+dP_si_enabled));P_ref_sum_without_SI=select(DC_switch_open.or.trip_dc.or.STATCOM_on,0.0,select(EPC,P_ref_sum_freeze+dP_epc,P_ref_sum));delta_P=-P+P_ref_sum_ltd;delta_udc=udc-udc_ref_final;udc_ref_droop=droop_udc+udc_ref_ltd;iref_out_droop=iref_out_gradlim+iref_db_droop_si;P_ref_sum=P_ref_ltd+dP_ref+dP_droop_ovuv;dP_ref=dP_pod+dP_fsm;iref_db_droop_si=iref_db_droop+dP_si_ff;dP_droop_ovuv=dP_droop+dP_overvolt+dP_undervolt;freeze_lim=UVRT+iP_in_limit+block;dP_si_enabled=selfix(SI_epc,dP_si,select(EPC,0.0,dP_si));inc(P_ref_VdcDroop)=P-dP_ref;droop_udc=select(DC_switch_open.or.trip_dc.or.STATCOM_on,0.0,selfix(Mode_Vdc_Droop>1.5,-Didc*idc,selfix(Mode_Vdc_Droop,Dvdc*(P-(P_ref_VdcDroop+dP_ref)),0.0)));udc_over=udc-Vdc_max;udc_under=udc-Vdc_min;udc_ref_ltd=selfix(gradlim_Vref,gradlim_const(selfix(gradlim_Vref,udc_ref,0),dVdc_ref_min/100,dVdc_ref_max/100),udc_ref);udc_ref_final=select(DC_switch_open.or.trip_dc,udc_ref_droop_ltd,select(STATCOM_on,0.0,udc_ref_droop_ltd));"vardef(Mode_P)=;'Control mode: 0 = Vdc, 1 = P'";"vardef(Mode_Vdc_Droop)=;'Vdc droop ctrl.: 0=off, 1=Vdc(P), 2=Vdc(idc)'";"vardef(Mode_P_Droop)=;'P droop ctrl., P(Vdc): 0 = off, 1 = on'";"vardef(Mode_P_Droop_Db)=;'P droop ctrl. deadband: 0=off; 1=on'";"vardef(Mode_DC_OV)=;'Vdc over-voltage limiter: 0 = off, 1 = on'";"vardef(Mode_DC_UV)=;'Vdc under-voltage limiter: 0 = off, 1 = on'";"vardef(Mode_P_Db)=;'Deadband control, P(Vdc_db): 0 = off, 1 = on'";"vardef(Mode_P_Db_epco)=;'Deadb. ctrl. DC overvolt. while EPC: 0/1'";"vardef(Mode_P_Db_epcu)=;'Deadb. ctrl. DC undervlt. while EPC: 0/1'";"vardef(SI_epc)=;'Allow synthetic inertia during EPC: 0 = no, 1 = yes'";"vardef(Mode_Vadp)=;'Adapt current ref. output to AC voltage: 0=no, 1=yes'";"vardef(poc)=;'P ctrl. at: 0 = local AC terminal, 1 = PoC, 2 = DC terminal'";"vardef(P_ref_min)='p.u.';'Minimum active power reference value'";"vardef(P_ref_max)='p.u.';'Maximum active power reference value'";"vardef(gradlim_Pref)=;'P reference gradient limiter: 0 = off, 1 = on'";"vardef(gradlim_Vref)=;'Vdc reference gradient limiter: 0 = off, 1 = on'";"vardef(dP_ref_min)='%/s';'Min. rate of change of power reference'";"vardef(dP_ref_max)='%/s';'Max. rate of change of power reference'";"vardef(dVdc_ref_min)='%/s';'Min. rate of change of Vdc reference'";"vardef(dVdc_ref_max)='%/s';'Max. rate of change of Vdc reference'";"vardef(Ctrl_P)=;'P ctrl. type: 0 = PI, 1 = I with prop. ref. feed-forward'";"vardef(Kp_Vdc)=;'DC voltage controller proportional gain'";"vardef(Ki_Vdc)=;'DC voltage controller integrator gain'";"vardef(Kd_Vdc)=;'DC voltage controller derivative gain'";"vardef(Td_Vdc)='s';'DC voltage controller derivate time constant'";"vardef(Kp_P)=;'Active power controller proportional gain'";"vardef(Ki_P)=;'Active power controller integrator gain'";"vardef(P_max)='p.u.';'Maximum active power (positive value)'";"vardef(P_min)='p.u.';'Minimum active power (negative value)'";"vardef(iP_max_vdc)='p.u.';'Max. steady active current (Vdc Ctrl.)'";"vardef(gradlim_OutP)=;'P ctrl. output gradient limiter: 0=off, 1=on'";"vardef(gradlim_OutVdc)=;'Vdc ctrl. output gradient limiter: 0=off, 1=on'";"vardef(dOutP_min)='%/s';'Min. rate of change of P ctrl. output'";"vardef(dOutP_max)='%/s';'Max. rate of change of P ctrl. output'";"vardef(dOutVdc_min)='%/s';'Min. rate of change of Vdc ctrl. output'";"vardef(dOutVdc_max)='%/s';'Max. rate of change of Vdc ctrl. output'";"vardef(Dvdc)='p.u./p.u.';'Gain for Vdc droop control, Vdc(P)'";"vardef(Didc)='p.u./p.u.';'Gain for Vdc droop control, Vdc(idc)'";"vardef(Dp)='p.u./p.u.';'Gain for P droop control, P(Vdc)'";"vardef(P_ref_VdcDroop)='p.u.';'P reference value for Vdc(P) droop'";"vardef(Vdc_droop_max_db)='p.u.';'Upper deadband P droop ctrl.'";"vardef(Vdc_droop_min_db)='p.u.';'Lower deadband P droop ctrl.'";"vardef(Vdc_max)='p.u.';'Maximum steady-state DC voltage'";"vardef(Vdc_min)='p.u.';'Minimum steady-state DC voltage'";"vardef(Kp_lim)=;'DC over/under-voltage limiter, proportional gain'";"vardef(Ki_lim)=;'DC over/under-voltage limiter, integrator gain'";"vardef(Vdc_max_db)='p.u.';'Upper Vdc threshold for deadband ctrl.'";"vardef(Vdc_min_db)='p.u.';'Lower Vdc threshold for deadband ctrl.'";"vardef(Kp_vdc_db)=;'Deadband control gain of Vdc'";"vardef(Vac_min)='p.u.';'Minimum steady-state operating voltage'";"vardef(iP_max)='p.u.';'Maximum active current (max. ref. output)'";"vardef(udc)='p.u.';'DC voltage (local measurement)'";"vardef(udc_ref)='p.u.';'DC voltage reference signal'";"vardef(udc_ref_ltd)='p.u.';'DC voltage reference signal (rate of change limited)'";"vardef(droop_udc)='p.u.';'Vdc(P) droop reference signal'";"vardef(Pac_loc)='p.u.';'AC power (local measurement)'";"vardef(Pac_poc)='p.u.';'AC power (measurement at PoC)'";"vardef(Pdc)='p.u.';'DC power (local measurement)'";"vardef(P)='p.u.';'Active power (selected measurement)'";"vardef(P_ref)='p.u.';'Active power reference signal'";"vardef(uac_loc)='p.u.';'AC voltage (local measurement)'";"vardef(mode_P_cmd)=;'Control mode (input signal): 0 = Vdc, 1 = P'";"vardef(UVRT)=;'Under-voltage ride through (0 = Inactive, 1 = Active)'";"vardef(block)=;'Blocking signal'";"vardef(DC_switch_open)=;'Status of DC switches: 0 = closed, 1 = open'";"vardef(trip_dc)=;'Trip signal DC connection'";"vardef(STATCOM_on)=;'STATCOM mode'";"vardef(iP_in_limit)=;'Flag iP in limitation'";"vardef(freeze_int)=;'Freeze integrator of PI controller'";"vardef(dP_fsm)='p.u.';'Additional active power by FSM'";"vardef(dP_pod)='p.u.';'Additional active power by POD'";"vardef(dP_si)='p.u.';'Additional active power by synthetic inertia'";"vardef(EPC)=;'Emergency Power Control flag'";"vardef(dP_epc)='p.u.';'Additional active power by EPC'";"vardef(P_max_epc)='p.u.';'Maximum active power limitation by EPC'";"vardef(P_min_epc)='p.u.';'Minimum active power limitation by EPC'";"vardef(iP_ref)='p.u.';'AC active current reference (pos. seq.)'";"vardef(dPmarge_SI_up)='p.u.';'Upper power margin for synthetic inertia'";"vardef(dPmarge_SI_down)='p.u.';'Lower power margin for synthetic inertia'";"vardef(dP_ref)='p.u.';'Additional active power reference by FSM and SI'";"vardef(P_ref_ltd)='p.u.';'Active power reference signal (rate of change limited)'";"vardef(P_ref_sum)='p.u.';'Active power reference with P(Vdc) droop, DC over-/undervoltage limitation, FSM and SI contributions'";"vardef(P_ref_sum_freeze)='p.u.';'Active power reference signal, frozen by EPC'";"vardef(P_ref_sum_epc)='p.u.';'Active power reference with P(Vdc) droop, DC over-/undervoltage limitation, FSM, SI and EPC contributions)'";"vardef(P_ref_sum_ltd)='p.u.';'Active power reference signal, limited to min/max values and EPC limits'";"vardef(dP_droop)='p.u.';'P(Vdc) droop reference signal'";"vardef(dP_overvolt)='p.u.';'Power reference change by DC overvoltage limiter'";"vardef(dP_undervolt)='p.u.';'Power reference change by DC undervoltage limiter'";"vardef(dP_droop_ovuv)='p.u.';'Power reference change because of P(Vdc) droop, DC over-/undervoltage limitation'";"vardef(droop_udc)='p.u.';'Vdc(P) droop reference signal'";"vardef(iref_db_droop)='p.u.';'Deadband control, additional active current'";limfix(Mode_P)=[0,1];limfix(poc)=[0,2];limfix(gradlim_Vref)=[0,1];limfix(gradlim_Pref)=[0,1];limfix(Kp_Vdc)=[0,);limfix(Ki_Vdc)=[0,);limfix(Kd_Vdc)=[0,);limfix(Td_Vdc)=(0,);limfix(Ctrl_P)=[0,1];limfix(Kp_P)=[0,);limfix(Ki_P)=[0,);limfix(Mode_Vdc_Droop)=[0,2];limfix(Mode_P_Droop)=[0,1];limfix(Dp)=[0,);limfix(Mode_P_Droop_Db)=[0,1];limfix(Vdc_droop_max_db)=[1,);limfix(Vdc_droop_min_db)=(,1];limfix(Vdc_droop_max_db)=(Vdc_droop_min_db,);limfix(Vdc_droop_min_db)=(,Vdc_droop_max_db);limfix(Mode_DC_OV)=[0,1];limfix(Kp_lim)=[0,);limfix(Ki_lim)=[0,);limfix(Mode_P_Db)=[0,1];limfix(Mode_P_Db_epco)=[0,1];limfix(Mode_P_Db_epcu)=[0,1];limfix(Vdc_max_db)=[Vdc_min_db,);limfix(Vdc_min_db)=(0,Vdc_max_db];limfix(Kp_vdc_db)=[0,);limfix(SI_epc)=[0,1];limfix(Mode_Vadp)=[0,1];limfix(Vac_min)=(0,1);limfix(dVdc_ref_max)=(0,);limfix(dP_ref_max)=(0,);limfix(P_ref_max)=[0,);limfix(P_ref_max)=(P_ref_min,);limfix(P_max)=[0,);limfix(P_max)=(P_min,);limfix(iP_max_vdc)=(0,iP_max);limfix(iP_max)=(iP_max_vdc,);limfix(Vdc_max)=[1,);limfix(Vdc_max)=(Vdc_min,);limfix(dVdc_ref_min)=(,0);limfix(dP_ref_min)=(,0);limfix(P_ref_min)=(,0];limfix(P_ref_min)=(,P_ref_max);limfix(P_min)=(,0];limfix(P_min)=(,P_max);limfix(Vdc_min)=(0,Vdc_max);limfix(gradlim_OutP)=[0,1];limfix(dOutP_min)=(,0);limfix(dOutP_max)=(0,);limfix(gradlim_OutVdc)=[0,1];limfix(dOutVdc_min)=(,0);limfix(dOutVdc_max)=(0,);outfix({Mode_DC_OV>0.5}.and.{udc>Vdc_max},'DC voltage is larger than maximum permissible steady-state DC voltage: udc=udc p.u. > Vdc_max=Vdc_max p.u. Controller will reduce power flow to meet the limit Vdc_max.');outfix({Mode_DC_UV>0.5}.and.{udc<Vdc_min},'DC voltage is lower than minimum permissible steady-state DC voltage: udc=udc p.u. < Vdc_min=Vdc_min p.u. Controller will reduce power flow to meet the limit Vdc_min.');inc(udc_ref)=udc+selfix(Mode_Vdc_Droop>1.5,Didc*idc,0.0);inc(P_ref)=P-dP_droop-dP_fsm-dP_pod;inc(xiP)=selfix(Mode_P,selfix(Ctrl_P,iP_ref*selfix(Mode_Vadp,max(uac_loc,Vac_min),1.0)-dP_si-iref_db_droop-Kp_P*P,iP_ref*selfix(Mode_Vadp,max(uac_loc,Vac_min),1.0)-dP_si-iref_db_droop),iP_ref-dP_si);inc(xd)=0.0;inc(xi_limov)=0.0;inc(xi_limuv)=0.0;inc0(UVRT)=0;inc0(block)=0;inc0(trip_dc)=0;inc0(STATCOM_on)=0;inc0(DC_switch_open)=0;inc0(iP_in_limit)=0;inc0(dP_fsm)=0.0;inc0(dP_pod)=0.0;inc(dP_si)=0.0;inc(EPC)=0;inc(dP_epc)=0.0;inc(P_max_epc)=max(P_max,P_ref_max);inc(P_min_epc)=min(P_min,P_ref_min);inc(P_ref_sum_without_SI)=selfix(DC_switch_open.or.trip_dc.or.STATCOM_on,0.0,P_ref_sum);inc(dPmarge_SI_up)=P_ref_max-P_ref_sum_without_SI;inc(dPmarge_SI_down)=P_ref_min-P_ref_sum_without_SI;inc0(iP_ref)=0;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;0;;0;;iP_ref,dPmarge_SI_up,dPmarge_SI_down;mode_P_cmd,DC_switch_open,trip_dc,STATCOM_on,EPC,dP_si,P_max_epc,udc,udc_ref,idc,P_ref,dP_fsm,dP_pod,dP_epc,Pac_loc,Pac_poc,Pdc,P_min_epc,UVRT,iP_in_limit,block,uac_loc;xiP,xd,xi_limov,xi_limuv;Mode_P,poc,gradlim_Vref,gradlim_Pref,Kp_Vdc,Ki_Vdc,Kd_Vdc,Td_Vdc,Ctrl_P,Kp_P,Ki_P,gradlim_OutP,gradlim_OutVdc,Mode_Vdc_Droop,Dvdc,Didc,Mode_P_Droop,Dp,Mode_P_Droop_Db,Vdc_droop_max_db,Vdc_droop_min_db,Mode_DC_OV,Kp_lim,Ki_lim,Mode_DC_UV,Mode_P_Db,Mode_P_Db_epco,Mode_P_Db_epcu,Vdc_max_db,Vdc_min_db,Kp_vdc_db,SI_epc,Mode_Vadp,Vac_min;P_ref_sum_freeze,Kp,Ki,Kd,y_max,y_min,yx_max,yx_min,freeze_int,yp,yd,dxd,P_ref_VdcDroop,over_droop_db,under_droop_db,db_ctrl_over,db_ctrl_under,P,P_ref_ltd,P_ref_sum,P_ref_sum_epc,P_ref_sum_ltd,P_ref_sum_without_SI,Pdc_invert,dP_droop,dP_droop_ovuv,dP_overvolt,dP_ref,dP_si_enabled,dP_si_ff,dP_undervolt,delta,delta_P,delta_udc,droop_udc,freeze_lim,iref_db_droop,iref_db_droop_si,iref_out,iref_out_droop,iref_out_gradlim,mode_P,ref,udc_over,udc_ref_droop,udc_ref_droop_ltd,udc_ref_final,udc_ref_ltd,udc_under
  9;C;Protection ACDC (Pos Seq) BlkDef;286;0;6;0;;0;;0;;0;;1;block,trip,trip_ac,trip_dc,DC_switch_open,STATCOM_on,soft;1;idc,uac1,udc_p,udc_n,f,block_remote,trip_remote,block_manually,trip_ac_manually,trip_dc_manually,DC_switch1_closed,DC_switch2_closed;1;xf;1;Topo,AutoInput,BRK_ac_ac,BRK_ac_dc,BRK_ac_dc2,BRK_number,BRK_delay_ac,BRK_dc_ac,BRK_dc_dc,BRK_delay_dc,soft_deblock,Idc_max,Idc_rated,Block_MMC_delay1,Trip_idc,Trip_idc_delay,udc_min1,udc_min2,udc_max1,udc_max2,Block_MMC_delay2uv1,Block_MMC_delay2uv2,Block_MMC_delay2ov1,Block_MMC_delay2ov2,Deblock_MMC_delay_dc,Trip_udcmin1,Trip_udcmin1_delay,Trip_udcmin2,Trip_udcmax1,Trip_udcmax1_delay,Trip_udcmax2,STCM_st1,STCM_st2,STCM_delay,Mode_AWE,delay_AWE,soft_AWE,uac_min1,uac_min2,uac_max,Block_MMC_delay3uv1,Block_MMC_delay3uv2,Block_MMC_delay3ov,Deblock_MMC_delay3,Trip_uacmin1,Trip_uacmin2,Trip_uacmax,f_min,f_max,df_min,df_max,Block_MMC_delay4,Deblock_MMC_delay4,Trip_f,Remote_block,Remote_trip_ac,Remote_trip_dc,Op_Ranges,udc_op_min,udc_op_max,uac_op_min,uac_op_max,f_op_min,f_op_max,df_op_min,df_op_max,Tf;1;udc,udc_abs,block_DC_overcurrent,detect_DC_undervoltage1,detect_DC_undervoltage2,block_DC_undervoltage1,block_DC_undervoltage2,detect_DC_overvoltage1,block_DC_overvoltage1,block_DC_overvoltage2,AWE,block_AC_undervoltage1,block_AC_undervoltage2,block_AC_overvoltage,block_underfrequency,block_overfrequency,block_rocof,block_self,df;353;"vardef(Topo)      =       ;'DC pole topology: 0 = symmetric, 1 = asymmetric'";"vardef(AutoInput) =       ;'Automated input: 0=no, 1=yes (Topo, Idc_rated)'";"vardef(Idc_max)   = 'kA'  ;'Maximum DC current'";"vardef(Idc_rated) = 'kA'  ;'Rated DC current Idcr = Sr/Vdcr'";"vardef(udc_min1)  = 'p.u.';'Minimum DC voltage, stage 1'";"vardef(udc_min2)  = 'p.u.';'Minimum DC voltage, stage 2'";"vardef(udc_max1)  = 'p.u.';'Maximum DC voltage, stage 1'";"vardef(udc_max2)  = 'p.u.';'Maximum DC voltage, stage 2'";"vardef(uac_min1)  = 'p.u.';'Minimum AC voltage, stage 1'";"vardef(uac_min2)  = 'p.u.';'Minimum AC voltage, stage 2'";"vardef(uac_max)   = 'p.u.';'Maximum AC voltage'";"vardef(f_min)     = 'Hz'  ;'Minimum frequency'";"vardef(f_max)     = 'Hz'  ;'Maximum frequency'";"vardef(df_min)    = 'Hz/s';'Min. rate of change of frequency (ROCOF)'";"vardef(df_max)    = 'Hz/s';'Max. rate of change of frequency (ROCOF)'";;"vardef(BRK_ac_ac)    = ;'Open AC breakers if AC fault: 0 = no, 1 = yes'";"vardef(BRK_ac_dc)    = ;'Open AC breakers if DC fault: 0 = no, 1 = yes'";"vardef(BRK_ac_dc2)   = ;'Open AC breakers if DC fault, stage 2: 0=no, 1=yes'";"vardef(BRK_number)   = ;'Number of AC circuit breakers to open'";"vardef(BRK_delay_ac) = 's';'Delay for opening AC circuit breakers'";"vardef(BRK_dc_ac)    = ;'Open DC breakers if AC fault: 0 = no, 1 = yes'";"vardef(BRK_dc_dc)    = ;'Open DC breakers if DC fault: 0 = no, 1 = yes'";"vardef(BRK_delay_dc) = 's';'Delay for opening DC circuit breakers'";;"vardef(soft_deblock)         =    ;'Soft restart when deblocking: 0 = no, 1 = yes'";"vardef(Block_MMC_delay1)     = 's';'Delay blocking DC overcurrent'";"vardef(Block_MMC_delay2uv1)  = 's';'Delay blocking DC undervlt.st.1' ";"vardef(Block_MMC_delay2uv2)  = 's';'Delay blocking DC undervlt.st.2' ";"vardef(Block_MMC_delay2ov1)  = 's';'Delay blocking DC overvolt.st.1' ";"vardef(Block_MMC_delay2ov2)  = 's';'Delay blocking DC overvolt.st.2' ";"vardef(Block_MMC_delay3uv1)  = 's';'Delay blocking AC undervlt.st.1'";"vardef(Block_MMC_delay3uv2)  = 's';'Delay blocking AC undervlt.st.2'";"vardef(Block_MMC_delay3ov)   = 's';'Delay blocking AC overvoltage'";"vardef(Block_MMC_delay4)     = 's';'Delay blocking (frequency)'";"!vardef(Deblock_MMC_delay1)   = 's';'Delay deblocking (DC overcur.)'";"!vardef(Deblock_MMC_delay2)   = 's';'Delay deblocking (DC voltage)'";"vardef(Deblock_MMC_delay_dc) = 's';'Delay deblocking (DC faults)'";"vardef(Deblock_MMC_delay3)   = 's';'Delay deblocking (AC voltage)'";"vardef(Deblock_MMC_delay4)   = 's';'Delay deblocking (frequency)'";"vardef(Trip_idc_delay)       = 's';'Additional trip delay - DC overcurrent'";"vardef(Trip_udcmin1_delay)   = 's';'Add. trip delay - DC undervlt. stg.1'";"vardef(Trip_udcmax1_delay)   = 's';'Add. trip delay - DC overvlt. stg.1'";"vardef(STCM_delay)           = 's';'Delay for starting STATCOM mode'";"vardef(STCM_st1)       = ;'Start STATCOM in DC fault stage 1: 0=no, 1=yes'";"vardef(STCM_st2)       = ;'Disable DC undervolt.stage 2 in STATCOM mode: 0=no, 1=yes'";"vardef(Mode_AWE)       = ;'Automatic DC re-energisation: 0 = no, 1 = yes'";"vardef(delay_AWE)      = 's';'Time delay for automat. DC re-energisation'";"vardef(soft_AWE)       = ;'Soft restart when DC re-energisation: 0=no, 1=yes'";"vardef(Trip_idc)       = ;'Switch off - DC overcurrent: 0 = no, 1 = yes'";"vardef(Trip_udcmin1)   = ;'Switch off DC undervlt., stage1: 0=no, 1=yes'";"vardef(Trip_udcmin2)   = ;'Switch off DC undervlt., stage2: 0=no, 1=yes'";"vardef(Trip_udcmax1)   = ;'Switch off - DC overvlt. stage1: 0=no, 1=yes'";"vardef(Trip_udcmax2)   = ;'Switch off - DC overvlt. stage2: 0=no, 1=yes'";"vardef(Trip_uacmin1)   = ;'Switch off AC undervlt., stage1: 0=no, 1=yes'";"vardef(Trip_uacmin2)   = ;'Switch off AC undervlt., stage2: 0=no, 1=yes'";"vardef(Trip_uacmax)    = ;'Switch off - AC overvoltage: 0 = no, 1 = yes'";"vardef(Trip_f)         = ;'Switch off - frequency events: 0 = no, 1 = yes'";"vardef(Remote_block)   = ;'Allow blocking from remote: 0=no, 1=yes'";"vardef(Remote_trip_ac) = ;'Allow trip AC from remote: 0 = no, 1 = yes'";"vardef(Remote_trip_dc) = ;'Allow trip DC from remote: 0 = no, 1 = yes'";;"vardef(Op_Ranges)   = ;'Scan normal operating ranges: 0 = no, 1 = yes'";"vardef(udc_op_min)  = 'p.u.';'Minimum normal operating DC voltage'";"vardef(udc_op_max)  = 'p.u.';'Maximum normal operating DC volt.'";"vardef(uac_op_min)  = 'p.u.';'Minimum normal operating AC voltage'";"vardef(uac_op_max)  = 'p.u.';'Maximum normal operating AC voltage'";"vardef(f_op_min)    = 'Hz';'Minimum normal operating frequency'";"vardef(f_op_max)    = 'Hz';'Maximum normal operating frequency'";"vardef(df_op_min)   = 'Hz/s';'Minimum normal operating ROCOF'";"vardef(df_op_max)   = 'Hz/s';'Maximum normal operating ROCOF'";"vardef(Tf)          = 's' ;'Time constant for frequency derivative'";;"vardef(idc)     = 'p.u.';'DC current'";"vardef(uac1)    = 'p.u.';'AC voltage, magnitude, positive sequence'";"vardef(udc_p)   = 'p.u.';'DC voltage positive'";"vardef(udc_n)   = 'p.u.';'DC voltage negative'";"vardef(udc)     = 'p.u.';'DC voltage'";"vardef(udc_abs) = 'p.u.';'DC voltage, absolute value'";"vardef(f)       = 'Hz'  ;'Frequency'";"vardef(DC_switch1_closed) = ;'Status of DC switch 1: 0 = open, 1 = closed'";"vardef(DC_switch2_closed) = ;'Status of DC switch 2: 0 = open, 1 = closed'";;"vardef(block)                   = ;'Blocking signal'";"vardef(block_DC_overcurrent)    = ;'Blocking signal DC overcurrent'";"vardef(detect_DC_undervoltage1) = ;'Detection signal DC undervoltage, stage 1'";"vardef(block_DC_undervoltage1)  = ;'Blocking signal DC undervoltage, stage 1'";"vardef(block_DC_undervoltage2)  = ;'Blocking signal DC undervoltage, stage 2'";"vardef(detect_DC_overvoltage1)  = ;'Detection signal DC overvoltage, stage 1'";"vardef(block_DC_overvoltage1)   = ;'Blocking signal DC overvoltage, stage 1'";"vardef(block_DC_overvoltage2)   = ;'Blocking signal DC overvoltage, stage 2'";"vardef(block_AC_undervoltage1)  = ;'Blocking signal AC undervoltage, stage 1'";"vardef(block_AC_undervoltage2)  = ;'Blocking signal AC undervoltage, stage 2'";"vardef(block_AC_overvoltage)    = ;'Blocking signal AC overvoltage'";"vardef(block_underfrequency)    = ;'Blocking signal underfrequency'";"vardef(block_overfrequency)     = ;'Blocking signal overfrequency'";"vardef(block_rocof)             = ;'Blocking signal ROCOF'";"vardef(block_self)              = ;'Blocking by unit protection functions'";"vardef(block_remote)            = ;'Blocking signal from remote side'";"vardef(block_manually)          = ;'Manually blocking command'";"vardef(trip)                    = ;'Trip signal'";"vardef(trip_ac)                 = ;'Trip signal AC connection'";"vardef(trip_dc)                 = ;'Trip signal DC connection'";"vardef(trip_remote)             = ;'Trip signal from remote side'";"vardef(trip_ac_manually)        = ;'Manually trip command AC connection'";"vardef(trip_dc_manually)        = ;'Manually trip command DC connection'";"vardef(DC_switch_open)          = ;'Status of DC switches: 0 = closed, 1 = open'";"vardef(STATCOM_on)              = ;'STATCOM mode: 0 = off, 1 = on'";"vardef(soft)                    = ;'Soft start trigger signal'";;"vardef(df) = 'Hz/s';'Derivative of frequency'";"vardef(xf) = 'Hz';'Frequency (state variable)'";;;limfix(Topo)                 = [0,1]           ! 0 <= Topo <= 1;limfix(AutoInput)            = [0,1]           ! 0 <= AutoInput <= 1;limfix(Idc_max)              = (Idc_rated,)    ! Idc_max > Idc_rated;limfix(Idc_rated)            = (0,)            ! Idc_rated > 0;limfix(BRK_ac_ac)            = [0,1]           ! 0 <= BRK_ac_ac <= 1;limfix(BRK_ac_dc)            = [0,1]           ! 0 <= BRK_ac_dc <= 1;limfix(BRK_ac_dc2)           = [0,1]           ! 0 <= BRK_ac_dc2 <= 1;limfix(BRK_number)           = [0,8]           ! 0 <= BRK_number <= 8;limfix(BRK_delay_ac)         = [0,)            ! BRK_delay_ac >= 0;limfix(BRK_dc_ac)            = [0,1]           ! 0 <= BRK_dc_ac <= 1;limfix(BRK_dc_dc)            = [0,1]           ! 0 <= BRK_dc_dc <= 1;limfix(BRK_delay_dc)         = [0,)            ! BRK_delay_dc >= 0;limfix(udc_min1)             = [0,1)           ! 0 <= udc_min1 < 1;limfix(udc_min1)             = [0,udc_max1)    ! 0 <= udc_min1 < udc_max1;limfix(udc_min1)             = [0,udc_max2)    ! 0 <= udc_min1 < udc_max2;limfix(udc_min2)             = (0,1)           ! 0 < udc_min2 < 1;limfix(udc_min2)             = (0,udc_max1)    ! 0 < udc_min2 < udc_max1;limfix(udc_min2)             = (0,udc_max2)    ! 0 < udc_min2 < udc_max2;limfix(udc_max1)             = (1,)            ! udc_max1 > 1;limfix(udc_max1)             = (udc_min1,)     ! udc_max1 > udc_min1;limfix(udc_max1)             = (udc_min2,)     ! udc_max1 > udc_min2;limfix(udc_max2)             = (1,)            ! udc_max2 > 1;limfix(udc_max2)             = (udc_min1,)     ! udc_max2 > udc_min1;limfix(udc_max2)             = (udc_min2,)     ! udc_max2 > udc_min2;limfix(uac_min1)             = [0,1)           ! 0 <= uac_min1 < 1.0;limfix(uac_min2)             = (0,1)           ! 0 < uac_min2 < 1.0;limfix(uac_max)              = (1,)            ! uac_max > 1.0;limfix(f_min)                = (0,f_max)       ! 0 < f_min < f_max;limfix(f_max)                = (f_min,)        ! f_max > f_min;limfix(df_min)               = (,0)            ! df_min < 0;limfix(df_max)               = (0,)            ! df_min > 0;limfix(soft_deblock)         = [0,1]           ! 0 <= soft_deblock <= 1;limfix(Block_MMC_delay1)     = [0,)            ! Block_MMC_delay1 >= 0;!limfix(Deblock_MMC_delay1)   = (0,)            ! Deblock_MMC_delay1 > 0;limfix(Block_MMC_delay2uv1)  = [0,)            ! Block_MMC_delay2uv1 >= 0;limfix(Block_MMC_delay2uv2)  = [0,)            ! Block_MMC_delay2uv2 >= 0;limfix(Block_MMC_delay2ov1)  = [0,)            ! Block_MMC_delay2ov1 >= 0;limfix(Block_MMC_delay2ov2)  = [0,)            ! Block_MMC_delay2ov2 >= 0;!limfix(Deblock_MMC_delay2)   = (0,)            ! Deblock_MMC_delay2 > 0;limfix(Deblock_MMC_delay_dc) = (0,)            ! Deblock_MMC_delay_dc > 0;limfix(Block_MMC_delay3uv1)  = (0,)            ! Block_MMC_delay3uv1 > 0;limfix(Block_MMC_delay3uv2)  = (0,)            ! Block_MMC_delay3uv2 > 0;limfix(Block_MMC_delay3ov)   = (0,)            ! Block_MMC_delay3ov > 0;limfix(Deblock_MMC_delay3)   = (0,)            ! Deblock_MMC_delay3 > 0;limfix(Block_MMC_delay4)     = (0,)            ! Block_MMC_delay4 > 0;limfix(Deblock_MMC_delay4)   = (0,)            ! Deblock_MMC_delay4 > 0;limfix(Trip_idc)             = [0,1]           ! 0 <= Trip_idc <= 1;limfix(Trip_udcmin1)         = [0,1]           ! 0 <= Trip_udcmin1 <= 1;limfix(Trip_udcmin2)         = [0,1]           ! 0 <= Trip_udcmin2 <= 1;limfix(Trip_udcmax1)         = [0,1]           ! 0 <= Trip_udcmax1 <= 1;limfix(Trip_udcmax2)         = [0,1]           ! 0 <= Trip_udcmax2 <= 1;limfix(Trip_idc_delay)       = [0,1]           ! 0 <= Trip_idc_delay <= 1;limfix(Trip_udcmin1_delay)   = [0,1]           ! 0 <= Trip_udcmin1_delay <= 1;limfix(Trip_udcmax1_delay)   = [0,1]           ! 0 <= Trip_udcmax1_delay <= 1;limfix(STCM_st1)             = [0,1]           ! 0 <= STCM_st1 <= 1;limfix(STCM_st2)             = [0,1]           ! 0 <= STCM_st2 <= 1;limfix(STCM_delay)           = (0,)            ! STCM_delay > 0;limfix(STCM_delay)           = (BRK_dc_dc*BRK_delay_dc,) ! STCM_delay > BRK_delay_dc;limfix(Mode_AWE)             = [0,1]           ! 0 <= Mode_AWE <= 1;limfix(delay_AWE)            = (0,)            ! delay_AWE > 0;limfix(soft_AWE)             = [0,1]           ! 0 <= soft_AWE <= 1;limfix(Trip_uacmin1)         = [0,1]           ! 0 <= Trip_uacmin1 <= 1;limfix(Trip_uacmin2)         = [0,1]           ! 0 <= Trip_uacmin2 <= 1;limfix(Trip_uacmax)          = [0,1]           ! 0 <= Trip_uacmax <= 1;limfix(Trip_f)               = [0,1]           ! 0 <= Trip_f <= 1;limfix(Remote_block)         = [0,1]           ! 0 <= Remote_block <= 1;limfix(Remote_trip_ac)       = [0,1]           ! 0 <= Remote_trip_ac <= 1;limfix(Remote_trip_dc)       = [0,1]           ! 0 <= Remote_trip_dc <= 1;;limfix(Op_Ranges)   = [0,1]              ! 0 <= Op_Ranges <= 1;limfix(udc_op_min)  = (0,1)              ! 0 < udc_op_min < 1;limfix(udc_op_max)  = (1,)               ! udc_op_max > 1;limfix(uac_op_min)  = (0,1)              ! 0 < uac_op_min < 1;limfix(uac_op_max)  = (1,)               ! uac_op_max > 1;limfix(f_op_min)    = [f_min,f_op_max)   ! f_min <= f_op_min < f_op_max;limfix(f_op_max)    = (f_op_min,f_max]   ! f_op_min < f_op_max <= f_max;limfix(df_op_min)   = (,0)               ! df_op_min < 0;limfix(df_op_max)   = (0,)               ! df_op_min > 0;limfix(Tf)          = (0,)               ! Tf > 0;;;inc0(uac1)  = 0.0;inc0(idc)   = 1.0;inc0(udc_p) = 1.0;inc0(udc_n) = selfix(Topo, 0.0, -1.0);;inc0(DC_switch1_closed) = 1;inc0(DC_switch2_closed) = 1;;inc(DC_switch_open)            = {.not.DC_switch1_closed}.or.{.not.DC_switch2_closed};inc(STATCOM_on)                = DC_switch_open;inc(detect_DC_undervoltage1)   = 0;inc(detect_DC_undervoltage2)   = 0;inc(detect_DC_overvoltage1)    = 0;inc(block)                     = 0;inc(block_DC_overcurrent)      = 0;inc(block_DC_undervoltage1)    = 0;inc(block_DC_undervoltage2)    = 0;inc(block_DC_overvoltage1)     = 0;inc(block_DC_overvoltage2)     = 0;inc(block_AC_undervoltage1)    = 0;inc(block_AC_undervoltage2)    = 0;inc(block_AC_overvoltage)      = 0;inc(block_underfrequency)      = 0;inc(block_overfrequency)       = 0;inc(block_rocof)               = 0;inc(block_remote)              = 0;inc(block_manually)            = 0;inc(trip)                      = 0;inc(trip_ac)                   = 0;inc(trip_dc)                   = 0;inc(trip_remote)               = 0;inc(trip_ac_manually)          = 0;inc(trip_dc_manually)          = 0;inc(soft)                      = 0;;;udc = selfix(Topo, udc_p - udc_n, (udc_p - udc_n)/2);udc_abs = abs(udc);;!Rate of change of frequency (ROCOF);df  = selfix(Op_Ranges .and. {Tf>0}, (f-xf)/Tf, 0);xf. = df;inc(xf) = f;;detect_DC_undervoltage1 = picdro_const((udc_min1-udc)+0.5,Block_MMC_delay2uv1,Deblock_MMC_delay_dc);detect_DC_undervoltage2 = picdro_const((udc_min2-udc)+0.5,Block_MMC_delay2uv2,Deblock_MMC_delay_dc);detect_DC_overvoltage1  = picdro_const((max(udc_abs,abs(udc_p),abs(udc_n))-udc_max1)+0.5,Block_MMC_delay2ov1,Deblock_MMC_delay_dc);DC_switch_open = {.not.DC_switch1_closed}.or.{.not.DC_switch2_closed};STATCOM_on = DC_switch_open .or.;&            flipflop(STCM_st1.and.picdro_const((udc_min1-udc)+0.5,Block_MMC_delay2uv1+STCM_delay,0.0).and.{.not.AWE}, AWE) .or.;&            flipflop(STCM_st1.and.picdro_const((max(udc_abs,abs(udc_p),abs(udc_n))-udc_max1)+0.5,Block_MMC_delay2ov1+STCM_delay,0.0).and.{.not.AWE}, AWE);AWE = picdro_const(Mode_AWE.and.STATCOM_on, delay_AWE, 0.1);;soft = selfix(soft_AWE, AWE, 0).or.selfix(soft_deblock, {.not.block}.and.{lastvalue(block).or.lastvalue(lastvalue(block))}, 0);;block_DC_overcurrent   = picdro_const((abs(idc)-(Idc_max/Idc_rated))+0.5,Block_MMC_delay1,Deblock_MMC_delay_dc);block_DC_undervoltage1 = flipflop(detect_DC_undervoltage1.and.{.not.STATCOM_on}, {.not.detect_DC_undervoltage1}.or.picdro_const(STATCOM_on,Deblock_MMC_delay_dc,Deblock_MMC_delay_dc));block_DC_undervoltage2 = flipflop(detect_DC_undervoltage2.and.{.not.{STCM_st2.and.STATCOM_on}}, {.not.detect_DC_undervoltage2}.or.picdro_const(STCM_st2.and.STATCOM_on,Deblock_MMC_delay_dc,Deblock_MMC_delay_dc));block_DC_overvoltage1  = flipflop(detect_DC_overvoltage1.and.{.not.STATCOM_on}, {.not.detect_DC_overvoltage1}.or.picdro_const(STATCOM_on,Deblock_MMC_delay_dc,Deblock_MMC_delay_dc));block_DC_overvoltage2  = picdro_const((max(udc_abs,abs(udc_p),abs(udc_n))-udc_max2)+0.5,Block_MMC_delay2ov2,Deblock_MMC_delay_dc);block_AC_undervoltage1 = picdro_const((uac_min1-abs(uac1))+0.5,Block_MMC_delay3uv1,Deblock_MMC_delay3);block_AC_undervoltage2 = picdro_const((uac_min2-abs(uac1))+0.5,Block_MMC_delay3uv2,Deblock_MMC_delay3);block_AC_overvoltage   = picdro_const((abs(uac1)-uac_max)+0.5,Block_MMC_delay3ov,Deblock_MMC_delay3);block_overfrequency    = picdro_const((f-f_max)+0.5,Block_MMC_delay4,Deblock_MMC_delay4);block_underfrequency   = picdro_const((f_min-f)+0.5,Block_MMC_delay4,Deblock_MMC_delay4);block_rocof            = picdro_const((df-df_max)+0.5,Block_MMC_delay4,Deblock_MMC_delay4).or.picdro_const((df_min-df)+0.5,Block_MMC_delay4,Deblock_MMC_delay4);;block_self = block_DC_overcurrent .or.;&            block_DC_undervoltage1 .or. block_DC_undervoltage2 .or. ;&            block_DC_overvoltage1  .or. block_DC_overvoltage2  .or.;&            block_AC_undervoltage1 .or. block_AC_undervoltage2 .or.;&            block_AC_overvoltage .or. ;&            block_underfrequency .or. block_overfrequency .or. block_rocof;;block = block_self .or. block_manually .or. trip_ac_manually .or. {block_self=lastvalue(block_self).and.block_manually=lastvalue(block_manually).and.selfix(Remote_block,block_remote,0)} .or. selfix(Remote_trip_ac,trip_remote,0) .or. lastvalue(trip_ac);;output(block_DC_overcurrent.and.{.not.lastvalue(trip)},  'Converter blocked because of too high DC current (Idc > Idc_max=Idc_max kA).');output(block_DC_undervoltage1.and.{.not.lastvalue(trip)}, 'Converter blocked because of too low DC voltage, stage 1 (udc < udc_min1=udc_min1 p.u.).');output(block_DC_undervoltage2.and.{.not.lastvalue(trip)}, 'Converter blocked because of too low DC voltage, stage 2 (udc < udc_min2=udc_min2 p.u.).');output(block_DC_overvoltage1.and.{.not.lastvalue(trip)},  'Converter blocked because of too high DC voltage, stage 1 (udc > udc_max1=udc_max1 p.u.).');output(block_DC_overvoltage2.and.{.not.lastvalue(trip)},  'Converter blocked because of too high DC voltage, stage 2 (udc > udc_max2=udc_max2 p.u.).');output(block_AC_undervoltage1.and.{.not.lastvalue(trip)}, 'Converter blocked because of too low AC voltage, stage 1.')  ;output(block_AC_undervoltage2.and.{.not.lastvalue(trip)}, 'Converter blocked because of too low AC voltage, stage 2.')  ;output(block_AC_overvoltage.and.{.not.lastvalue(trip)},  'Converter blocked because of too high AC voltage.')  ;output(block_underfrequency.and.{.not.lastvalue(trip)},  'Converter blocked because of too low frequency (f < f_min=f_min Hz).');output(block_overfrequency.and.{.not.lastvalue(trip)},   'Converter blocked because of too high frequency (f > f_max=f_max Hz).');output(block_rocof.and.{.not.lastvalue(trip)},           'Converter blocked because of too steep rate of change of frequency (ROCOF).');output(selfix(Remote_block,block_remote,0).and.{.not.block_self}.and.{.not.block_manually}.and.{.not.lastvalue(block)},'Converter blocked from remote side.');output(selfix(Remote_trip_ac,lastvalue(trip_remote),0).and.{.not.lastvalue(trip)},'Converter blocked because of remote trip.');output(block_manually.and.{.not.lastvalue(block)},'Converter blocked manually.');output(block_manually.and.lastvalue(block),'Manually blocking command ignored, because converter is blocked already.');output(block,'Converter blocked.');output(STATCOM_on.and.{.not.block},'Converter in STATCOM mode.');;trip_ac = flipflop({BRK_ac_dc .and. {;&                    {Trip_idc.and.selfix(Trip_idc_delay>0,picdro_const(selfix(Trip_idc_delay>0,block_DC_overcurrent-0.4999,0),selfix(Trip_idc_delay>0,Trip_idc_delay,1.0),1.0),block_DC_overcurrent)} .or. ;&                    {Trip_udcmin1.and.selfix(Trip_udcmin1_delay>0,picdro_const(selfix(Trip_udcmin1_delay>0,block_DC_undervoltage1-0.4999,0),selfix(Trip_udcmin1_delay>0,Trip_udcmin1_delay,1.0),1.0),block_DC_undervoltage1)} .or. {Trip_udcmin2.and.block_DC_undervoltage2} .or.;&                    {Trip_udcmax1.and.selfix(Trip_udcmax1_delay>0,picdro_const(selfix(Trip_udcmax1_delay>0,block_DC_overvoltage1-0.4999,0),selfix(Trip_udcmax1_delay>0,Trip_udcmax1_delay,1.0),1.0),block_DC_overvoltage1)}  .or. {Trip_udcmax2.and.block_DC_overvoltage2};&                  }} .or. ;&                  {BRK_ac_dc2 .and. {;&                    {Trip_udcmin2.and.block_DC_undervoltage2} .or.;&                    {Trip_udcmax2.and.block_DC_overvoltage2};&                  }} .or.;&                  {BRK_ac_ac .and. {;&                    {Trip_uacmin1.and.block_AC_undervoltage1} .or. ;&                    {Trip_uacmin2.and.block_AC_undervoltage2} .or. ;&                    {Trip_uacmax.and.block_AC_overvoltage} .or.;&                    {Trip_f.and.{block_underfrequency.or.block_overfrequency.or.block_rocof}};&                  }} .or. ;&                  trip_ac_manually .or. selfix(Remote_trip_ac,lastvalue(trip_remote),0), 0);;trip_dc = flipflop({BRK_dc_dc .and. {;&                    {Trip_idc.and.selfix(Trip_idc_delay>0,picdro_const(selfix(Trip_idc_delay>0,block_DC_overcurrent-0.4999,0),selfix(Trip_idc_delay>0,Trip_idc_delay,1.0),1.0),block_DC_overcurrent)} .or. ;&                    {Trip_udcmin1.and.selfix(Trip_udcmin1_delay>0,picdro_const(selfix(Trip_udcmin1_delay>0,block_DC_undervoltage1-0.4999,0),selfix(Trip_udcmin1_delay>0,Trip_udcmin1_delay,1.0),1.0),block_DC_undervoltage1)} .or. {Trip_udcmin2.and.block_DC_undervoltage2} .or. ;&                    {Trip_udcmax1.and.selfix(Trip_udcmax1_delay>0,picdro_const(selfix(Trip_udcmax1_delay>0,block_DC_overvoltage1-0.4999,0),selfix(Trip_udcmax1_delay>0,Trip_udcmax1_delay,1.0),1.0),block_DC_overvoltage1)} .or. {Trip_udcmax2.and.block_DC_overvoltage2};&                  }} .or. ;&                  {BRK_dc_ac .and. {;&                    {Trip_uacmin1.and.block_AC_undervoltage1} .or. ;&                    {Trip_uacmin2.and.block_AC_undervoltage2} .or. ;&                    {Trip_uacmax.and.block_AC_overvoltage} .or.;&                    {Trip_f.and.{block_underfrequency.or.block_overfrequency.or.block_rocof}} ;&                  }} .or. ;&                  trip_dc_manually .or. selfix(Remote_trip_dc,lastvalue(trip_remote),0), 0);;trip = trip_ac .or. trip_dc;;!switch_off_ac = picdro_const(trip_ac-0.4999, 0.001+BRK_delay_ac, 1.0) ;!switch_off_dc = picdro_const(trip_dc-0.4999, 0.001+BRK_delay_dc, 1.0) ;;output(trip_ac_manually.and.{.not.lastvalue(trip_ac)},'Converter AC side tripped manually.');output(trip_ac_manually.and.lastvalue(trip_ac),'Manually AC side tripping command ignored, because converter AC side is tripped already.');output(trip_ac,'Converter switching off (tripping AC side)...');event(BRK_number>0.5, trip_ac-0.5, 'create=EvtSwitch target=CB1 name=Open_CB1 i_switch=0 dtime=BRK_delay_ac');event(BRK_number>1.5, trip_ac-0.5, 'create=EvtSwitch target=CB2 name=Open_CB2 i_switch=0 dtime=BRK_delay_ac');event(BRK_number>2.5, trip_ac-0.5, 'create=EvtSwitch target=CB3 name=Open_CB3 i_switch=0 dtime=BRK_delay_ac');event(BRK_number>3.5,