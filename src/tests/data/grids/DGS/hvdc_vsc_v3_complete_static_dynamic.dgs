  13;C;idq_Current Control (Pos Seq) BlkDef;286;0;6;1;Vconv_max;0;;0;;0;;1;uconv_1d,uconv_1q;1;u1d,i1d_ref,i1d,i1q,i1q_ref,u1q;1;xi1d,xi1q;1;Kp,Ki,Enable_uFF,KuFF,Enable_iFF,Rseries,Xseries,Enable_irefFF,KidrefFF,KiqrefFF;1;freeze_xi1d,freeze_xi1q,di1d,di1q,du_1dR_FF,du_1qR_FF,du_i1d_R,du_i1d_X,du_i1d_ref_R,du_i1d_ref_X,du_i1q_R,du_i1q_X,du_i1q_ref_R,du_i1q_ref_X,du_iZ_1d,du_iZ_1q,duconv_1d,duconv_1q,u1d_enabled,u1q_enabled;60;du_i1d_R=selfix(Enable_iFF,i1d*(Rseries/100),0);du_i1d_X=selfix(Enable_iFF,i1d*(Xseries/100),0);du_i1q_R=selfix(Enable_iFF,i1q*(Rseries/100),0);du_i1q_X=selfix(Enable_iFF,i1q*(Xseries/100),0);freeze_xi1d=flipflop({{lastvalue(xi1d)>=Vconv_max}.and.{di1d>0.000001}}.or.{{lastvalue(xi1d)<=-Vconv_max}.and.{di1d<-0.000001}},{{lastvalue(xi1d)<Vconv_max}.or.{{lastvalue(xi1d)>=Vconv_max}.and.{di1d<0.0}}}.and.{{lastvalue(xi1d)>-Vconv_max}.or.{{lastvalue(xi1d)<=-Vconv_max}.and.{di1d>0.0}}});xi1d.=select(freeze_xi1d,0.0,abs(Ki)*di1d);duconv_1d=abs(Kp)*di1d+lim_const(xi1d,-Vconv_max,Vconv_max);freeze_xi1q=flipflop({{lastvalue(xi1q)>=Vconv_max}.and.{di1q>0.000001}}.or.{{lastvalue(xi1q)<=-Vconv_max}.and.{di1q<-0.000001}},{{lastvalue(xi1q)<Vconv_max}.or.{{lastvalue(xi1q)>=Vconv_max}.and.{di1q<0.0}}}.and.{{lastvalue(xi1q)>-Vconv_max}.or.{{lastvalue(xi1q)<=-Vconv_max}.and.{di1q>0.0}}});xi1q.=select(freeze_xi1q,0.0,abs(Ki)*di1q);duconv_1q=abs(Kp)*di1q+lim_const(xi1q,-Vconv_max,Vconv_max);di1d=i1d_ref-i1d;di1q=i1q_ref-i1q;uconv_1d=duconv_1d+du_iZ_1d+du_1dR_FF;uconv_1q=duconv_1q+du_1qR_FF+du_iZ_1q;du_1dR_FF=du_i1d_ref_R+u1d_enabled;du_1qR_FF=du_i1q_ref_R+u1q_enabled;du_iZ_1d=-du_i1d_R+du_i1q_X-du_i1q_ref_X;du_iZ_1q=-du_i1q_R+du_i1d_ref_X-du_i1d_X;u1d_enabled=selfix(Enable_uFF,KuFF*u1d,0);u1q_enabled=selfix(Enable_uFF,KuFF*u1q,0);du_i1d_ref_R=selfix(Enable_irefFF,i1d_ref*KidrefFF*(Rseries/100),0.0);du_i1d_ref_X=selfix(Enable_irefFF,i1d_ref*KidrefFF*(Xseries/100),0.0);du_i1q_ref_R=selfix(Enable_irefFF,i1q_ref*KiqrefFF*(Rseries/100),0.0);du_i1q_ref_X=selfix(Enable_irefFF,i1q_ref*KiqrefFF*(Xseries/100),0.0);"vardef(Kp)=;'Proportional gain of PI controllers'";"vardef(Ki)=;'Integration gain of PI controllers'";"vardef(Vconv_max)='p.u.';'Maximum internal converter voltage'";"vardef(Rseries)='%';'Series resistance'";"vardef(Xseries)='%';'Series reactance'";"vardef(Enable_iFF)=;'Current feed forward: 0=disabled; 1=enabled'";"vardef(Enable_uFF)=;'Voltage feed forward: 0=disabled; 1=enabled'";"vardef(KuFF)=;'Voltage feed forward gain'";"vardef(Enable_irefFF)=;'Current reference feed forward: 0=disabled; 1=enabled'";"vardef(KidrefFF)=;'Current reference feed forward gain, d-axis'";"vardef(KiqrefFF)=;'Current reference feed forward gain, q-axis'";"vardef(i1d)='p.u.';'Current, positive sequence, d-axis'";"vardef(i1q)='p.u.';'Current, positive sequence, q-axis'";"vardef(i1d_ref)='p.u.';'Current reference, positive sequence, d-axis'";"vardef(i1q_ref)='p.u.';'Current reference, positive sequence, q-axis'";"vardef(u1d)='p.u.';'Voltage, positive sequence, d-axis'";"vardef(u1q)='p.u.';'Voltage, positive sequence, q-axis'";"vardef(uconv_1d)='p.u.';'Converter voltage reference, positive sequence, d-axis'";"vardef(uconv_1q)='p.u.';'Converter voltage reference, positive sequence, q-axis'";limfix(Kp)=[0,);limfix(Ki)=(0,);limfix(Rseries)=[0,);limfix(Xseries)=(0,);limfix(Enable_iFF)=[0,1];limfix(Enable_uFF)=[0,1];limfix(KuFF)=[0,1];limfix(Vconv_max)=(0,);limfix(Enable_irefFF)=[0,1];limfix(KidrefFF)=[0,1];limfix(KiqrefFF)=[0,1];inc(xi1d)=uconv_1d+selfix(Enable_iFF,i1d*(Rseries/100)-i1q*(Xseries/100),0.0)-selfix(Enable_uFF,KuFF*u1d,0.0)-selfix(Enable_irefFF,i1d_ref*KidrefFF*(Rseries/100)-i1q_ref*KiqrefFF*(Xseries/100),0.0);inc(xi1q)=uconv_1q+selfix(Enable_iFF,i1q*(Rseries/100)+i1d*(Xseries/100),0.0)-selfix(Enable_uFF,KuFF*u1q,0.0)-selfix(Enable_irefFF,i1q_ref*KiqrefFF*(Rseries/100)+i1d_ref*KidrefFF*(Xseries/100),0.0);inc(freeze_xi1d)=0;inc(freeze_xi1q)=0;inc(i1d_ref)=i1d;inc(i1q_ref)=i1q;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;0;;0;;uconv_1d,uconv_1q;u1d,i1d_ref,i1d,i1q,i1q_ref,u1q;xi1d,xi1q;Kp,Ki,Enable_uFF,KuFF,Enable_iFF,Rseries,Xseries,Enable_irefFF,KidrefFF,KiqrefFF;freeze_xi1d,freeze_xi1q,di1d,di1q,du_1dR_FF,du_1qR_FF,du_i1d_R,du_i1d_X,du_i1d_ref_R,du_i1d_ref_X,du_i1q_R,du_i1q_X,du_i1q_ref_R,du_i1q_ref_X,du_iZ_1d,du_iZ_1q,duconv_1d,duconv_1q,u1d_enabled,u1q_enabled
  14;C;opm_Operating Mode BlkDef;286;0;6;0;;0;;0;;0;;1;uconv_r,uconv_i,uconv_2r,uconv_2i;1;uconv_r_nonisl,uconv_i_nonisl,uconv_r_isl,uconv_i_isl,mode_isl_cmd,uconv_2r_nonisl,uconv_2i_nonisl,uconv_2r_isl,uconv_2i_isl;0;;1;Mode_isl;1;uconv,uconv_2,mode_isl;36;mode_isl=mode_isl_cmd;inc(mode_isl_cmd)=selfix(Mode_isl,1,0);uconv_r=select(mode_isl,uconv_r_isl,uconv_r_nonisl);uconv_i=select(mode_isl,uconv_i_isl,uconv_i_nonisl);uconv=sqrt(max(0.0,sqr(uconv_r)+sqr(uconv_i)));uconv_2r=selfix(balanced(),0.0,selfix(rms(),select(mode_isl,uconv_2r_isl,uconv_2r_nonisl),0.0));uconv_2i=selfix(balanced(),0.0,selfix(rms(),select(mode_isl,uconv_2i_isl,uconv_2i_nonisl),0.0));uconv_2=selfix(balanced(),0.0,selfix(rms(),sqrt(max(0.0,sqr(uconv_2r)+sqr(uconv_2i))),0.0));"vardef(Mode_isl)=;'Operating mode: 0 = grid parallel, 1 = island'";"vardef(uconv_r_isl)='p.u.';'Converter voltage reference for islanded operation, real part'";"vardef(uconv_i_isl)='p.u.';'Converter voltage reference for islanded operation, imaginary part'";"vardef(uconv_r_nonisl)='p.u.';'Converter voltage reference for non-islanded (grid-parallel) operation, real part'";"vardef(uconv_i_nonisl)='p.u.';'Converter voltage reference for non-islanded (grid-parallel) operation, imaginary part'";"vardef(uconv_2r_isl)='p.u.';'Converter voltage reference for islanded operation, negative sequence, real part'";"vardef(uconv_2i_isl)='p.u.';'Converter voltage reference for islanded operation, negative sequence, imaginary part'";"vardef(uconv_2r_nonisl)='p.u.';'Converter voltage reference for non-islanded (grid parallel) operation, negative sequence, real part'";"vardef(uconv_2i_nonisl)='p.u.';'Converter voltage reference for non-islanded (grid parallel) operation, negative sequence, imaginary part'";"vardef(uconv_r)='p.u.';'Converter voltage reference, real part'";"vardef(uconv_i)='p.u.';'Converter voltage reference, imaginary part'";"vardef(uconv_2r)='p.u.';'Converter voltage reference, negative sequence, real part'";"vardef(uconv_2i)='p.u.';'Converter voltage reference, negative sequence, imaginary part'";"vardef(mode_isl_cmd)=;'Operating mode command signal: 0 = grid parallel, 1 = island'";"vardef(mode_isl)=;'Operating mode signal: 0 = grid parallel, 1 = island'";limfix(Mode_isl)=[0,1];inc0(uconv_2r)=0.0;inc0(uconv_2i)=0.0;inc(uconv_r_nonisl)=uconv_r;inc(uconv_i_nonisl)=uconv_i;inc(uconv_r_isl)=uconv_r;inc(uconv_i_isl)=uconv_i;inc(uconv_2r_nonisl)=uconv_2r;inc(uconv_2i_nonisl)=uconv_2i;inc(uconv_2r_isl)=uconv_2r;inc(uconv_2i_isl)=uconv_2i;inc(uconv)=sqrt(max(0.0,sqr(uconv_r)+sqr(uconv_i)));inc(uconv_2)=sqrt(max(0.0,sqr(uconv_2r)+sqr(uconv_2i)));;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;0;;0;;uconv_r,uconv_i,uconv_2r,uconv_2i;uconv_r_nonisl,uconv_i_nonisl,uconv_r_isl,uconv_i_isl,mode_isl_cmd,uconv_2r_nonisl,uconv_2i_nonisl,uconv_2r_isl,uconv_2i_isl;;Mode_isl;uconv,uconv_2,mode_isl
  15;C;pm_Modulation Factor BlkDef;286;0;6;0;;0;;1;udc_op_min;0;;1;Pmr,Pmi,Pm0;1;uconv_r,udc,uconv_i,uconv_0;0;;1;Uacn,Udcn,udcFF,AutoInput;1;Pm,udc_ltd;28;udc_ltd=selfix(udcFF,max(udc,udc_op_min,0.01),1.0);Pmi=(2*sqrt(2)/sqrt(3))*(uconv_i/udc_ltd)*(Uacn/Udcn);Pm=sqrt(max(0.0,sqr(Pmr)+sqr(Pmi)));Pmr=(2*sqrt(2)/sqrt(3))*(uconv_r/udc_ltd)*(Uacn/Udcn);Pm0=(2*sqrt(2)/sqrt(3))*(uconv_0/udc_ltd)*(Uacn/Udcn);"vardef(udcFF)=;'DC voltage feed-forward: 0 = disabled, 1 = enabled'";"vardef(Uacn)='kV';'Nominal AC voltage of converter'";"vardef(Udcn)='kV';'Nominal DC voltage of converter'";"vardef(udc_op_min)='p.u.';'Min. normal operating DC voltage'";"vardef(AutoInput)=;'Automated input: 0 = no, 1 = yes (Uacn, Udcn)'";"vardef(uconv_r)='p.u.';'Converter voltage reference, real part'";"vardef(uconv_i)='p.u.';'Converter voltage reference, imaginary part'";"vardef(uconv_0)='p.u.';'Converter voltage reference, zero sequence component'";"vardef(udc)='p.u.';'DC voltage'";"vardef(Pmr)='p.u.';'Pulse modulation factor, real part'";"vardef(Pmi)='p.u.';'Pulse modulation factor, imaginary part'";"vardef(Pm)='p.u.';'Pulse modulation factor, magnitude'";"vardef(Pm0)='p.u.';'Pulse modulation factor, zero sequence component'";limfix(udcFF)=[0,1];limfix(Uacn)=(0,);limfix(Udcn)=(0,);limfix(udc_op_min)=[0,1);inc0(Pm0)=0.0;inc(uconv_r)=Pmr*selfix(udcFF,max(abs(udc),udc_op_min),1.0)*sqrt(3)/(2*sqrt(2))*Udcn/Uacn;inc(uconv_i)=Pmi*selfix(udcFF,max(abs(udc),udc_op_min),1.0)*sqrt(3)/(2*sqrt(2))*Udcn/Uacn;inc(uconv_0)=Pm0*selfix(udcFF,max(abs(udc),udc_op_min),1.0)*sqrt(3)/(2*sqrt(2))*Udcn/Uacn;inc(Pm)=sqrt(max(0.0,sqr(Pmr)+sqr(Pmi)));outfix(udc<0.0,'Measured DC voltage has wrong polarity.');;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;0;;1;AutoInput;Pmr,Pmi,Pm0;uconv_r,udc,uconv_i,uconv_0;;Uacn,Udcn,udcFF,AutoInput;Pm,udc_ltd
  16;C;EPC Generic BlkDef;286;0;6;0;;0;;0;;0;;1;EPC_flag,dP_epc,Pmin_epc,Pmax_epc;1;EPC1,EPC2,EPC3,EPC4,EPC5,EPC6,Pac_loc,Pac_poc;0;;1;Pmax_EPC1,Pmax_EPC2,Pmax_EPC3,P_EPC5,P_EPC6,dP_EPC1,dP_EPC2,dP_EPC3,dP_EPC5,dP_EPC6,dP_release,Tmin,poc;1;Pmax_epc1,Pmin_epc1,Pmax_epc2,Pmin_epc2,Pmax_epc3,Pmin_epc3,epc1_start,epc2_start,epc3_start,epc5_start,epc6_start,epc1_active,epc2_active,epc3_active,epc5_active,epc6_active,Pmin_inc,Pmax_inc,dP_inc,P_inc,P;127;"vardef(Pmax_EPC1)  = '%'  ;'Maximum power EPC function 1'";"vardef(Pmax_EPC2)  = '%'  ;'Maximum power EPC function 2'";"vardef(Pmax_EPC3)  = '%'  ;'Maximum power EPC function 3'";"vardef(P_EPC5)     = '%'  ;'Additional power EPC function 5'";"vardef(P_EPC6)     = '%'  ;'Additional power EPC function 6'";"vardef(dP_EPC1)    = '%/s';'Max. power limitation gradient (EPC1)'";"vardef(dP_EPC2)    = '%/s';'Max. power limitation gradient (EPC2)'";"vardef(dP_EPC3)    = '%/s';'Max. power limitation gradient (EPC3)'";"vardef(dP_EPC5)    = '%/s';'Maximum power gradient (EPC5)'";"vardef(dP_EPC6)    = '%/s';'Maximum power gradient (EPC6)'";"vardef(dP_release) = '%/s';'Max. power gradient after EPC release'";"vardef(Tmin)       = 's'  ;'Minimum activation time for starting EPC'";"vardef(poc)        =      ;'Power control at: 0 = local AC terminal, 1 = PoC'";;"vardef(EPC1)    =       ;'Trigger Emergency Power Control Function 1'";"vardef(EPC2)    =       ;'Trigger Emergency Power Control Function 2'";"vardef(EPC3)    =       ;'Trigger Emergency Power Control Function 3'";"vardef(EPC4)    =       ;'Trigger Emergency Power Control Function 4'";"vardef(EPC5)    =       ;'Trigger Emergency Power Control Function 5'";"vardef(EPC6)    =       ;'Trigger Emergency Power Control Function 6'";"vardef(Pac_loc) = 'p.u.';'AC power (local measurement)'";"vardef(Pac_poc) = 'p.u.';'AC power (measurement at PoC)'";;"vardef(EPC_flag) =       ;'General EPC activation flag'";"vardef(dP_epc)   = 'p.u.';'Additional active power by EPC'";"vardef(Pmin_epc) = 'p.u.';'Minimum power limitation by EPC'";"vardef(Pmax_epc) = 'p.u.';'Maximum power limitation by EPC'";;"vardef(P)         = 'p.u.';'Active power considered for EPC'";"vardef(Pmin_epc1) = 'p.u.';'Minimum power limitation by EPC function 1'";"vardef(Pmax_epc1) = 'p.u.';'Maximum power limitation by EPC function 1'";"vardef(Pmin_epc2) = 'p.u.';'Minimum power limitation by EPC function 2'";"vardef(Pmax_epc2) = 'p.u.';'Maximum power limitation by EPC function 2'";"vardef(Pmin_epc3) = 'p.u.';'Minimum power limitation by EPC function 3'";"vardef(Pmax_epc3) = 'p.u.';'Maximum power limitation by EPC function 3'";"vardef(Pmin_inc)  = 'p.u.';'Minimum power limitation without EPC'";"vardef(Pmax_inc)  = 'p.u.';'Maximum power limitation without EPC'";"vardef(P_epc5)    = 'p.u.';'Additional power by EPC function 5'";"vardef(P_epc6)    = 'p.u.';'Additional power by EPC function 6'";;;limfix(Pmax_EPC1) = [0,)       ! Pmax_EPC1 >= 0;limfix(Pmax_EPC2) = [0,)       ! Pmax_EPC2 >= 0;limfix(Pmax_EPC3) = [0,)       ! Pmax_EPC3 >= 0;limfix(dP_EPC1)   = (0,)       ! dP_EPC1 > 0;limfix(dP_EPC2)   = (0,)       ! dP_EPC2 > 0;limfix(dP_EPC3)   = (0,)       ! dP_EPC3 > 0;limfix(dP_EPC5)   = (0,)       ! dP_EPC5 > 0;limfix(dP_EPC6)   = (0,)       ! dP_EPC6 > 0;limfix(poc)       = [0,1]      ! 0 <= poc <= 1;;limits(EPC1) = [0,1]         ! 0 <= EPC function 1 <= 1;limits(EPC2) = [0,1]         ! 0 <= EPC function 2 <= 1;limits(EPC3) = [0,1]         ! 0 <= EPC function 3 <= 1;limits(EPC4) = [0,1]         ! 0 <= EPC function 4 <= 1;limits(EPC5) = [0,1]         ! 0 <= EPC function 5 <= 1;limits(EPC6) = [0,1]         ! 0 <= EPC function 6 <= 1;;;inc(EPC1) = 0;inc(EPC2) = 0;inc(EPC3) = 0;inc(EPC4) = 0;inc(EPC5) = 0;inc(EPC6) = 0;;inc0(EPC_flag) = 0;;inc0(dP_epc)   =  0.0;inc0(Pmin_epc) = -1.0;inc0(Pmax_epc) =  1.0;inc(Pmin_inc)  = Pmin_epc;inc(Pmax_inc)  = Pmax_epc;inc(dP_inc)    = dP_epc;inc(P)         = selfix(poc, Pac_poc, Pac_loc);inc(P_inc)     = P;;inc(epc1_active) = 0;inc(epc2_active) = 0;inc(epc3_active) = 0;inc(epc5_active) = 0;inc(epc6_active) = 0;;;P = selfix(poc, Pac_poc, Pac_loc);;epc1_start = picdro_const(flipflop(EPC1.and.{.not.EPC4},EPC4), Tmin, 0.0);epc2_start = picdro_const(flipflop(EPC2.and.{.not.EPC4},EPC4), Tmin, 0.0);epc3_start = picdro_const(flipflop(EPC3.and.{.not.EPC4},EPC4), Tmin, 0.0);epc5_start = picdro_const(flipflop(EPC5.and.{.not.EPC4}.and.{.not.EPC6},EPC4), Tmin, 0.0);epc6_start = picdro_const(flipflop(EPC6.and.{.not.EPC4}.and.{.not.EPC5},EPC4), Tmin, 0.0);;epc1_active = epc1_start.or.{Pmax_epc1<Pmax_inc}.or.{Pmax_epc1>Pmax_inc};epc2_active = epc2_start.or.{Pmax_epc2<Pmax_inc}.or.{Pmax_epc2>Pmax_inc};epc3_active = epc3_start.or.{Pmax_epc3<Pmax_inc}.or.{Pmax_epc3>Pmax_inc};epc5_active = epc5_start.or.{P_epc5<0.0}.or.{P_epc5>0.0};epc6_active = epc6_start.or.{P_epc6<0.0}.or.{P_epc6>0.0};;EPC_flag = epc1_active.or.epc2_active.or.epc3_active.or.EPC4.or.epc5_active.or.epc6_active;;Pmax_epc1 = gradlim_const(select(epc1_start, Pmax_EPC1/100, Pmax_inc), -dP_EPC1/100, dP_release/100);Pmin_epc1 = gradlim_const(select(epc1_start,-Pmax_EPC1/100, Pmin_inc), -dP_release/100, dP_EPC1/100);;Pmax_epc2 = gradlim_const(select(epc2_start, Pmax_EPC2/100, Pmax_inc), -dP_EPC2/100, dP_release/100);Pmin_epc2 = gradlim_const(select(epc2_start,-Pmax_EPC2/100, Pmin_inc), -dP_release/100, dP_EPC2/100);;Pmax_epc3 = gradlim_const(select(epc3_start, Pmax_EPC3/100, Pmax_inc), -dP_EPC3/100, dP_release/100);Pmin_epc3 = gradlim_const(select(epc3_start,-Pmax_EPC3/100, Pmin_inc), -dP_release/100, dP_EPC3/100);;!P_epc5 = gradlim_const(select(epc5_start, P_EPC5/100, 0.0), selfix_const(P_EPC5 <= 0, -dP_EPC5/100, -dP_release/100), select_const(P_EPC5 >= 0, dP_EPC5/100, dP_release/100));!P_epc6 = gradlim_const(select(epc6_start, P_EPC6/100, 0.0), select_const(P_EPC6 <= 0, -dP_EPC6/100, -dP_release/100), select_const(P_EPC6 >= 0, dP_EPC6/100, dP_release/100));P_epc5 = gradlim_const(select(epc5_start, select(P_inc+P_EPC5/100>Pmax_inc,Pmax_inc-P_inc,select(P_inc+P_EPC5/100<Pmin_inc,Pmin_inc+P_inc,P_EPC5/100)), 0.0), selfix_const(P_EPC5 <= 0, -dP_EPC5/100, -dP_release/100), select_const(P_EPC5 >= 0, dP_EPC5/100, dP_release/100));P_epc6 = gradlim_const(select(epc6_start, select(P_inc+P_EPC6/100>Pmax_inc,Pmax_inc-P_inc,select(P_inc+P_EPC6/100<Pmin_inc,Pmin_inc+P_inc,P_EPC6/100)), 0.0), select_const(P_EPC6 <= 0, -dP_EPC6/100, -dP_release/100), select_const(P_EPC6 >= 0, dP_EPC6/100, dP_release/100));;dP_epc = dP_inc + P_epc5 + P_epc6;;Pmin_epc = min(0.0,max(Pmin_inc,max(Pmin_epc1,max(Pmin_epc2,Pmin_epc3))));Pmax_epc = max(0.0,min(Pmax_inc,min(Pmax_epc1,min(Pmax_epc2,Pmax_epc3))));;;output(epc1_start, 'EPC Function 1 activated.');output(epc2_start, 'EPC Function 2 activated.');output(epc3_start, 'EPC Function 3 activated.');output(EPC4,       'EPC Function 4 activated.');output(epc5_start, 'EPC Function 5 activated.');output(epc6_start, 'EPC Function 6 activated.');;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;0;;0;;EPC_flag,dP_epc,Pmin_epc,Pmax_epc;EPC1,EPC2,EPC3,EPC4,EPC5,EPC6,Pac_loc,Pac_poc;;Pmax_EPC1,Pmax_EPC2,Pmax_EPC3,P_EPC5,P_EPC6,dP_EPC1,dP_EPC2,dP_EPC3,dP_EPC5,dP_EPC6,dP_release,Tmin,poc;Pmax_epc1,Pmin_epc1,Pmax_epc2,Pmin_epc2,Pmax_epc3,Pmin_epc3,epc1_start,epc2_start,epc3_start,epc5_start,epc6_start,epc1_active,epc2_active,epc3_active,epc5_active,epc6_active,Pmin_inc,Pmax_inc,dP_inc,P_inc,P
  17;C;fsm_Freq Sensitive Mode HVDC Link BlkDef;286;0;6;1;dP_fsm_max,ddP_fsm_max,ddP_lfsmo_max,dP_lfsmu_max,ddP_lfsmu_max;0;;1;dP_fsm_min,ddP_fsm_min,dP_lfsmo_min,ddP_lfsmo_min,ddP_lfsmu_min;0;;1;dP;1;f_fast,f_slow,fn,f_fast_remote,f_slow_remote,fn_remote;1;x_smooth;1;FSM_on,Mode_Db,f_db1,f_db2,delay_init_fsm,s1,s2,LFSMO_on,f1_lfsmo,delay_init_lfsmo,s3,LFSMU_on,f2_lfsmu,delay_init_lfsmu,s4,Mode_in,T_smooth,Mode_frem,f_db1_remote,f_db2_remote,T_interlock,frz;1;f_in_fsm,f_under_fsm,f_over_fsm,f_in_lfsmo,f_over_lfsmo,f_in_lfsmu,f_under_lfsmu,dP_fsm,dP_fsm_lock,dP_fsm_ltd,dP_fsm_unltd,dP_lfsmo,dP_lfsmo_lock,dP_lfsmo_ltd,dP_lfsmo_unltd,dP_lfsmu,dP_lfsmu_lock,dP_lfsmu_ltd,dP_lfsmu_unltd,dP_sum,df,df_fsm,df_lfsmo,df_lfsmu,df_remote,f,f_remote,interlock;150;f_in_fsm=selfix(FSM_on,f,fn);f_under_fsm=selfix(Mode_Db.and.{delay_init_fsm>0.0},picdro_const(selfix(Mode_Db.and.{delay_init_fsm>0.0},(fn+(f_db1/1000))-f_in_fsm+0.5,0),delay_init_fsm,delay_init_fsm),select_const(Mode_Db.and.{f_in_fsm<(fn+(f_db1/1000))},1,0));inc(f_under_fsm)=0;f_over_fsm=selfix(Mode_Db.and.{delay_init_fsm>0.0},picdro_const(selfix(Mode_Db.and.{delay_init_fsm>0.0},f_in_fsm-(fn+(f_db2/1000))+0.5,0),delay_init_fsm,delay_init_fsm),select_const(Mode_Db.and.{f_in_fsm>(fn+(f_db2/1000))},1,0));inc(f_over_fsm)=0;df_fsm=selfix(FSM_on,selfix(Mode_Db,selfix(delay_init_fsm>0.0,select(f_under_fsm,min((f_in_fsm-(fn+(f_db1/1000)))/fn,0.0),select(f_over_fsm,max((f_in_fsm-(fn+(f_db2/1000)))/fn,0.0),0.0)),min((f_in_fsm-(fn+(f_db1/1000)))/fn,0.0)+max((f_in_fsm-(fn+(f_db2/1000)))/fn,0.0)),(f_in_fsm-fn)/fn),0.0);dP_fsm_unltd=-100/s1*min(df_fsm,0.0)-100/s2*max(df_fsm,0.0);dP_lfsmo_unltd=-100/s3*df_lfsmo;dP_lfsmu_unltd=-100/s4*df_lfsmu;dP_fsm=gradlim_const(dP_fsm_lock,ddP_fsm_min/100,ddP_fsm_max/100);dP_lfsmo=gradlim_const(dP_lfsmo_lock,ddP_lfsmo_min/100,ddP_lfsmo_max/100);dP_lfsmu=gradlim_const(dP_lfsmu_lock,ddP_lfsmu_min/100,ddP_lfsmu_max/100);f=selfix(Mode_in,f_fast,f_slow);f_remote=selfix(Mode_in,f_fast_remote,f_slow_remote);dP_fsm_lock=select(interlock,selfix(frz,select(interlock.and.{abs(dP_fsm_ltd)>=abs(lastvalue(dP_fsm))},lastvalue(dP_fsm),dP_fsm_ltd),0.0),dP_fsm_ltd);dP_lfsmo_lock=select(interlock,selfix(frz,select(interlock.and.{abs(dP_lfsmo_ltd)>=abs(lastvalue(dP_lfsmo))},lastvalue(dP_lfsmo),dP_lfsmo_ltd),0.0),dP_lfsmo_ltd);dP_lfsmu_lock=select(interlock,selfix(frz,select(interlock.and.{abs(dP_lfsmu_ltd)>=abs(lastvalue(dP_lfsmu))},lastvalue(dP_lfsmu),dP_lfsmu_ltd),0.0),dP_lfsmu_ltd);inc(interlock)=0;interlock=selfix(Mode_frem,select_const({picdro(df-selfix_const(Mode_Db,f_db1/1000,-0.000001)+0.5,max(T_interlock,0.001),max(T_interlock,0.001)).and.picdro(max(f_db2_remote/1000,0.01)-df_remote+0.5,max(T_interlock,0.001),max(T_interlock,0.001))}.or.{picdro(selfix_const(Mode_Db,f_db2/1000,0.000001)-df+0.5,max(T_interlock,0.001),max(T_interlock,0.001)).and.picdro(df_remote-min(f_db1_remote/1000,-0.01)+0.5,max(T_interlock,0.001),max(T_interlock,0.001))},0,1),0);f_in_lfsmo=selfix(LFSMO_on,f,fn);f_over_lfsmo=selfix(delay_init_lfsmo>0.0,picdro_const(selfix(delay_init_lfsmo>0.0,f_in_lfsmo-f1_lfsmo+0.5,0),delay_init_lfsmo,delay_init_lfsmo),select_const(f_in_lfsmo>f1_lfsmo,1,0));inc(f_over_lfsmo)=0;df_lfsmo=selfix(LFSMO_on,selfix(delay_init_lfsmo>0.0,select(f_over_lfsmo,max((f_in_lfsmo-f1_lfsmo)/fn,0.0),0.0),max((f_in_lfsmo-f1_lfsmo)/fn,0.0)),0.0);f_in_lfsmu=selfix(LFSMU_on,f,fn);f_under_lfsmu=selfix(delay_init_lfsmu>0.0,picdro_const(selfix(delay_init_lfsmu>0.0,f2_lfsmu-f_in_lfsmu+0.5,0),delay_init_lfsmu,delay_init_lfsmu),select_const(f_in_lfsmu<f2_lfsmu,1,0));inc(f_under_lfsmu)=0;df_lfsmu=selfix(LFSMU_on,selfix(delay_init_lfsmu>0.0,select(f_under_lfsmu,min((f_in_lfsmu-f2_lfsmu)/fn,0.0),0.0),min((f_in_lfsmu-f2_lfsmu)/fn,0.0)),0.0);dP_fsm_ltd=lim(dP_fsm_unltd,dP_fsm_min/100,dP_fsm_max/100);dP_lfsmo_ltd=lim(dP_lfsmo_unltd,dP_lfsmo_min/100,0/100);dP_lfsmu_ltd=lim(dP_lfsmu_unltd,0/100,dP_lfsmu_max/100);limfix(T_smooth)=[0,);x_smooth.=selfix(T_smooth>0,(dP_sum-x_smooth)/T_smooth,0.0);dP=selfix(T_smooth>0,x_smooth,dP_sum);dP_sum=dP_fsm+dP_lfsmu+dP_lfsmo;df_remote=f_remote-fn_remote;df=f-fn;"vardef(FSM_on)=;'Frequency Sensitive Mode (FSM): 0 = off, 1 = on'";"vardef(LFSMO_on)=;'Limited FSM-O (overfrequency): 0=off, 1=on'";"vardef(LFSMU_on)=;'Limited FSM-U (underfrequency): 0=off, 1=on'";"vardef(s1)='%';'Droop 1 (FSM upward regulation, for f < fn)'";"vardef(s2)='%';'Droop 2 (FSM downward regulation, for f > fn)'";"vardef(s3)='%';'Droop 3 (LFSM-O downward regulation, for f > f1)'";"vardef(s4)='%';'Droop 4 (LFSM-U upward regulation, for f < f2)'";"vardef(Mode_Db)=;'Frequency deadband FSM: 0 = without, 1 = with'";"vardef(f_db1)='mHz';'Lower frequency deadband FSM (neg. value)'";"vardef(f_db2)='mHz';'Upper frequency deadband FSM (pos. value)'";"vardef(f1_lfsmo)='Hz';'Frequency threshold for LFSM-O (> fn)'";"vardef(f2_lfsmu)='Hz';'Frequency threshold for LFSM-U (< fn)'";"vardef(delay_init_fsm)='s';'Initial response delay FSM (deadband)'";"vardef(delay_init_lfsmo)='s';'Initial response delay LFSM-O'";"vardef(delay_init_lfsmu)='s';'Initial response delay LFSM-U'";"vardef(Mode_in)=;'Input: 0 = slow (precise), 1 = fast f signal'";"vardef(T_smooth)='s';'Output smoothing time constant (PT1 filter)'";"vardef(Mode_frem)=;'Consider Freq.: 0 = local, 1 = local and remote'";"vardef(T_interlock)='s';'Interlocking time delay'";"vardef(frz)=;'Output if interlocked: 0 = back to zero, 1 = freeze'";"vardef(dP_fsm_max)='%';'Maximum additional power FSM (dP > 0)'";"vardef(dP_fsm_min)='%';'Minimum additional power FSM (dP < 0)'";"vardef(dP_lfsmo_min)='%';'Max. power reduction LFSM-O (dP < 0)'";"vardef(dP_lfsmu_max)='%';'Max. additional power LFSM-U (dP > 0)'";"vardef(ddP_fsm_max)='%/s';'Max. rate of change of dP FSM (pos.)'";"vardef(ddP_fsm_min)='%/s';'Min. rate of change of dP FSM (neg.)'";"vardef(ddP_lfsmo_max)='%/s';'Max. rate of change of dP LFSM-O'";"vardef(ddP_lfsmo_min)='%/s';'Min. rate of change of dP LFSM-O'";"vardef(ddP_lfsmu_max)='%/s';'Max. rate of change of dP LFSM-U'";"vardef(ddP_lfsmu_min)='%/s';'Min. rate of change of dP LFSM-U'";"vardef(f_fast)='Hz';'Fast frequency input signal'";"vardef(f_slow)='Hz';'Slow frequency input signal'";"vardef(fn)='Hz';'Nominal frequency'";"vardef(f_fast_remote)='Hz';'Fast frequency input signal from remote'";"vardef(f_slow_remote)='Hz';'Slow frequency input signal from remote'";"vardef(fn_remote)='Hz';'Nominal frequency of remote system'";"vardef(dP)='p.u.';'Additional active power'";"vardef(f)='Hz';'Frequency input signal'";"vardef(f_over_fsm)=;'Flag over-frequency FSM (frequency above deadband)'";"vardef(f_under_fsm)=;'Flag under-frequency FSM (frequency below deadband)'";"vardef(f_over_lfsmo)=;'Flag over-frequency LFSM-O'";"vardef(f_under_lfsmu)=;'Flag under-frequency LFSM-U'";"vardef(df_fsm)='p.u.';'Frequency deviation relevant for FSM'";"vardef(df_lfsmo)='p.u.';'Frequency deviation relevant for LFSM-O'";"vardef(df_lfsmu)='p.u.';'Frequency deviation relevant for LFSM-U'";"vardef(dP_sum)='p.u.';'Additional active power (unfiltered sum)'";"vardef(dP_fsm)='p.u.';'Additional active power by FSM'";"vardef(dP_lfsmo)='p.u.';'Additional active power by LFSM-O'";"vardef(dP_lfsmu)='p.u.';'Additional active power by LFSM-U'";"vardef(dP_fsm_unltd)='p.u.';'Unlimited additional active power by FSM'";"vardef(dP_lfsmo_unltd)='p.u.';'Unlimited additional active power by LFSM-O'";"vardef(dP_lfsmu_unltd)='p.u.';'Unlimited additional active power by LFSM-U'";"vardef(dP_fsm_ltd)='p.u.';'Limited additional active power by FSM (before interlocking)'";"vardef(dP_lfsmo_ltd)='p.u.';'Limited additional active power by LFSM-O (before interlocking)'";"vardef(dP_lfsmu_ltd)='p.u.';'Limited additional active power by LFSM-U (before interlocking)'";"vardef(dP_fsm_lock)='p.u.';'Interlocked additional active power by FSM'";"vardef(dP_lfsmo_lock)='p.u.';'Interlocked additional active power by LFSM-O'";"vardef(dP_lfsmu_lock)='p.u.';'Interlocked additional active power by LFSM-U'";"vardef(df)='Hz';'Frequency deviation'";"vardef(f_fast_remote)='Hz';'Fast frequency input signal from remote'";"vardef(f_slow_remote)='Hz';'Slow frequency input signal from remote'";"vardef(f_remote)='Hz';'Frequency input signal from remote'";"vardef(fn_remote)='Hz';'Nominal frequency of remote system'";"vardef(df_remote)='Hz';'Frequency deviation of remote system'";"vardef(f_db1_remote)='mHz';'Lower frequency insensitivity deadband remote (neg. value)'";"vardef(f_db2_remote)='mHz';'Upper frequency insensitivity deadband remote (pos. value)'";"vardef(interlock)=;'Interlocking signal for FSM/LFSM of HVDC system'";limfix(FSM_on)=[0,1];limfix(LFSMO_on)=[0,1];limfix(LFSMU_on)=[0,1];limfix(s1)=(0,);limfix(s2)=(0,);limfix(s3)=(0,);limfix(s4)=(0,);limfix(f1_lfsmo)=(fn,);limfix(f2_lfsmu)=(,fn);limfix(fn)=(0,);limfix(Mode_Db)=[0,1];limfix(f_db1)=(-1000*fn,0];limfix(f_db2)=[0,1000*fn);limfix(delay_init_fsm)=[0,);limfix(delay_init_lfsmo)=[0,);limfix(delay_init_lfsmu)=[0,);limfix(Mode_in)=[0,1];limfix(T_smooth)=[0,);limfix(Mode_frem)=[0,1];limfix(T_interlock)=[0.001,);limfix(frz)=[0,1];limfix(dP_fsm_max)=(0,);limfix(dP_fsm_min)=(,0);limfix(dP_lfsmo_min)=(,0);limfix(dP_lfsmu_max)=(0,);limfix(ddP_fsm_max)=(0,);limfix(ddP_fsm_min)=(,0);limfix(ddP_lfsmo_max)=(0,);limfix(ddP_lfsmo_min)=(,0);limfix(ddP_lfsmu_max)=(0,);limfix(ddP_lfsmu_min)=(,0);limfix(f_db1_remote)=(-1000*fn_remote,0);limfix(f_db2_remote)=(0,1000*fn_remote);inc(dP)=0.0;inc0(f_fast_remote)=fn;inc0(f_slow_remote)=fn_remote;inc0(fn_remote)=f_fast_remote;inc(x_smooth)=0.0;inc(dP_fsm_ltd)=0.0;inc(dP_lfsmo_ltd)=0.0;inc(dP_lfsmu_ltd)=0.0;inc(dP_fsm_lock)=0.0;inc(dP_lfsmo_lock)=0.0;inc(dP_lfsmu_lock)=0.0;inc(dP_fsm)=0.0;inc(dP_lfsmo)=0.0;inc(dP_lfsmu)=0.0;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;0;;0;;dP;f_fast,f_slow,fn,f_fast_remote,f_slow_remote,fn_remote;x_smooth;FSM_on,Mode_Db,f_db1,f_db2,delay_init_fsm,s1,s2,LFSMO_on,f1_lfsmo,delay_init_lfsmo,s3,LFSMU_on,f2_lfsmu,delay_init_lfsmu,s4,Mode_in,T_smooth,Mode_frem,f_db1_remote,f_db2_remote,T_interlock,frz;f_in_fsm,f_under_fsm,f_over_fsm,f_in_lfsmo,f_over_lfsmo,f_in_lfsmu,f_under_lfsmu,dP_fsm,dP_fsm_lock,dP_fsm_ltd,dP_fsm_unltd,dP_lfsmo,dP_lfsmo_lock,dP_lfsmo_ltd,dP_lfsmo_unltd,dP_lfsmu,dP_lfsmu_lock,dP_lfsmu_ltd,dP_lfsmu_unltd,dP_sum,df,df_fsm,df_lfsmo,df_lfsmu,df_remote,f,f_remote,interlock
  18;C;pod_Power Oscillation Damping BlkDef;286;0;6;1;dP_max;0;;1;dP_min;0;;1;dP,dQ;1;P,Q,uac,f,yin_ext;1;xw,xd,x2,x4;1;Input,Output,Mode,Tw,Kin,Kd,T1,T2,T3,T4;1;dxw,dxd,Kint2,yoint2,Kint4,yoint4,dP_derivative,dP_lead_lag,dy_out,y_1,y_2,y_K,y_signal,y_washout,yi_derivative,yi_invert,yi_lead_lag;64;dxd=Kd*(yi_invert-xd);xd.=dxd;y_1=dxd;y_K=Kin*y_washout;y_signal=selfix(Input>4.5,yin_ext,selfix(Input>3.5,f,selfix(Input>2.5,uac,selfix(Input>1.5,Q,selfix(Input>0.5,P,0.0)))));yi_invert=-yi_derivative;inc(Kint2)=select(T1>0.and.T2>0,T1/(T1-T2),1);x2.=select(T1>0,(y_2-x2)/T1,select(T2>0,(yi_lead_lag-y_2)/T2,0));yoint2=select(T1>0.and.T2>0,(T1/T2-1)*(yi_lead_lag*Kint2-x2),select(T2>0,limstate_const(x2,dP_min,dP_max),yi_lead_lag));y_2=lim(select(T1-T2<>0.and.T2<>0,yoint2,yi_lead_lag),dP_min,dP_max);inc(Kint4)=select(T3>0.and.T4>0,T3/(T3-T4),1);x4.=select(T3>0,(dP_lead_lag-x4)/T3,select(T4>0,(y_2-dP_lead_lag)/T4,0));yoint4=select(T3>0.and.T4>0,(T3/T4-1)*(y_2*Kint4-x4),select(T4>0,limstate_const(x4,dP_min,dP_max),y_2));dP_lead_lag=lim(select(T3-T4<>0.and.T4<>0,yoint4,y_2),dP_min,dP_max);dy_out=selfix(Mode,dP_lead_lag,dP_derivative);dP=selfix(Output,0,dy_out);dQ=selfix(Output,dy_out,0);dP_derivative=lim_const(y_1,dP_min,dP_max);yi_derivative=selfix(Mode,0,y_K);yi_lead_lag=selfix(Mode,y_K,0);dxw=select(Tw>0,(y_signal-xw)/Tw,0);xw.=dxw;y_washout=select(Tw>0,Tw*dxw,y_signal);limits(Tw)=[0,];"vardef(Input)=;'POD input: 1=P, 2=Q, 3=Vac, 4=f, 5= external signal, 0=none'";"vardef(Output)=;'POD output: 0 = dP (active), 1 = dQ (reactive)'";"vardef(Tw)='s';'Washout time constant'";"vardef(Kin)=;'Regulator input gain'";"vardef(Mode)=;'POD mode: 0 = Derivative, 1 = Lead-lag'";"vardef(Kd)=;'Derivate gain'";"vardef(T1)='s';'Lead time constant 1'";"vardef(T2)='s';'Lag time constant 1'";"vardef(T3)='s';'Lead time constant 2'";"vardef(T4)='s';'Lag time constant 2'";"vardef(dP_min)='p.u.';'Damping control minimum output'";"vardef(dP_max)='p.u.';'Damping control maximum output'";"vardef(P)='p.u.';'Active power'";"vardef(Q)='p.u.';'Reactive power'";"vardef(uac)='p.u.';'AC voltage magnitude'";"vardef(f)='Hz';'Frequency'";"vardef(yin_ext)=;'External input signal'";"vardef(dP)='p.u.';'Power oscillation damping output signal'";limfix(Input)=[0,5];limfix(Output)=[0,1];limfix(Tw)=(0,);limfix(Mode)=[0,1];limfix(Kd)=(0,);limfix(T1)=(0,);limfix(T2)=(0,);limfix(T3)=(0,);limfix(T4)=(0,);limfix(dP_min)=(,0);limfix(dP_max)=(0,);inc0(P)=0;inc0(Q)=0;inc0(uac)=0;inc0(f)=0;inc0(yin_ext)=0;inc(xw)=y_signal;inc(xd)=yi_derivative;inc(x2)=0;inc(x4)=0;inc(dP)=0;inc(dQ)=0;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;0;;0;;dP,dQ;P,Q,uac,f,yin_ext;xw,xd,x2,x4;Input,Output,Mode,Tw,Kin,Kd,T1,T2,T3,T4;dxw,dxd,Kint2,yoint2,Kint4,yoint4,dP_derivative,dP_lead_lag,dy_out,y_1,y_2,y_K,y_signal,y_washout,yi_derivative,yi_invert,yi_lead_lag
  19;C;si_Synthetic Inertia BlkDef;286;0;6;1;dPmax;1;dPmarge_up;1;dPmin;1;dPmarge_down;1;dP;1;f,fn;1;xf;1;H,Tf,dPlimdyn;1;speed,df,fclamp;48;! Parameters;"vardef(H)        = 's'   ;'Inertia constant' ! = Ta/2 (acceleration time constant / 2)";"vardef(Tf)       = 's'   ;'Time constant for frequency derivative'";"vardef(dPmin)    = 'p.u.';'Minimum additional power (fixed limit)'";"vardef(dPmax)    = 'p.u.';'Maximum additional power (fixed limit)'";"vardef(dPlimdyn) =       ;'Dynamic power limitation: 0 = off, 1 = on'";! Input signals;"vardef(fn)     = 'Hz'  ;'Nominal frequency'";"vardef(f)      = 'Hz'  ;'Frequency'";! Output signals;"vardef(dP)     = 'p.u.';'Additional active power'";! State variables;"vardef(xf)     = 'Hz'  ;'Frequency (state variable)'";! Internal variables;"vardef(speed)  = 'p.u.';'Synthetic speed'";"vardef(df)     = 'Hz/s';'Derivative of frequency'";"vardef(fclamp) =       ;'Clamp frequency signal at power limit: 0=no, 1=yes'";;;limfix(H)        = [0,)    ! H >= 0 (0 => no inertia => no response);limfix(Tf)       = (0,)    ! Tf > 0;limfix(fn)       = (0,)    ! fn > 0;limfix(dPlimdyn) = [0,1]   ! 0 <= dPlimdyn <= 1;limfix(dPmin)    = (,0)    ! dPmin < 0;limfix(dPmax)    = (0,)    ! dPmax > 0;limfix(fclamp)   = [0,1]   ! 0 <= fclamp <= 1;;;inc(fclamp) = 1;;df  = selfix(Tf>0, (f-xf)/selfix_const(Tf>0,Tf,1.0), 0.0);xf. = df;speed = limstate(xf, selfix(fclamp, f+selfix(dPlimdyn,max(dPmin,min(dPmarge_down,dPmax)),dPmin)*Tf*fn/(2*H), -999999), selfix(fclamp, f+selfix(dPlimdyn,min(dPmax,max(dPmarge_up,dPmin)),dPmax)*Tf*fn/(2*H), 999999))/fn;;dP = lim(-2*H*df/fn, selfix(dPlimdyn,max(dPmin,min(dPmarge_down,dPmax)),dPmin), selfix(dPlimdyn,min(dPmax,max(dPmarge_up,dPmin)),dPmax));!dP = -2*H * df/fn;!df/dt = -dP/Pn * fn/Ta   = -dP/Pn * fn/(2*H);!dP/Pn = -df/dt / (fn/Ta) = -df/dt / (fn/(2*H));;!inc0(f) = fn;inc(xf)  = f;inc(dP)  = 0.0;;inc0(dPmarge_up)   =  999999;inc0(dPmarge_down) = -999999;;outfix(dPlimdyn>0.5 .and. {dPmarge_up>999990 .or. dPmarge_down<-999990}, 'Dynamic power limitation is enabled, but no power margin signal from active power controller received. Dynamic power limitation is not effective, only fixed additional power limits apply.');;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;0;;0;;dP;f,fn;xf;H,Tf,dPlimdyn;speed,df,fclamp
  20;C;V_f Control BlkDef;286;0;6;1;Vac_max,dVac_ref_max,Vconv_max,dfmax,ROCOFmax;0;;1;dVac_ref_min,Vconv_min,dfmin;0;;1;uconv_r,uconv_i,cosref,sinref;1;usp_loc_inst,i_loc,uac_ref,Q_loc,Q_poc,mode_uac_droop_cmd,uac_loc,uac_poc,P,P_ref,mode_f_droop_cmd,mode_f_mapping_cmd,f_remote,fn_remote,fref,phi0;1;xi,xd,xoc,xphi_t;1;poc,gradlim_Vref,Mode_Vac_Droop,Dvac,Kp,Ki,Kd,Td,i_max,Rseries,Xseries,Kp_oc,Ki_oc,fn,Mode_f_Mapping,Mode_f_Droop,Df,Vmin_df;1;yp,yi,yd,dxd,freeze_xi,udrop_max,overcurrent,phi_t,phi,freeze_df,Dvac_Q,Q,dP,df,df_droop,df_droop_neg,df_ltd,duac,f,uac,uac_ref_droop,uac_ref_limtd,uac_ref_ltd,uconv,uconv_max,uconv_min;146;df_droop=-df_droop_neg;overcurrent=max(abs(i_loc)-i_max,0.0);xoc.=Ki_oc*(abs(i_loc)-i_max);udrop_max=(i_max-lim_const(Kp_oc*overcurrent+limstate_const(xoc,0.0,i_max-0.0005),0.0,i_max-0.0005))*sqrt(sqr(Rseries/100)+sqr(Xseries/100));uconv_max=usp_loc_inst+max(0.0,udrop_max);uconv_min=usp_loc_inst-max(0.0,udrop_max);inc(mode_uac_droop_cmd)=Mode_Vac_Droop;Dvac_Q=select(mode_uac_droop_cmd,Dvac*Q,0);inc(mode_f_droop_cmd)=Mode_f_Droop;df_droop_neg=select(mode_f_droop_cmd,Df*dP,0);inc(mode_f_mapping_cmd)=Mode_f_Mapping;f=select(mode_f_mapping_cmd,f_remote*fn/fn_remote,df_ltd+fn);df=select(mode_f_mapping_cmd,f_remote*fn/fn_remote-fn,df_ltd);inc(f)=fn;inc(df)=0;inc(freeze_df)=selfix_const(uac<Vmin_df,1,0);freeze_df=picdro_const(Vmin_df-uac+0.5,0.001,0.001);df_ltd=select(freeze_df,lastvalue(df_ltd),gradlim_const(lim_const(select(freeze_df,0.0,df_droop),dfmin,dfmax),-ROCOFmax,ROCOFmax));uac_ref_ltd=selfix(gradlim_Vref,gradlim_const(selfix(gradlim_Vref,uac_ref_droop,0),dVac_ref_min/100,dVac_ref_max/100),uac_ref_droop);Q=selfix(poc,Q_poc,Q_loc);uac=selfix(poc,uac_poc,uac_loc);uac_ref_limtd=lim_const(uac_ref_ltd,0,Vac_max);uconv_r=uconv*cosref;uconv_i=uconv*sinref;inc(phi0)=selfix(sinref>=0,acos(cosref),-acos(cosref));inc(xphi_t)=0;xphi_t.=selfix(rms(),twopi()*(df+fn*(1.0-fref)),twopi()*f);phi_t=modulo(xphi_t+pi(),twopi())-pi();phi=modulo((phi_t+phi0)+pi(),twopi())-pi();cosref=cos(phi);sinref=sin(phi);yp=Kp*duac;limfix(Td)=[0,);dxd=selfix(Td>0,(duac-xd)/Td,0);xd.=dxd;yd=dxd*Kd;freeze_xi=flipflop({{lastvalue(xi)>=Vconv_max}.and.{duac*Ki>0}}.or.{{lastvalue(xi)<=Vconv_min}.and.{duac*Ki<0}},{{lastvalue(xi)<Vconv_max}.or.{{lastvalue(xi)>=Vconv_max}.and.{duac*Ki<0}}}.and.{{lastvalue(xi)>Vconv_min}.or.{{lastvalue(xi)<=Vconv_min}.and.{duac*Ki>0}}});xi.=select(freeze_xi,0.0,duac*Ki);yi=lim_const(xi,Vconv_min,Vconv_max);uconv=lim(yp+yi+yd,max(Vconv_min,min(uconv_min,Vconv_max,(uconv_min+uconv_max)/2)),min(Vconv_max,max(uconv_max,Vconv_min,(uconv_min+uconv_max)/2)));duac=uac_ref_limtd-uac;uac_ref_droop=uac_ref-Dvac_Q;dP=-P_ref+P;"vardef(poc)=;'Vac controlled at: 0 = local terminal, 1 = PoC'";"vardef(Kp)=;'Vac controller gain proportional part'";"vardef(Ki)=;'Vac controller gain integration part'";"vardef(Kd)=;'Vac controller gain derivative part'";"vardef(Td)='s';'Vac controller time constant derivative part'";"vardef(Mode_Vac_Droop)=;'Vac droop control: 0 = off, 1 = on'";"vardef(Dvac)='p.u./p.u.';'Gain for Vac droop control, Vac(Q)'";"vardef(gradlim_Vref)=;'Vac reference gradient limiter: 0 = off, 1 = on'";"vardef(dVac_ref_min)='%/s';'Min. rate of change of Vac reference'";"vardef(dVac_ref_max)='%/s';'Max. rate of change of Vac reference'";"vardef(fn)='Hz';'Nominal frequency'";"vardef(Mode_f_Mapping)=;'Frequency mapping: 0 = off, 1 = on'";"vardef(Mode_f_Droop)=;'Frequency droop control: 0 = off, 1 = on'";"vardef(Df)='Hz/p.u.';'Gain for frequency droop control, f(P)'";"vardef(dfmin)='Hz';'Minimum frequency deviation (neg. value)'";"vardef(dfmax)='Hz';'Maximum frequency deviation (pos. value)'";"vardef(ROCOFmax)='Hz/s';'Maximum rate of change of frequency'";"vardef(Vmin_df)='p.u.';'Minimum voltage for frequency droop'";"vardef(Vconv_max)='p.u.';'Maximum internal converter voltage'";"vardef(Vconv_min)='p.u.';'Minimum internal converter voltage'";"vardef(Vac_max)='p.u.';'Maximum terminal voltage'";"vardef(i_max)='p.u.';'Maximum current'";"vardef(Rseries)='%';'Series resistance'";"vardef(Xseries)='%';'Series reactance'";"vardef(Kp_oc)=;'Proportional gain overcurrent limiter'";"vardef(Ki_oc)=;'Integral gain overcurrent limiter'";"vardef(usp_loc_inst)='p.u.';'Local AC voltage, space phasor magnitude'";"vardef(uac_loc)='p.u.';'AC voltage magnitude (measurement at local terminal)'";"vardef(uac_poc)='p.u.';'AC voltage magnitude (measurement at PoC)'";"vardef(uac)='p.u.';'AC voltage magnitude (selected measurement)'";"vardef(uac_ref)='p.u.';'AC voltage magnitude reference signal'";"vardef(uac_ref_droop)='p.u.';'AC voltage reference signal with droop'";"vardef(uac_ref_ltd)='p.u.';'AC voltage reference signal (rate of change limited)'";"vardef(i_loc)='p.u.';'AC current magnitude (at local terminal)'";"vardef(Q_loc)='p.u.';'Reactive power (measurement at local terminal)'";"vardef(Q_poc)='p.u.';'Reactive power (measurement at PoC)'";"vardef(Q)='p.u.';'Reactive power (selected measurement)'";"vardef(P)='p.u.';'Active power'";"vardef(P_ref)='p.u.';'Active power reference signal'";"vardef(dP)='p.u.';'Active power deviation'";"vardef(df)='Hz';'Frequency deviation'";"vardef(f_remote)='Hz';'Frequency remote input signal'";"vardef(fn_remote)='Hz';'Nominal frequency of remote system'";"vardef(f)='Hz';'Frequency'";"vardef(df)='Hz';'Frequency deviation'";"vardef(df_droop)='Hz';'Frequency deviation from droop control'";"vardef(fref)='p.u.';'Frequency of reference machine (RMS simulation)'";"vardef(phi0)='rad';'Initial oscillator angle'";"vardef(phi_t)='rad';'Time-dependent part of oscillator angle'";"vardef(phi)='rad';'Oscillator angle'";"vardef(cosref)=;'Cosine of oscillator angle'";"vardef(sinref)=;'Sine of oscillator angle'";"vardef(mode_uac_droop_cmd)=;'Vac droop command signal: 0 = off, 1 = on'";"vardef(mode_f_droop_cmd)=;'Frequency droop command signal: 0 = off, 1 = on'";"vardef(mode_f_mapping_cmd)=;'Frequency mapping command signal: 0 = off, 1 = on'";"vardef(uconv)='p.u.';'Converter voltage reference'";"