_Droop.and.Mode_Q_Droop_Db,picdro(Vac_droop_min_db-uac+0.5,selfix(Mode_Q_Droop.and.Mode_Q_Droop_Db,0.0,999999.),0.0),0);Dq_vac=selfix(Mode_Q_Droop,selfix(Mode_Q_Droop_Db,select(over_droop_db,(uac-Vac_droop_max_db)*Dq,select(under_droop_db,(uac-Vac_droop_min_db)*Dq,0)),(uac-uac_ref_ltd)*Dq),0);inc(over_droop_db)=0;inc(under_droop_db)=0;inc(Dq_vac)=selfix(Mode_Q_Droop,selfix(Mode_Q_Droop_Db,0,(uac-uac_ref_ltd)*Dq),0);Dvac_Q=selfix(Mode_Vac_Droop,Dvac*Q,0);Q_ref_ltd=selfix(gradlim_Qref,gradlim_const(selfix(gradlim_Qref,Q_ref,0),dQ_ref_min/100,dQ_ref_max/100),Q_ref);uac_ref_ltd=selfix(gradlim_Vref,gradlim_const(selfix(gradlim_Vref,uac_ref,0),dVac_ref_min/100,dVac_ref_max/100),uac_ref);Qpf_ref_ltd=selfix(gradlim_pfref,gradlim_const(selfix(gradlim_pfref,Qpf_ref,0),dQ_ref_min/100,dQ_ref_max/100),Qpf_ref);ref=select(mode_Q>1.5,Qpf_ref_ltd,select(mode_Q>0.5,Q_ref_droop,uac_ref_droop));delta=select(mode_Q>1.5,delta_Qpf,select(mode_Q>0.5,delta_Q,delta_Vac));P=selfix(poc_Q,P_poc,P_loc);Q=selfix(poc_Q,Q_poc,Q_loc);uac=selfix(poc_Vac,uac_poc,uac_loc);inc(mode_Q_cmd)=selfix(Mode_Q>1.5,2,selfix(Mode_Q>0.5,1,0));mode_Q=mode_Q_cmd;iQ_ref=select(block,0.0,select(mode_Q>0.5,yref_out_gradlim/selfix(Mode_Vadp,max(uac_loc,Vac_min),1.0),yref_out_gradlim));yref_out_gradlim=select(mode_Q,selfix(gradlim_OutQ,gradlim_const(selfix(gradlim_OutQ,yref_out,0),dOutQ_min/100,dOutQ_max/100),yref_out),selfix(gradlim_OutVac,gradlim_const(selfix(gradlim_OutVac,yref_out,0),dOutVac_min/100,dOutVac_max/100),yref_out));sign_Qpf=select(pf_dir,-1,1);Qpf_ref=select(abs(pf_ref)<0.01,Q_ref,sign_Qpf*abs(P)*tan(acos(lim_const(min(abs(pf_ref),1.00),0.01,1.00))));S=sqrt(max(0.0,sqr(P)+sqr(Q)));pf=max(0.0,min(1.0,abs(P/max(0.00000001,S))));delta_Vac=uac_ref_droop-uac;delta_Q=Q_ref_droop-Q;uac_ref_droop=uac_ref_ltd-Dvac_Q;Q_ref_droop=Q_ref_ltd+dQ_pod-Dq_vac;delta_Qpf=-Q+Qpf_ref_ltd+dQ_pod;"vardef(Mode_Q)=;'Control mode: 0 = Vac, 1 = Q, 2 = power factor'";"vardef(Mode_Vadp)=;'Adapt current ref. output to AC voltage: 0=no, 1=yes'";"vardef(poc_Vac)=;'Vac controlled at: 0 = local terminal, 1 = PoC'";"vardef(poc_Q)=;'Q controlled at: 0 = local terminal, 1 = PoC'";"vardef(gradlim_Vref)=;'Vac reference gradient limiter: 0 = off, 1 = on'";"vardef(gradlim_Qref)=;'Q reference gradient limiter: 0 = off, 1 = on'";"vardef(gradlim_pfref)=;'Power factor ref. grad. limiter: 0=off, 1=on'";"vardef(dVac_ref_min)='%/s';'Min. rate of change of Vac reference'";"vardef(dVac_ref_max)='%/s';'Max. rate of change of Vac reference'";"vardef(dQ_ref_min)='%/s';'Min. rate of change of Q reference'";"vardef(dQ_ref_max)='%/s';'Max. rate of change of Q reference'";"vardef(Ctrl_Q)=;'Q ctrl. type: 0 = PI, 1 = I with prop. ref. feed-forward'";"vardef(Kp_Q)=;'Reactive power controller proportional gain'";"vardef(Ki_Q)=;'Reactive power controller integrator gain'";"vardef(Kp_Vac)=;'AC voltage controller proportional gain'";"vardef(Ki_Vac)=;'AC voltage controller integrator gain'";"vardef(Q_max)='p.u.';'Maximum reactive power (positive value)'";"vardef(Q_min)='p.u.';'Minimum reactive power (negative value)'";"vardef(iQ_max)='p.u.';'Maximum reactive current (Vac control)'";"vardef(gradlim_OutQ)=;'Q ctrl. output gradient limiter: 0=off, 1=on'";"vardef(dOutQ_min)='%/s';'Min. rate of change of Q ctrl. output'";"vardef(dOutQ_max)='%/s';'Max. rate of change of Q ctrl. output'";"vardef(gradlim_OutVac)=;'Vac ctrl. output gradient limiter: 0=off, 1=on'";"vardef(dOutVac_min)='%/s';'Min. rate of change of Vac ctrl. output'";"vardef(dOutVac_max)='%/s';'Max. rate of change of Vac ctrl. output'";"vardef(Vac_min)='p.u.';'Min. local steady-state operating voltage'";"vardef(Mode_Vac_Droop)=;'Vac droop control, Vac(Q): 0=off, 1=on'";"vardef(Dvac)='p.u./p.u.';'Gain for Vac droop control, Vac(Q)'";"vardef(Mode_Q_Droop)=;'Q droop ctrl., Q(Vac): 0 = off, 1 = on'";"vardef(Mode_Q_Droop_Db)=;'Q droop ctrl. deadband: 0=off; 1=on'";"vardef(Dq)='p.u./p.u.';'Gain for Q droop control, Q(Vac)'";"vardef(Vac_droop_max_db)='p.u.';'Upper deadband Q droo