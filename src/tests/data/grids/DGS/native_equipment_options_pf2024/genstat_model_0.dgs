2-FXVD_dVTS1)*MX_Q/FX_QMAX_VD)),((MX_V+FXVD_dVTS1)/(1-(FXVD_dVTS2-FXVD_dVTS1)*MX_Q/FX_QMAX_VD)))),0.8,1.2);;inc(Vbase_VDPID)=lim_const(selfix(abs(MX_Q)<=0.001,MX_V,selfix(MX_Q>=0.001,((MX_V+FXVD_dVTS1)/(1-(FXVD_dVTS2-FXVD_dVTS1)*(MX_Q/FX_QMAX_VD))),((MX_V-FXVD_dVTS1)/(1-(FXVD_dVTS2-FXVD_dVTS1)*(MX_Q/FX_QMAX_VD))))),0.8,1.2);;"inc(xfp)=QTOT_INV     ";inc(SP_FPPID)=cos(atan(-(MX_Q/MX_P)));inc(FP_CONV)=selfix(MX_Q>=0,1,0);;inc(xq)=QTOT_INV;"inc(x_mx_q)=MX_Q  ";inc(SP_QPID)=MX_Q;;;"vardef(KP_QFPPID)='-';'Kp ctrl FP'";"vardef(KI_QFPPID)='-';'Ki ctrl FP'";"vardef(KP_QPID)='-';'Kp ctrl Q'";"vardef(KI_QPID)='-';'Ki ctrl Q'";"vardef(KP_QVPID)='-';'Kp ctrl QV'";"vardef(KI_QVPID)='-';'Ki ctrl QV'";"vardef(KP_VPID)='-';'Kp ctrl V'";"vardef(KI_VPID)='-';'Ki ctrl V'";"vardef(cM1)='p.u/Hz';'pendiente 1 control F'";"vardef(cM2)='p.u/Hz';'pendiente 2 control F'";"vardef(dT)='s';'cte tiempo ctrl F'";"vardef(cHzTrS1r)='[Hz]';'limite superior 1r'";"vardef(cHzTrI1r)='[Hz]';'limite inferior 1r'";"vardef(cHzTrS1)='[Hz]';'limite superior 1'";"vardef(cHzTrI1)='[Hz]';'limite inferior 1'";"vardef(cHzTrS2)='[Hz]';'limite superior 2'";"vardef(cHzTrI2)='[Hz]';'limite inferior 2'";"vardef(SPDEC_FPPID)='p.u.';'rampa decrecimiento ctrl FP'";"vardef(SPINC_FPPID)='p.u.';'rampa incremento ctrl FP'";"vardef(dT2)='s';'cte tiempo ctrl FP'";"vardef(SPDEC_PPID)='p.u.';'rampa decrecimiento P'";"vardef(SPINC_PPID)='p.u.';'rampa incremento P'";"vardef(SPDEC_QPID)='p.u.';'rampa decrecimiento ctrl Q'";"vardef(SPINC_QPID)='p.u.';'rampa incremento ctrl Q'";"vardef(dT3)='s';'cte tiempo ctrl Q'";"vardef(SPDEC_VPID)='p.u.';'rampa decrecimiento ctrl V'";"vardef(SPINC_VPID)='p.u.';'rampa incremento ctrl V'";"vardef(dT1)='s';'cte tiempo ctrl V'";"vardef(KP_PPID)='-';'Kp ctrl P'";"vardef(KI_PPID)='-';'Ki ctrl P'";"vardef(OFFSET_WIN_PPID)='p.u.';'offset P'";"vardef(OFFSET_RATE_PPID)='p.u./s';'offset P rate'";"vardef(Tp)='s';'retardo medicion P'";"vardef(Tq)='s';'retardo medicion Q'";"vardef(Tv)='s';'retardo medicion V'";"vardef(Tg)='s';'retardo envio señal P a inversores'";"vardef(MODO_Q)='0/1/2/3';'modo de control Q'";"vardef(FXVD_dVTS1)='[p.u.]';'banda muerta superior control VQ'";"vardef(FXVD_dVTS2)='[p.u.]';'saturacion limite superior control VQ'";"vardef(FXVD_dVTI1)='[p.u.]';'banda muerta inferior control VQ'";"vardef(FXVD_dVTI2)='[p.u.]';'saturacion limite inferior control VQ'";"vardef(FX_QMIN_VD)='[p.u.]';'Minimo aporte reactivo reactivo control VQ'";"vardef(FX_QMAX_VD)='[p.u.]';'Maximo aporte reactivo reactivo control VQ'";"vardef(Vbase_VDPID)='[p.u.]';'Vref del control VQ'";"vardef(Tft)='s';'retardo envio señal Q a inversores'";"vardef(Tfv)='s';'limite derivada envio Q a inversores'";"vardef(PPC_QMIN)='p.u.';'minima Q inversores'";"vardef(PPC_SP_QMIN)='p.u.';'minima Q POI'";"vardef(VMIN)='s';'tension minima'";"vardef(PPC_SP_PMIN)='p.u.';'minima P POI'";"vardef(PPC_PMIN)='p.u.';'minima P POI'";"vardef(PPC_QMAX)='p.u.';'maxima Q inversores'";"vardef(PPC_SP_QMAX)='p.u.';'maxima Q POI'";"vardef(VMAX)='Hz';'tension maxima'";"vardef(PPC_SP_PMAX)='p.u.';'maxima P POI'";"vardef(PPC_PMAX)='p.u.';'maxima P inverosres'";"vardef(MODO_VQ)='0/1';'Modo ctrl VQ simulado/real'";;0;0;1;PTOT_INV,QTOT_INV;1;DESHAB_FCOR,MX_F,SP_PPID,MX_P,Vbase_VDPID,MX_V,SP_VPID,FP_CONV,SP_FPPID,MX_Q,SP_QPID;1;xfp,xq,xqv,xv,xp,x_mx_p,x_mx_q,x_mx_v,x_ptot,x_qtot;1;KP_QFPPID,KI_QFPPID,KP_QPID,KI_QPID,KP_QVPID,KI_QVPID,KP_VPID,KI_VPID,cM1,cM2,dT,cHzTrS1r,cHzTrI1r,cHzTrS1,cHzTrI1,cHzTrS2,cHzTrI2,SPDEC_FPPID,SPINC_FPPID,dT2,SPDEC_PPID,SPINC_PPID,SPDEC_QPID,SPINC_QPID,dT3,SPDEC_VPID,SPINC_VPID,dT1,KP_PPID,KI_PPID,OFFSET_WIN_PPID,OFFSET_RATE_PPID,Tp,Tq,Tv,Tg,MODO_Q,FXVD_dVTS1,FXVD_dVTS2,FXVD_dVTI1,FXVD_dVTI2,FX_QMIN_VD,FX_QMAX_VD,Tft,Tfv,MODO_VQ;1;acM1,acM2,MX_F_OLD,FlagS,FlagI,SP_OFFSET_F_OLD,cDec2,cInc2,SP_FPPID_OLD,cDec,cInc,SP_PPID_OLD,cDec3,cInc3,SP_QPID_OLD,cDec1,cInc1,SP_VPID_OLD,oYmax,oYmin,pvs,pvi,E_P,cRate,oYmin_LIM_OLD,oYmax_LIM_OLD,oYmin_LIM,oYmax_LIM,cM3,cM4,VTrS1,VTrS2,VTrI1,VTrI2,dx,E_Q,E_QFP,E_QV,E_V,