  10;C;Droop Q(Vmed);287;0;4;0;;0;0;;0;1;SP_QVPID;1;Vbase_VDPID,MX_V_FILT;0;;1;FXVD_dVTS1,FXVD_dVTS2,FXVD_dVTI1,FXVD_dVTI2,FX_QMIN_VD,FX_QMAX_VD;1;cM1,cM2,VTrS1,VTrS2,VTrI1,VTrI2;27;;;VTrS1= Vbase_VDPID+ abs(FXVD_dVTS1);VTrS2= Vbase_VDPID+ abs(FXVD_dVTS2);VTrI1= Vbase_VDPID- abs(FXVD_dVTI1);VTrI2= Vbase_VDPID- abs(FXVD_dVTI2);;cM1=select(abs(VTrS2-VTrS1)> 0.0001,;& -1.0*abs(FX_QMIN_VD/((VTrS2-VTrS1)*Vbase_VDPID)),;& 0);;cM2=select(abs(VTrI2-VTrI1)> 0.0001,;& -1.0*abs(FX_QMAX_VD/((VTrI2-VTrI1)*Vbase_VDPID)),;& 0);;SP_QVPID_RAW=select({MX_V_FILT <= VTrS1}.and.{MX_V_FILT >= VTrI1},;& 0,;& select({MX_V_FILT > VTrS1}.and.{MX_V_FILT <= VTrS2},;& cM1*(MX_V_FILT-VTrS1),;& select(MX_V_FILT > VTrS2,;& FX_QMIN_VD,;& select({MX_V_FILT > VTrI2} .and. {MX_V_FILT <= VTrI1},;& cM2*(MX_V_FILT-VTrI1),;& FX_QMAX_VD))));;SP_QVPID=lim(SP_QVPID_RAW,FX_QMIN_VD,FX_QMAX_VD);;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;0;0;1;SP_QVPID;1;Vbase_VDPID,MX_V_FILT;0;;1;FXVD_dVTS1,FXVD_dVTS2,FXVD_dVTI1,FXVD_dVTI2,FX_QMIN_VD,FX_QMAX_VD;1;cM1,cM2,VTrS1,VTrS2,VTrI1,VTrI2
