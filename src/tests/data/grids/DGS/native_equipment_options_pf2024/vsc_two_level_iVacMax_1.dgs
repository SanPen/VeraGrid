  32;C;Synchroniser;838;0;4;0;;0;;0;;0;1;Close,dud,duq,Hold,ReConn;1;ub,ubr,ubi,ugr,ugi,CrowBar,Tripped;0;;1;MaxSynchTime,CloseDelay,Tcrow,Usynch,Reconnect,TripIfCrow;1;cosub,sinub,ugd,ugq,Allow;34;Allow = picdro(CrowBar .and. Reconnect, Tcrow-0.005, MaxSynchTime);cosub = ubr/ub;sinub = ubi/ub;;ugd =  ugr*cosub + ugi*sinub;ugq = -ugr*sinub + ugi*cosub;;dud = -ugq*10;duq = (ugd-ub)*10;;Hold = flipflop(CrowBar .and. TripIfCrow, {.not. CrowBar }.and.{ub>Usynch});!Hold = picdro(CrowBar .and. ub<Usynch, 0, 0.04);;!Check = sqrt(sqr(dud)+sqr(duq))/10;Close = picdro(abs(dud/10)<0.01 .and. abs(duq/10)<0.01 .and. Allow .and. ub>Usynch, CloseDelay, 0.1);;!Event to set to synch mode;event({Reconnect .and. Tripped}, ub-Usynch, 'name=SynchModeOn dtime=0');;!Events to close generator breaker & reset controls to normal;event(Allow, Close-0.5,'name=CloseBreaker dtime=0');"event(Allow, Close-0.5,'name=SynchModeOff dtime=0')    ";;!Send reconnect to over current/speed/voltage block;inc(ReConn)=0;ReConn = select(Allow .and. (Close-0.5)>0,1,0);;inc(Allow) = 0;inc(cosub) = ubr/ub;inc(sinub) = ubi/ub;inc(Close) = 0;inc(Hold)  = 0;!inc(Check) = sqrt(sqr(dud)+sqr(duq));;;;;;;0;0;1;Close,dud,duq,Hold,ReConn;1;ub,ubr,ubi,ugr,ugi,CrowBar,Tripped;0;;1;MaxSynchTime,CloseDelay,Tcrow,Usynch,Reconnect,TripIfCrow;1;cosub,sinub,ugd,ugq,Allow
