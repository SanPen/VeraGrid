age,PmvLim_crit,PmvLim_discharge,Pmax_dyn,PmvLim_charge,PlantEff,inv_PlantEff,inv_k_eff_trafo,k_eff_trafo,Xtrafo_pu;1;FRT_neg_flag1,FRT_neg_flag2,FRT_pos_flag1,FRT_pos_flag2,Id_max,Id_max1,Id_min,Id_min1,Idneg_max,Idneg_min,Imax1,Imax2,Imax3,Imax4,ImaxCapacitive,ImaxCapacitive1,ImaxInductive,ImaxInductive1,Imaxn,Imaxp,Iq_max,Iq_max1,Iq_min,Iq_min1,Iqneg_max,Iqneg_min,QPCChigh,QPCClow,Qref12,VdcRef1,Vpcc1,Vpcc2,id_neg,id_unsat,idneg1,idpos_sat1,inv_Vpcc,inv_Vpcc1,inv_vpcc,iq_neg,iq_unsat,iqneg1,iqpos_sat1,reactive_reserve,reactive_reserve1,reactive_reserve2,vMV_pos_mode
  30;C;Capability_block;1025;0;7;0;;0;;0;;0;;1;QMV_capab_high,QMV_capab_low,PMV_capab_high,PMV_capab_low,id_pos_sat,iq_pos_sat,id_neg_sat,iq_neg_sat;1;idpos,iqpos,vdpos,vqpos,idneg,iqneg,vdneg,vqneg,vPCC_pos_mag,FRT_pos_flag,FRT_neg_flag,Qlim_cap,Qlim_ind,Qref_in;0;;1;inv_Xtrafo_Lout_pu, MaxAuxiliaryVoltage, MaxTransfoFluxVoltage,inv_Xtrafo_pu, MinAuxiliaryVoltage,PmvLim_crit,PmvLim_discharge,Pmax_dyn,PmvLim_charge,PlantEff,inv_PlantEff,inv_k_eff_trafo,k_eff_trafo,Xtrafo_pu,Imax,VdcRef;1;FRT_neg_flag1,FRT_neg_flag2,FRT_pos_flag1,FRT_pos_flag2,Id_max,Id_max1,Id_min,Id_min1,Idneg_max,Idneg_min,Imax1,Imax2,Imax3,Imax4,ImaxCapacitive,ImaxCapacitive1,ImaxInductive,ImaxInductive1,Imaxn,Imaxp,Iq_max,Iq_max1,Iq_min,Iq_min1,Iqneg_max,Iqneg_min,QPCChigh,QPCClow,Qref,VdcRef1,Vpcc1,Vpcc2,id_neg,id_unsat,idneg1,idpos_sat1,inv_Vpcc,inv_Vpcc1,inv_vpcc,iq_neg,iq_unsat,iqneg1,iqpos_sat1,reactive_reserve,reactive_reserve1,reactive_reserve2,vMV_pos_mode,FRT_neg_flag112,FRT_pos_flag112,Imax112,PMVhigh,PMVlow,Paw,QMVhigh,QMVlow,Qaw,Qlim_cap1,Qlim_ind1,Qref112,VMVhigh,VMVlow,VPOS,VdcRef112,Vpcc,ang,ang1,ang2,ang3,ang4,ang_pos,d,d1,d2,d3,d4,d5,flag_crit_cond_high,flag_crit_cond_low,iactneg_nosat,iactneg_sat,iactpos_nosat,iactpos_sat,idMVhigh,idMVlow,idneg112,idneg_cap_max,idneg_cap_min,idnosat,idpos1,idpos_sat,idsat,iqMVhigh,iqMVlow,iqneg112,iqneg_cap_max,iqneg_cap_min,iqnosat,iqpos1,iqpos_sat,iqsat,ireactneg_nosat,ireactneg_sat,ireactpos_nosat,ireactpos_sat,o1,o2,o3,o4,o5,o7,o8,q,q1,q2,q3,q4,q5,vMV_pos_mode1,vmag_pos,y_max,y_max1,y_max2,y_max3,y_min,y_min1,y_min2,y_min3,yi,yi10,yi11,yi12,yi13,yi14,yi15,yi16,yi17,yi18,yi2,yi3,yi4,yi5,yi6,yi7,yi8,yi9;7;inc(idpos) = id_pos_sat;inc(iqpos) = iq_pos_sat;inc(idneg) = id_neg_sat;inc(iqneg) = iq_neg_sat;;inc(Qref_in) = 0;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;0;0;1;QMV_capab_high,QMV_capab_low,PMV_capab_high,PMV_capab_low,id_pos_sat,iq_pos_sat,id_neg_sat,iq_neg_sat;1;idpos,iqpos,vdpos,vqpos,idneg,iqneg,vdneg,vqneg,vPCC_pos_mag,FRT_pos_flag,FRT_neg_flag,Qlim_cap,Qlim_ind,Qref_in;0;;1;inv_Xtrafo_Lout_pu, MaxAuxiliaryVoltage, MaxTransfoFluxVoltage,inv_Xtrafo_pu, MinAuxiliaryVoltage,PmvLim_crit,PmvLim_discharge,Pmax_dyn,PmvLim_charge,PlantEff,inv_PlantEff,inv_k_eff_trafo,k_eff_trafo,Xtrafo_pu,Imax,VdcRef;1;FRT_neg_flag1,FRT_neg_flag2,FRT_pos_flag1,FRT_pos_flag2,Id_max,Id_max1,Id_min,Id_min1,Idneg_max,Idneg_min,Imax1,Imax2,Imax3,Imax4,ImaxCapacitive,ImaxCapacitive1,ImaxInductive,ImaxInductive1,Imaxn,Imaxp,Iq_max,Iq_max1,Iq_min,Iq_min1,Iqneg_max,Iqneg_min,QPCChigh,QPCClow,Qref,VdcRef1,Vpcc1,Vpcc2,id_neg,id_unsat,idneg1,idpos_sat1,inv_Vpcc,inv_Vpcc1,inv_vpcc,iq_neg,iq_unsat,iqneg1,iqpos_sat1,reactive_reserve,reactive_reserve1,reactive_reserve2,vMV_pos_mode,FRT_neg_flag112,FRT_pos_flag112,Imax112,PMVhigh,PMVlow,Paw,QMVhigh,QMVlow,Qaw,Qlim_cap1,Qlim_ind1,Qref112,VMVhigh,VMVlow,VPOS,VdcRef112,Vpcc,ang,ang1,ang2,ang3,ang4,ang_pos,d,d1,d2,d3,d4,d5,flag_crit_cond_high,flag_crit_cond_low,iactneg_nosat,iactneg_sat,iactpos_nosat,iactpos_sat,idMVhigh,idMVlow,idneg112,idneg_cap_max,idneg_cap_min,idnosat,idpos1,idpos_sat,idsat,iqMVhigh,iqMVlow,iqneg112,iqneg_cap_max,iqneg_cap_min,iqnosat,iqpos1,iqpos_sat,iqsat,ireactneg_nosat,ireactneg_sat,ireactpos_nosat,ireactpos_sat,o1,o2,o3,o4,o5,o7,o8,q,q1,q2,q3,q4,q5,vMV_pos_mode1,vmag_pos,y_max,y_max1,y_max2,y_max3,y_min,y_min1,y_min2,y_min3,yi,yi10,yi11,yi12,yi13,yi14,yi15,yi16,yi17,yi18,yi2,yi3,yi4,yi5,yi6,yi7,yi8,yi9
  31;C;Fault Detection;1025;0;7;0;;0;;0;;0;;1;FRT1_flag,FRT2_flag;1;V1pcc,V2pcc;0;;1;V1min,V1max,V2min,V2max;1;s,r,s1,r1;8;!==============================================================;! Initialization;!==============================================================;;inc(FRT1_flag) = 0;inc(FRT2_flag) = 0;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;0;0;1;FRT1_flag,FRT2_flag;1;V1pcc,V2pcc;0;;1;V1min,V1max,V2min,V2max;1;s,r,s1,r1
  32;C;First_Order_Response_out1;1025;0;7;0;;0;;0;;0;;1;id_pos_ref_sat_out,iq_pos_ref_sat_out,id_neg_ref_sat_out,iq_neg_ref_sat_out;1;id_pos_ref_sat,iq_pos_ref_sat,id_neg_ref_sat,iq_neg_ref_sat;1;st_id_pos_ref_sat,st_iq_pos_ref_sat,st_id_neg_ref_sat,st_iq_neg_ref_sat;1;tau;0;;37;!=========================================;! Equations - LPF_out;!=========================================;;! 1. Ecuaciones Diferenciales (Dinámica del filtro);!    dx/dt = (Input - x) / tau;st_id_pos_ref_sat .= (id_pos_ref_sat - st_id_pos_ref_sat) / tau;st_iq_pos_ref_sat .= (iq_pos_ref_sat - st_iq_pos_ref_sat) / tau;;st_id_neg_ref_sat .= (id_neg_ref_sat - st_id_neg_ref_sat) / tau;st_iq_neg_ref_sat .= (iq_neg_ref_sat - st_iq_neg_ref_sat) / tau;;! 2. Asignación de Salidas;!    La salida es igual al estado interno del filtro;id_pos_ref_sat_out = st_id_pos_ref_sat;iq_pos_ref_sat_out = st_iq_pos_ref_sat;;id_neg_ref_sat_out = st_id_neg_ref_sat;iq_neg_ref_sat_out = st_iq_neg_ref_sat;;!=========================================;! Initialization - LPF_out (VERSIÓN FINAL);!=========================================;;! 1. Inicializamos los ESTADOS internos con el valor de la entrada;inc(st_id_pos_ref_sat) = id_pos_ref_sat;inc(st_iq_pos_ref_sat) = iq_pos_ref_sat;inc(st_id_neg_ref_sat) = id_neg_ref_sat;inc(st_iq_neg_ref_sat) = iq_neg_ref_sat;;! 2. Inicializamos las SALIDAS explícitamente (Para matar el error);! Les decimos que valgan lo mismo que la entrada.;inc(id_pos_ref_sat_out) = id_pos_ref_sat;inc(iq_pos_ref_sat_out) = iq_pos_ref_sat;inc(id_neg_ref_sat_out) = id_neg_ref_sat;inc(iq_neg_ref_sat_out) = iq_neg_ref_sat;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;0;0;1;id_pos_ref_sat_out,iq_pos_ref_sat_out,id_neg_ref_sat_out,iq_neg_ref_sat_out;1;id_pos_ref_sat,iq_pos_ref_sat,id_neg_ref_sat,iq_neg_ref_sat;1;st_id_pos_ref_sat,st_iq_pos_ref_sat,st_id_neg_ref_sat,st_iq_neg_ref_sat;1;tau;0;
  33;C;Islanding;1025;0;7;0;;0;;0;;0;;1;ed,eq,grid_alive;1;ed_in,eq_in;0;;1;P_gridAlive;0;;14;!=========================================;! Equations (Funcionamiento normal);!=========================================;ed = select(P_gridAlive, ed_in, 1);eq = select(P_gridAlive, eq_in, 0);grid_alive = P_gridAlive;;!=========================================;! Initialization (t=0);!=========================================;inc(ed_in) = ed;inc(eq_in) = eq;;inc(grid_alive) = P_gridAlive;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;0;0;1;ed,eq,grid_alive;1;ed_in,eq_in;0;;1;P_gridAlive;0;
  34;C;PCC Measurements;1025;0;7;0;;0;;0;;0;;1;Ppcc,Qpcc,V1pcc,V2pcc,wpcc;1;uar,uai,ubr,ubi,ucr,uci,iar,iai,ibr,ibi,icr,ici,grid_alive;1;xw,xt;1;kp_pll,ki_pll,f1;1;u1r,u1i,u2r,u2i,u1d,u1q,u2d,u2q,w1,costheta,sintheta,Dw,theta;89;!================================================================================================;! Equations;!================================================================================================;;! Active power (CORREGIDO: Sin el 1/3);Ppcc_tot = (uar*iar + uai*iai + ubr*ibr + ubi*ibi + ucr*icr + uci*ici);Ppcc = Ppcc_tot;;! Reactive power (CORREGIDO: Sin el 1/3);Qpcc_tot = (uai*iar - uar*iai + ubi*ibr - ubr*ibi + uci*icr - ucr*ici);Qpcc = Qpcc_tot;;! Positive sequence voltages;u1r = (1/3)*(uar - (1/2)*ubr - (1/2)*ucr - sqrt(3)/2*ubi + sqrt(3)/2*uci);u1i = (1/3)*(uai - (1/2)*ubi - (1/2)*uci + sqrt(3)/2*ubr - sqrt(3)/2*ucr);;! Positive sequence currents;i1r = (1/3)*(iar - (1/2)*ibr - (1/2)*icr - sqrt(3)/2*ibi + sqrt(3)/2*ici);i1i = (1/3)*(iai - (1/2)*ibi - (1/2)*ici + sqrt(3)/2*ibr - sqrt(3)/2*icr);;! Negative sequence voltages;u2r = (1/3)*(uar - (1/2)*ubr - (1/2)*ucr + sqrt(3)/2*ubi - sqrt(3)/2*uci);u2i = (1/3)*(uai - (1/2)*ubi - (1/2)*uci - sqrt(3)/2*ubr + sqrt(3)/2*ucr);;! Negative sequence currents;i2r = (1/3)*(iar - (1/2)*ibr - (1/2)*icr + sqrt(3)/2*ibi - sqrt(3)/2*ici);i2i = (1/3)*(iai - (1/2)*ibi - (1/2)*ici - sqrt(3)/2*ibr + sqrt(3)/2*icr);;! Positive sequence voltages in dq;u1d =  u1r*costheta + u1i*sintheta;u1q = -u1r*sintheta + u1i*costheta;;! Negative sequence voltages in dq;u2d =  u2r*costheta - u2i*sintheta;u2q =  u2r*sintheta + u2i*costheta;;! Positive and negative sequence voltage amplitudes;V1pcc = sqrt(sqr(u1d) + sqr(u1q));V2pcc = sqrt(sqr(u2d) + sqr(u2q));;! Positive and negative sequence active powers;P1pcc = u1r*i1r + u1i*i1i;P2pcc = u2r*i2r + u2i*i2i;;! Positive and negative sequence reactive powers;Q1pcc = u1i*i1r - u1r*i1i;Q2pcc = u2i*i2r - u2r*i2i;;;! PLL frequency and phase;w1    = 2*pi()*f1;xw.   = select(grid_alive,u1q,0);Dw    = select(grid_alive,ki_pll*xw + kp_pll*u1q,0);xt.   = w1*Dw;wpcc  = 1 + Dw;theta = xt;;costheta = cos(theta);sintheta = sin(theta);;!================================================================================================;! Initialization;!================================================================================================;;! Active Power Initialization (CORREGIDO: Sin el 1/3);inc(Ppcc) = (uar*iar + uai*iai + ubr*ibr + ubi*ibi + ucr*icr + uci*ici);;! Reactive Power Initialization (CORREGIDO: Sin el 1/3);inc(Qpcc) = (uai*iar - uar*iai + ubi*ibr - ubr*ibi + uci*icr - ucr*ici);;;"inc(V1pcc) = sqrt(sqr(u1d) + sqr(u1q)) ";"inc(V2pcc) = sqrt(sqr(u2d) + sqr(u2q)) ";;inc(wpcc) = 1;;inc(xw) = 0;! Alineamos el PLL con el ángulo inicial del voltaje positivo;inc(xt) = atan2(u1i,u1r);;inc(grid_alive) = 0;;!================================================================================================;! Variable definition;!================================================================================================;;"vardef(kp_pll) = 'pu';'Proportional gain of the PLL PI controller'";"vardef(ki_pll) = 'pu/s';'Integral gain of the PLL PI controller'        ";"vardef(f1)     = 'pu';'Fundamental frequency of the system'";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;0;0;1;Ppcc,Qpcc,V1pcc,V2pcc,wpcc;1;uar,uai,ubr,ubi,ucr,uci,iar,iai,ibr,ibi,icr,ici,grid_alive;1;xw,xt;1;kp_pll,ki_pll,f1;1;u1r,u1i,u2r,u2i,u1d,u1q,u2d,u2q,w1,costheta,sintheta,Dw,theta
  35;C;Q/Vac droop;1025;0;5;1;y_max;0;;1;y_min;0;;1;Qref_out,ed,eq;1;Q_capab_high,Vref,V1pcc,Qref,Qpcc,Q_capab_low,i1q_hat,i1q_ref,FRT1_flag,ed_init_val;1;xQ,xV;1;ki_Q,tau_V,kd_V;1;s2,r,x0,int,diff,DV,FRT1_flag1,NoMoreNoLess,Vf,o1,o2,o6,o7,res,u1,u2,x_init,yi1,yi2,yi3,yi4,yi5,yi6;31;!================================================================================================;! Initialization;!================================================================================================;;! 1. Inicialización de Voltajes (Referencia y Filtros);! Arrancamos asumiendo que el voltaje actual es el deseado para evitar transitorios.;inc(Vref) = V1pcc;inc(xV)   = V1pcc;inc(Vf)   = V1pcc;;! 2. Inicialización de Reactiva (MUY IMPORTANTE);! La referencia (Qref) debe ser igual a la medida actual (Qpcc).;inc(Qref)     = Qpcc;inc(Qref_out) = Qpcc;;! 3. Inicialización de Corrientes internas;inc(i1q_ref) = i1q_hat;;inc(ed) = ed_init_val;;! 5. Flags y auxiliares;inc(NoMoreNoLess) = 1;;!================================================================================================;! Variable definition;!================================================================================================;;"vardef(tau_V) = 's';'Time constant of the low-pass filter for the voltage measurement'";"vardef(kd_V) = 'pu';'Voltage droop gain'";"vardef(ki_Q) = 'pu';'Integral gain of the reactive power PI controller'";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;0;0;1;Qref_out,ed,eq;1;Q_capab_high,Vref,V1pcc,Qref,Qpcc,Q_capab_low,i1q_hat,i1q_ref,FRT1_flag,ed_init_val;1;xQ,xV;1;ki_Q,tau_V,kd_V;1;s2,r,x0,int,diff,DV,FRT1_flag1,NoMoreNoLess,Vf,o1,o2,o6,o7,res,u1,u2,x_init,yi1,yi2,yi3,yi4,yi5,yi6
  36;C;0;1019;1;5;0;;0;;0;;0;;1;yo;0;;0;;0;;0;;2;! Functionality: Outputs a constant zero value.;yo = 0.0;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;0;0;1;yo;0;;0;;0;;0;
  37;C;1;1019;1;5;0;;0;;0;;0;;1;yo;0;;0;;0;;0;;2;! Functionality: Outputs 1.;yo = 1.0;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;0;0;1;yo;0;;0;;0;;0;
  38;C;1/(1+sT) _bypass;1019;1;5;0;;0;;0;;0;;1;yo;1;yi;1;x;1;T;0;;7;! Functionality:  This macro implements a first order lag block with time constant T;! Parameter T must be non-negative. Otherwise, a message is printed to the output window.;! Bypass option: if T<=0, block is bypassed (yo=yi);limfix(T)=[0,);x. = selfix(T>0,(yi-x)/T,0.0);yo = selfix(T>0,x,yi);;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;0;0;1;yo;1;yi;1;x;1;T;0;
  39;C;ABS;1019;1;5;0;;0;;0;;0;;1;yo;1;yi;0;;0;;0;;2;! Functionality: Returns the absolute value of the input.;yo=abs(yi);;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;0;0;1;yo;1;yi;0;;0;;0;
  40;C;Integrator + res + x0;1019;1;7;0;;0;;0;;0;;1;y;1;u,res,x_init;1;x;1;ki;1;x0,int,diff;13;x. = ki*u;;x0   = select(res > 0, x_init, lastvalue(x0));int  = select(res > 0, 0, x);"diff = select(lastvalue(res) > 0, int, lastvalue(diff)) ";;y = x0 + lim_const(int - diff,-100,100);;inc(x)  = y;"inc(x0) = y ";inc(diff) = int;;inc(u) = 0;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;0;0;1;y;1;u,res,x_init;1;x;1;ki;1;x0,int,diff
  41;C;"Limit [sp;sp]";1019;1;5;1;y_max;1;yi_max;1;y_min;1;yi_min;1;yo;1;yi;0;;0;;0;;2;! Functionality: This block implements an asymmetric limiter with signals (upper/lower) and parameters (upper/lower).;yo = lim(yi,max(y_min,yi_min),min(y_max,yi_max));;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;0;0;1;yo;1;yi;0;;0;;0;
  42;C;Multiply K;1019;1;5;0;;0;;0;;0;;1;yo;1;yi;0;;1;K;0;;2;! Functionality: Multiplies the input by K.;yo = K*yi;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;0;0;1;yo;1;yi;0;;1;K;0;
  43;C;NOT;1019;1;5;0;;0;;0;;0;;1;yo;1;yi;0;;0;;0;;12;! Functionality: Implements the logic function NOT.;! yi is assumed to be a boolean input value;! false =(-oo,0.5);! true  =[0.5, oo);"! Truth table ";! -----------------;"! |   yi  |  yo   | ";! |---------------|;! | false | true  |;"! | true  | false |   ";! -----------------;yo = select_const(.not.yi,1,0);;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;0;0;1;yo;1;yi;0;;0;;0;
  44;C;OR2;1019;1;5;0;;0;;0;;0;;1;yo;1;yi1,yi2;0;;0;;0;;15;! Functionality: Implements the logic function OR with two inputs.;! yi1 and yi2 are assumed to be boolean input values;! false =(-oo,0.5);! true  =[0.5, oo);"! Truth table ";! -------------------------;! | yi1   | yi2   | yo    |;! |-----------------------|;! | false | false | false |;! | true  | false | true  |;! | false | true  | true  |;"! | true  | true  | true  |   ";"! ------------------------- ";yo = select_const(yi1.or.yi2,1,0);;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;0;0;1;yo;1;yi1,yi2;0;;0;;0;
  45;C;TDS Neg;1019;1;7;0;;0;;0;;0;;1;y;1;u;0;;1;Vmin,Vmax;1;s,r;19;!==============================================================;! Equations;!==============================================================;;s = select_const(u>=Vmax,1,0);r = select_const(u< Vmin,1,0);;!y = select(s.and.r,0,flipflop(s,r));;y = flipflop(s,r);;;!==============================================================;! Initialization;!==============================================================;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;0;0;1;y;1;u;0;;1;Vmin,Vmax;1;s,r
  46;C;yi1 greater than yi2;1019;1;5;0;;0;;0;;0;;1;yo;1;yi1,yi2;0;;0;;0;;3;! Functionality: Returns 1 if first input is greater than the second. Returns 0 otherwise.;! Function based on select_const().;yo = select_const(yi1>yi2,1,0);;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;0;0;1;yo;1;yi1,yi2;0;;0;;0;
  47;C;Synchronization Loop;1025;0;5;1;y_max;0;;1;y_min;0;;1;w2,cosdelta,sindelta;1;wpcc,P_capab_high,wref,Pref,P_capab_low,Ppcc,e_in_d,e_in_q;1;xw,xP,xt;1;H,KD,tau_P,f1;1;w1,DP,DP1,DP2,DP3,DP4_Lim,Dw1,Dw2,Dw3,Pf,delta,o1;36;!================================================;"! Initialization - Synchronization Loop ";!================================================;;"! 1. Frecuencia Base ";inc(w2) = 2.0 * pi() * f1;;! 2. Referencia de Frecuencia;inc(wref) = 1.0;;inc(Dw3)  = 0.0   ! La desviación de frecuencia debe ser 0;;! 3. Frecuencia de Salida;inc(w) = wref;;! 4. Inicialización de Potencias (Filtros y Referencia);inc(xP)   = Ppcc;inc(Pf)   = Ppcc;inc(Pref) = Ppcc;;! 5. Inicialización de la Inercia (xw);! Desviación de velocidad inicial es 0 (sincronizados).;inc(xw) = 0;;! 6. Inicialización del Ángulo (xt);! Calculamos el ángulo inicial del vector de voltaje.;! Se lo asignamos al estado 'xt', que a su vez alimenta a la macro.;inc(xt) = atan2(e_in_q, e_in_d);;!================================================;! Variable definition;!================================================;"vardef(H)     = 's';'Virtual inertia'";"vardef(KD)    = 'pu';'Damping coefficient'";"vardef(tau_P) = 's';'Time constant of the low-pass filter for reactive power measurement'";"vardef(f1)    = 'Hz';'Fundamental frequency of the system'";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;0;0;1;w2,cosdelta,sindelta;1;wpcc,P_capab_high,wref,Pref,P_capab_low,Ppcc,e_in_d,e_in_q;1;xw,xP,xt;1;H,KD,tau_P,f1;1;w1,DP,DP1,DP2,DP3,DP4_Lim,Dw1,Dw2,Dw3,Pf,delta,o1
  48;C;VSC Measurements;1025;0;7;0;;0;;0;;0;;1;"u1d,u1q,u2d,u2q,i1d,i1q,i2d,i2q,imag_inst ";1;uar,uai,ubr,ubi,ucr,uci,iar,iai,ibr,ibi,icr,ici,cosdelta,sindelta;0;;1;xv,rv;1;u1r,u1i,u2r,u2i,i1r,i1i,i2r,i2i,P,Q,V,delta,Ia,Ib,Ic;87;!================================================================================================;! Equations;!================================================================================================;;! Positive sequence voltages;u1r = (1/3)*(uar - (1/2)*ubr - (1/2)*ucr - sqrt(3)/2*ubi + sqrt(3)/2*uci);u1i = (1/3)*(uai - (1/2)*ubi - (1/2)*uci + sqrt(3)/2*ubr - sqrt(3)/2*ucr);;! Negative sequence voltages;u2r = (1/3)*(uar - (1/2)*ubr - (1/2)*ucr + sqrt(3)/2*ubi - sqrt(3)/2*uci);u2i = (1/3)*(uai - (1/2)*ubi - (1/2)*uci - sqrt(3)/2*ubr + sqrt(3)/2*ucr);;! Positive sequence currents;i1r = (1/3)*(iar - (1/2)*ibr - (1/2)*icr - sqrt(3)/2*ibi + sqrt(3)/2*ici);i1i = (1/3)*(iai - (1/2)*ibi - (1/2)*ici + sqrt(3)/2*ibr - sqrt(3)/2*icr);;! Negative sequence currents;i2r = (1/3)*(iar - (1/2)*ibr - (1/2)*icr + sqrt(3)/2*ibi - sqrt(3)/2*ici);i2i = (1/3)*(iai - (1/2)*ibi - (1/2)*ici - sqrt(3)/2*ibr + sqrt(3)/2*icr);;! Positive sequence voltages in dq;u1d =  u1r*cosdelta + u1i*sindelta;u1q = -u1r*sindelta + u1i*cosdelta;;! Negative sequence voltages in dq;u2d =  u2r*cosdelta - u2i*sindelta;u2q =  u2r*sindelta + u2i*cosdelta;;! Positive sequence currents in dq;i1d =  i1r*cosdelta + i1i*sindelta;i1q = -i1r*sindelta + i1i*cosdelta;;! Negative sequence currents in dq;i2d =  i2r*cosdelta - i2i*sindelta;i2q =  i2r*sindelta + i2i*cosdelta;;! Positive and negative sequence active powers;P1pcc = u1r*i1r + u1i*i1i;P2pcc = u2r*i2r + u2i*i2i;;! Positive and negative sequence reactive powers;Q1pcc = u1i*i1r - u1r*i1i;Q2pcc = u2i*i2r - u2r*i2i;;;P = u1r*i1r + u1i*i1i;Q = u1i*i1r - u1r*i1i;V = sqrt(sqr(u1r) + sqr(u1i));;delta = atan2(u1i,u1r) + atan2(P*xv - Q*rv,P*rv + Q*xv + sqr(V));;Ia = sqrt(sqr(iar) + sqr(iai));Ib = sqrt(sqr(ibr) + sqr(ibi));Ic = sqrt(sqr(icr) + sqr(ici));;imag_inst = max(Ia,Ib,Ic);;!================================================================================================;! Initialization;!================================================================================================;;inc(cosdelta) = cos(delta);inc(sindelta) = sin(delta);;inc(u1d) =  u1r*cosdelta + u1i*sindelta;inc(u1q) = -u1r*sindelta + u1i*cosdelta;;inc(u2d) =  u2r*cosdelta - u2i*sindelta;inc(u2q) =  u2r*sindelta + u2i*cosdelta;;inc(i1d) =  i1r*cosdelta + i1i*sindelta;inc(i1q) = -i1r*sindelta + i1i*cosdelta;;inc(i2d) =  i2r*cosdelta - i2i*sindelta;inc(i2q) =  i2r*sindelta + i2i*cosdelta;;inc(imag_inst) = max(Ia,Ib,Ic);;!================================================================================================;! Variable definition;!================================================================================================;;"vardef(xv) = 'pu';'Reactance of the virtual admittance'";"vardef(rv) = 'pu';'Resistance of the virtual admittance'";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;0;0;1;"u1d,u1q,u2d,u2q,i1d,i1q,i2d,i2q,imag_inst ";1;uar,uai,ubr,ubi,ucr,uci,iar,iai,ibr,ibi,icr,ici,cosdelta,sindelta;0;;1;xv,rv;1;u1r,u1i,u2r,u2i,i1r,i1i,i2r,i2i,P,Q,V,delta,Ia,Ib,Ic
  49;C;Virtual Admittance;1025;0;5;0;;0;;0;;0;;1;i1d_hat,i1q_hat,i2d_hat,i2q_hat, e_int_d, e_int_q;1;e1d,e1q,e2d,e2q,u1d,u1q,u2d,u2q,Ppcc, Qpcc;1;x1d_va,x1q_va,x2d_va,x2q_va;1;xv,rv,f1,va_mode;1;w1;122;!===============================;! Equations;!===============================;;w1 = 2*pi()*f1;;! Positive sequence;;x1d_va. = (e1d - u1d - rv*x1d_va + xv*x1q_va )*w1/xv;;x1q_va. = (e1q - u1q - xv*x1d_va - rv*x1q_va )*w1/xv;;i1d_hat_dyn = x1d_va;;i1q_hat_dyn  = x1q_va;;ud_dif = e1d - u1d;;uq_dif = e1q - u1q;;i1d_hat_nodyn = ((rv*ud_dif) + (uq_dif*xv))/(rv*rv + xv*xv);;i1q_hat_nodyn = ((rv*uq_dif) - (ud_dif*xv))/(rv*rv + xv*xv);;i1d_hat = select(va_mode,i1d_hat_dyn, i1d_hat_nodyn);;i1q_hat = select(va_mode,i1q_hat_dyn, i1q_hat_nodyn);;e_int_d = e1d;;e_int_q = e1q;;! Negative sequence;;x2d_va. = (e2d - u2d - rv*x2d_va - xv*x2q_va )*w1/xv;;x2q_va. = (e2q - u2q + xv*x2d_va - rv*x2q_va )*w1/xv;;i2d_hat_dyn =  x2d_va;;i2q_hat_dyn =  x2q_va;;u2d_dif = e2d - u2d;;u2q_dif = e2q - u2q;;i2d_hat_nodyn = ((rv*u2d_dif) + (u2q_dif*xv))/(rv*rv + xv*xv);;i2q_hat_nodyn = ((rv*u2q_dif) - (u2d_dif*xv))/(rv*rv + xv*xv);;i2d_hat = select(va_mode,i2d_hat_dyn, i2d_hat_nodyn);;i2q_hat = select(va_mode,i2q_hat_dyn, i2q_hat_nodyn);;!=============================================================;"! Initialization - Virtual Admittance ";!=============================================================;;! 1. Frecuencia Base;inc(w1) = 2.0 * pi() * f1;;! 2. CÁLCULO DE CORRIENTES REALES (Usando P y Q del Load Flow);;! Ecuaciones: I = S* / U* =>  Id = (P*ud + Q*uq)/|u|^2, Iq = (P*uq - Q*ud)/|u|^2;;;! Magnitud de voltaje al cuadrado;;u_mag_sq = u1d*u1d + u1q*u1q;;! Cálculo de Id e Iq (Protegido contra división por cero);id_calc = select(u_mag_sq > 0.000001, (Ppcc*u1d + Qpcc*u1q)/u_mag_sq, 0.0);;iq_calc = select(u_mag_sq > 0.000001, (Ppcc*u1q - Qpcc*u1d)/u_mag_sq, 0.0);;! 3. INICIALIZAR ESTADOS (Integradores);;! Arrancamos los integradores con la corriente exacta calculada.;;inc(x1d_va) = id_calc;;inc(x1q_va) = iq_calc;;! 4. CÁLCULO INVERSO DE VOLTAJES (Back-Calculation);;! Calculamos el voltaje interno (e) sumando la caída en la impedancia virtual.;;! E_d = U_d + R*I_d - X*I_q;;! E_q = U_q + R*I_q + X*I_d;;inc(e1d) = u1d + rv*id_calc - xv*iq_calc;;inc(e1q) = u1q + rv*iq_calc + xv*id_calc;;! Pasamos estos valores a las salidas;;inc(e_int_d) = e1d;;inc(e_int_q) = e1q;;! 6. SECUENCIA NEGATIVA;! Asumimos sistema balanceado;;inc(x2d_va) = 0;;inc(x2q_va) = 0;;inc(e2d) = u2d;;inc(e2q) = u2q;;!===============================;;! Variable definition;;!===============================;"vardef(xv) = 'pu';'Reactance of the virtual admittance'";;"vardef(rv) = 'pu';'Resistance of the virtual admittance'";;"vardef(f1) = 'Hz';'Fundamental frequency of the system'";0;0;1;i1d_hat,i1q_hat,i2d_hat,i2q_hat, e_int_d, e_int_q;1;e1d,e1q,e2d,e2q,u1d,u1q,u2d,u2q,Ppcc, Qpcc;1;x1d_va,x1q_va,x2d_va,x2q_va;1;xv,rv,f1,va_mode;1;w1
  50;C;PQ_antiwindup;1026;0;7;0;;0;;0;;0;;1;Paw,Qaw;1;idsat,idnosat,iqsat,iqnosat,VPOS;0;;0;;0;;6;inc(Qaw) = -1*(VPOS*(iqnosat-iqsat));inc(Paw) = VPOS*(idnosat-idsat);;;Qaw = -1*(VPOS*(iqnosat-iqsat));Paw = VPOS*(idnosat-idsat);;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;0;0;1;Paw,Qaw;1;idsat,idnosat,iqsat,iqnosat,VPOS;0;;0;;0;
  51;C;Rotation;1026;0;7;0;;0;;0;;0;;1;d_rot,q_rot;1;d,q,ang;0;;0;;0;;5;inc(d_rot) = d*cos(ang) - q*sin(ang);inc(q_rot) = d*sin(ang) + q*cos(ang);;d_rot = d*cos(ang) - q*sin(ang);q_rot = d*sin(ang) + q*cos(ang);;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;0;0;1;d_rot,q_rot;1;d,q,ang;0;;0;;0;
  52;C;inc;1026;0;7;0;;0;;0;;0;;1;yo;1;yi;0;;0;;0;;3;yo = yi;;inc(yo) = yi;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;0;0;1;yo;1;yi;0;;0;;0;
  53;C;mag_and_angle;1026;0;7;0;;0;;0;;0;;1;mag,ang;1;d,q;0;;0;;0;;12;inc(mag) = sqrt(sqr(q)+sqr(d));inc(ang) = atan2(q,d);;mag = lim(sqrt(sqr(q)+sqr(d)), 1e-6, 9999999999999);;ang = atan2(q,d);;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;0;0;1;mag,ang;1;d,q;0;;0;;0;
  54;C;MV_voltage_limit;1027;0;7;0;;0;;0;;0;;1;ImaxCapacitive, ImaxInductive, reactive_reserve;1;Vpcc, VdcRef, Imax;0;;1;inv_Xtrafo_Lout_pu, MaxAuxiliaryVoltage, MaxTransfoFluxVoltage,inv_Xtrafo_pu, MinAuxiliaryVoltage;0;;19;inc(ImaxCapacitive) = 0;inc(ImaxInductive) = 0;inc(reactive_reserve) = 0;;lim1 = (Vpcc - VdcRef)*inv_Xtrafo_Lout_pu;lim2 =  (Vpcc - min(MaxAuxiliaryVoltage, MaxTransfoFluxVoltage))*inv_Xtrafo_pu;;i_cap = max(lim1,lim2);;i_ind = (Vpcc - MinAuxiliaryVoltage)*inv_Xtrafo_pu;;ImaxCapacitive = max(-Imax, min(i_cap, Imax));ImaxInductive = max(-Imax, min(i_ind, Imax));;"cap_reserve = abs(max(0,ImaxCapacitive)) ";ind_reserve = abs(min(0,ImaxInductive));;reactive_reserve = max(cap_reserve,ind_reserve);;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;0;0;1;ImaxCapacitive, ImaxInductive, reactive_reserve;1;Vpcc, VdcRef, Imax;0;;1;inv_Xtrafo_Lout_pu, MaxAuxiliaryVoltage, MaxTransfoFluxVoltage,inv_Xtrafo_pu, MinAuxiliaryVoltage;0;
  55;C;Pos_Neg_Current_limits_Prioritization;1027;0;7;0;;0;;0;;0;;1;Imaxp, Imaxn;1;Imax,idneg,iqneg,idpos_sat,iqpos_sat,FRT_neg_flag,Qref,inv_Vpcc,reactive_reserve;0;;0;;0;;47;;;inc(Imaxp) = Imax;inc(Imaxn) = Imax;inc(idpos_) = idpos_sat;inc(iqpos_) = iqpos_sat;!Pre allocate room for positive sequence;iposneg_priority = select(FRT_neg_flag,1,0);;!Calculation Iposreserve;aux_Ipos = abs((max(1.2,min(0.82,inv_Vpcc)))*Qref);aux_Iposreserve = max(reactive_reserve,aux_Ipos);iposreserve = max(1,min(0,aux_Iposreserve));;idpos_ = idpos_sat;iqpos_ = iqpos_sat;eps = 0.000001;ipos_mod = sqrt(idpos_*idpos_ + iqpos_*iqpos_);ineg_mod = sqrt(idneg*idneg + iqneg*iqneg);Ipos = max(eps,ipos_mod);Ineg = max(eps,ineg_mod);;! Calculate angles of positive and negative sequence currents without using trigonometric functions;"cosP = idpos_/Ipos;";"sinP = iqpos_/Ipos;";"cosN = idneg/Ineg;";"sinN = iqneg/Ineg;";;! Calculate cos(alpha) = cos(thetaP+thetaN) and sin(alpha) = sin(thetaP+thetaN) using their trigonometric expansions;"cosalpha_ = cosP*cosN - sinP*sinN; ";"sinalpha = sinP*cosN + cosP*sinN;";;"Ires = iposreserve;             ! Reserve of positive sequence current as a function of the pre-fault Qref";;"condition1 = cosalpha_ >= 0.and.sinalpha <= 0.866025.and.sinalpha >= -0.866025 ";condition2 = sinalpha >= 0.and.cosalpha_ <= 0.5;cosalpha = select(condition1=1, cosalpha_,select(condition2=1, -0.5*cosalpha_ + 0.866025*sinalpha,-0.5*cosalpha_ - 0.866025*sinalpha));;Imaxp = select(iposneg_priority=0,Imax,max(Ires,Imax-Ineg));Ipos_c = select(iposneg_priority=0,min(Ipos,Imax),min(Ipos,Imaxp));;Imaxn_ = -Ipos*cosalpha + sqrt(abs(Ipos*Ipos*(cosalpha*cosalpha - 1) + Imax*Imax));"Imaxn = select(FRT_neg_flag, Imaxn_,0.05) ";;"           ";;"           ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;0;0;1;Imaxp, Imaxn;1;Imax,idneg,iqneg,idpos_sat,iqpos_sat,FRT_neg_flag,Qref,inv_Vpcc,reactive_reserve;0;;0;;0;
  56;C;Power_VI_limit;1027;0;7;0;;0;;0;;0;;1;idMVhigh,PMVhigh,idMVlow,PMVlow, iqMVlow, iqMVhigh, VMVhigh, VMVlow, QMVhigh, QMVlow;1;FRT_pos_flag,inv_Vpcc,Id_max,Id_min,Iq_max,Iq_min,vMV_pos_mode,QPCChigh,QPCClow, Vpcc;0;;1;PmvLim_crit,PmvLim_discharge,Pmax_dyn,PmvLim_charge,PlantEff,inv_PlantEff,inv_k_eff_trafo,k_eff_trafo,Xtrafo_pu;0;;33;inc(idMVhigh) = 0;inc(PMVhigh) = 0;inc(idMVlow) = 0;inc(PMVlow) = 0;inc(iqMVlow) = 0;inc(iqMVhigh) = 0;inc(VMVhigh) = 0;inc(VMVlow) = 0;inc(QMVhigh) = 0;inc(QMVlow) = 0;;PPCChigh = PlantEff*select(FRT_pos_flag,PmvLim_crit,min(PmvLim_discharge,Pmax_dyn));PPCClow = inv_PlantEff*select(FRT_pos_flag,-PmvLim_crit,min(PmvLim_charge,-Pmax_dyn));;idMVhigh = min(PPCChigh*inv_Vpcc*inv_k_eff_trafo,Id_max);PMVhigh = idMVhigh*vMV_pos_mode;;idMVlow = max(PPCClow*inv_Vpcc*k_eff_trafo,Id_min);PMVlow = idMVlow*vMV_pos_mode;;iqMVlow = max(-1*inv_Vpcc*QPCChigh,Iq_min);iqMVhigh = min(-1*inv_Vpcc*QPCClow,Iq_max);;VMVhigh = max(Vpcc - (Xtrafo_pu *iqMVlow),0);VMVlow = max(Vpcc - (Xtrafo_pu *iqMVhigh),0);;QMVhigh = -1*iqMVhigh*VMVlow;QMVlow = -1*iqMVlow*VMVhigh;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;0;0;1;idMVhigh,PMVhigh,idMVlow,PMVlow, iqMVlow, iqMVhigh, VMVhigh, VMVlow, QMVhigh, QMVlow;1;FRT_pos_flag,inv_Vpcc,Id_max,Id_min,Iq_max,Iq_min,vMV_pos_mode,QPCChigh,QPCClow, Vpcc;0;;1;PmvLim_crit,PmvLim_discharge,Pmax_dyn,PmvLim_charge,PlantEff,inv_PlantEff,inv_k_eff_trafo,k_eff_trafo,Xtrafo_pu;0;
  57;C;consts_Qlim;1027;0;7;0;;0;;0;;0;;1;Qlim_cap,Qlim_ind;0;;0;;0;;0;;6;inc(Qlim_cap) = 1.5;inc(Qlim_ind) = -1.5;;Qlim_cap = 1.5;Qlim_ind = -1.5;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;0;0;1;Qlim_cap,Qlim_ind;0;;0;;0;;0;
  58;C;limit_Ineg;1027;0;7;0;;0;;0;;0;;1;Idneg_max,Iqneg_max,Idneg_min,Iqneg_min;1;id_neg,iq_neg,Imax,FRT_neg_flag;0;;0;;0;;39;inc(Iqneg_max) = 0;inc(Idneg_max) = 0;inc(Idneg_min) = 0;inc(Iqneg_min) = 0;;I_res_neg = 0;;;! mode = 0;Id_max_neg_0 = Imax;Id_min_neg_0 = -Imax;id_limited_neg_0 = max(Id_min_neg_0, min(id_neg, Id_max_neg_0));Iq_max_neg_0 = max(I_res_neg,sqrt(abs(Imax)^2-abs(id_limited_neg_0)^2));;! mode = 1;Iq_max_neg_1 = Imax;Iq_min_neg_1 = -Imax;iq_limited_neg_1 = max(Iq_min_neg_1, min(iq_neg, Iq_max_neg_1));Id_max_neg_1 = max(I_res_neg,sqrt(abs(Imax)^2-abs(iq_limited_neg_1)^2));;! mode = 2;theta0_neg = atan2(iq_neg,id_neg);id_limited_neg_2 = Imax*cos(theta0_neg);iq_limited_neg_2 = Imax*sin(theta0_neg);Id_max_neg_2 = abs(id_limited_neg_2);Id_min_neg_2 = -Id_max_neg_2;Iq_max_neg_2 = abs(iq_limited_neg_2);;! In case of fault, prioritize reactive current;mode_neg = select(FRT_neg_flag,1,0.5);;Iqneg_max = select(mode_neg =0,Iq_max_neg_0,select(mode_neg =1,Iq_max_neg_1,Iq_max_neg_2));Idneg_max = select(mode_neg =0,Id_max_neg_0,select(mode_neg =1,Id_max_neg_1,Id_max_neg_2));;Idneg_min = -1*Idneg_max;Iqneg_min = -1*Iqneg_max;"!max(limit_inf, min(u, limit_sup));";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;0;0;1;Idneg_max,Iqneg_max,Idneg_min,Iqneg_min;1;id_neg,iq_neg,Imax,FRT_neg_flag;0;;0;;0;
